----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/stdio",
  "moonbitlang/x@0.5.6/sys",
}
----

///|
/// Format all MoonBit code in the workspace.
///
/// Usage: `mise run format`, or `moonx scripts/toolchain.mbtx scripts/format.mbtx`.

///|
async fn main {
  println("🎨 Formatting MoonBit code...")
  let args = ["fmt", "."]
  for file in @fs.readdir("scripts", sort=true) {
    if file.has_suffix(".mbtx") {
      args.push("scripts/\{file}")
    }
  }
  let code = @process.run(
    "moon",
    args,
    stdout=@stdio.stdout,
    stderr=@stdio.stderr,
  )
  if code != 0 {
    @sys.exit(if code > 0 { code } else { 1 })
  }
  println("✅ Formatting complete")
}
