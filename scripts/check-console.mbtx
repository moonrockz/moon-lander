----
import {
  "moonbitlang/async@0.22.7",
  "moonbitlang/async@0.22.7/fs",
  "moonbitlang/async@0.22.7/process",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitlang/x@0.5.6/sys",
}
----

///|
/// Check the console drivers (openspec add-host-lifecycle, task groups 1, 11 and 12).
///
/// The check builds the js test program, then runs the `hosting/console` tests and the signal
/// acceptance suite on native, and fails a leg that runs zero tests. The suite starts the test
/// host as a native child and as a js child under each runtime in `js_runtimes`. The check then
/// copies the framework modules in `libraries` into a temporary workspace with a consumer module
/// outside this workspace, and runs the native part of the acceptance suite there, so the
/// consumer's C compiler builds the stub from the package source. `--no-consumer` skips that part.
///
/// Usage: `mise run check:console [-- --no-consumer]`, or
/// `moonx scripts/toolchain.mbtx scripts/check-console.mbtx`.

///|
/// The native suites of the stub, relative to the workspace root.
let paths : Array[String] = [
  "pkgs/hosting/console", "tests/console-signal-acceptance",
]

///|
/// The files of the acceptance suite that the consumer module reuses.
let suite_files : Array[String] = ["moon.pkg", "send.c", "signal_wbtest.mbt"]

///|
/// The files of the test host scenarios that the consumer module reuses.
let scenario_files : Array[String] = [
  "moon.pkg", "scenarios.mbt", "emit.native.mbt", "emit.js.mbt", "poll.native.mbt",
  "poll.js.mbt",
]

///|
/// The import path of the scenarios in this workspace and in the consumer module.
let scenario_import : (String, String) = (
  "moonrockz/moon-lander-tests/console-host-scenarios", "console-consumer/scenarios",
)

///|
/// The js package that the acceptance suite starts under each runtime.
let js_program : String = "tests/console-host-program"

///|
/// The js runtimes of the acceptance suite.
let js_runtimes : String = "node,bun"

///|
/// The count of the last `Total tests: N, ...` line in the output of `moon test`, or `None` when
/// the output has no such line.
fn test_count(output : String) -> Int32? {
  let mut count = None
  for line in output.split("\n") {
    let line = line.trim(chars=" \t\r")
    guard line.strip_prefix("Total tests: ") is Some(rest) else { continue }
    guard rest.split(",").next() is Some(number) else { continue }
    count = Some(@string.parse_int(number) catch { _ => continue })
  }
  count
}

///|
/// The `version = "X.Y.Z"` value of a `moon.mod`.
fn workspace_version(manifest : String) -> String? {
  for line in manifest.split("\n") {
    if line.strip_prefix("version = \"") is Some(rest) &&
      rest.find("\"") is Some(end) {
      return Some(rest[:end].to_owned())
    }
  }
  None
}

///|
/// The `moon.mod` of the consumer module. It depends on the copied framework module and on the
/// pinned `moonbitlang/async`, as an application does.
fn consumer_manifest(version : String) -> String {
  "name = \"console-consumer\"\nprivate = true\nversion = \"0.0.1\"\nimport {\n  \"moonrockz/moon-lander-core@\{version}\",\n  \"moonrockz/moon-lander-hosting@\{version}\",\n  \"moonbitlang/async@0.22.5\",\n}\n"
}

///|
async fn copy_tree(source : String, destination : String) -> Unit {
  @fs.mkdir(destination, recursive=true, allow_exist=true)
  for entry in @fs.readdir(source) {
    if entry == "_build" || entry == ".mooncakes" || entry == ".git" {
      continue
    }
    let from = source + "/" + entry
    let to = destination + "/" + entry
    match @fs.kind(from) {
      Directory => copy_tree(from, to)
      Regular => @fs.write_file(to, @fs.read_file(from))
      _ => fail("Unexpected source entry: " + from)
    }
  }
}

///|
/// Run `moon test --deny-warn --target native` in `cwd`, print the result, and exit with a
/// failure when the tests fail or run zero tests.
async fn native_tests(
  label : String,
  cwd : String,
  args : Array[String],
  extra_env~ : Map[String, String] = {},
) -> Unit {
  let (code, out, err) = @process.collect_output(
    "moon",
    ["test", "--deny-warn", "--target", "native", ..args],
    cwd~,
    extra_env~,
  )
  let output = out.text() + err.text()
  guard code == 0 else {
    println(output)
    println("❌ The console tests failed: \{label}")
    @sys.exit(if code > 0 { code } else { 1 })
  }
  match test_count(output) {
    Some(count) if count > 0 => println("✅ \{label}: \{count} tests")
    _ => {
      println(output)
      println("❌ \{label} ran zero tests")
      @sys.exit(1)
    }
  }
}

///|
/// The framework modules that the consumer outside the workspace uses by path:
/// the folder in this repository and the folder in the isolated workspace.
let libraries : Array[(String, String)] = [
  ("pkgs/core", "core"),
  ("pkgs/logging", "logging"),
  ("pkgs/config", "config"),
  ("pkgs/logging-hosting-async", "logging-hosting-async"),
  ("pkgs/hosting", "hosting"),
]

///|
/// The `moon.work` of the isolated workspace: the consumer and each library.
fn isolated_work() -> String {
  let members = ["  \".\",\n"]
  for library in libraries {
    members.push("  \"./\{library.1}\",\n")
  }
  "members = [\n" + members.join("") + "]\n"
}

///|
/// Build the js test program and give the path of its artifact.
async fn build_js_program(path : String) -> String {
  let (code, out, err) = @process.collect_output("moon", [
    "run", "--build-only", "--deny-warn", "--target", "js", path,
  ])
  guard code == 0 else {
    println(out.text() + err.text())
    fail("❌ The js test program does not build")
  }
  guard @json.parse(out.text()) is { "artifacts_path": [String(path)], .. } else {
    fail("Expected one js build artifact, got " + out.text())
  }
  path
}

///|
async fn main {
  let root = @fs.realpath(".")
  let program = build_js_program(js_program)
  let worker_program = build_js_program("tests/console-worker-program")
  let worker_dir = @fs.tmpdir(prefix="lander-console-worker")
  defer @fs.rmdir(worker_dir, recursive=true)
  let launcher = worker_dir + "/launcher.cjs"
  let (code, out, err) = @process.collect_output("bun", [
    "build", "tests/console-worker-program/launcher.ts", "--target=node", "--format=cjs",
    "--outfile", launcher,
  ])
  guard code == 0 else { fail(out.text() + err.text()) }
  let js_env = {
    "LANDER_CONSOLE_JS_PROGRAM": program,
    "LANDER_CONSOLE_JS_RUNTIMES": js_runtimes,
    "LANDER_CONSOLE_WORKER_LAUNCHER": launcher,
    "LANDER_CONSOLE_WORKER_PROGRAM": worker_program,
  }
  for path in paths {
    native_tests(
      "\{path} (native and js on \{js_runtimes})",
      root,
      [path],
      extra_env=js_env,
    )
  }
  if @env.args().contains("--no-consumer") {
    return
  }
  guard workspace_version(@fs.read_file("moon.mod").text()) is Some(version) else {
    fail("moon.mod has no version")
  }
  let isolated = @fs.tmpdir(prefix="lander-console-consumer")
  defer @fs.rmdir(isolated, recursive=true)
  for library in libraries {
    copy_tree(library.0, isolated + "/" + library.1)
  }
  @fs.write_file(isolated + "/moon.work", isolated_work())
  @fs.write_file(isolated + "/moon.mod", consumer_manifest(version))
  @fs.mkdir(isolated + "/signals")
  for file in suite_files {
    @fs.write_file(
      isolated + "/signals/" + file,
      @fs.read_file("tests/console-signal-acceptance/" + file)
      .text()
      .replace_all(old=scenario_import.0, new=scenario_import.1),
    )
  }
  @fs.mkdir(isolated + "/scenarios")
  for file in scenario_files {
    @fs.write_file(
      isolated + "/scenarios/" + file,
      @fs.read_file("tests/console-host-scenarios/" + file),
    )
  }
  native_tests("consumer module outside the workspace", isolated, [
    "-p", "console-consumer/signals",
  ])
}

///|
test "test_count reads the last total line and none without one" {
  assert_eq(test_count("Total tests: 3, passed: 3, failed: 0.\r\n"), Some(3))
  assert_eq(test_count("Total tests: 0, passed: 0, failed: 0.\n"), Some(0))
  assert_eq(test_count("Finished. moon: no work to do\n"), None)
}

///|
test "workspace_version reads the root version" {
  assert_eq(
    workspace_version("name = \"x\"\n\nversion = \"0.3.0\"\n"),
    Some("0.3.0"),
  )
  assert_eq(workspace_version("name = \"x\"\n"), None)
}

///|
test "the consumer depends on the framework version and the pinned async" {
  let manifest = consumer_manifest("0.3.0")
  assert_true(manifest.contains("\"moonrockz/moon-lander-hosting@0.3.0\""))
  assert_true(manifest.contains("\"moonbitlang/async@0.22.5\""))
  assert_true(manifest.contains("\"moonrockz/moon-lander-core@0.3.0\""))
}

///|
async test "the consumer copies every source file of the scenarios package" {
  // Tests of task scripts run in the scripts folder.
  let sources = @fs.readdir("../tests/console-host-scenarios").filter(name => {
    name != "pkg.generated.mbti"
  })
  sources.sort()
  let copied = scenario_files.copy()
  copied.sort()
  assert_eq(copied, sources)
}

///|
test "the isolated workspace lists the consumer and each library" {
  assert_eq(
    isolated_work(),
    "members = [\n  \".\",\n  \"./core\",\n  \"./logging\",\n  \"./config\",\n  \"./logging-hosting-async\",\n  \"./hosting\",\n]\n",
  )
}
