import {
  "moonrockz/moon-lander-core" @lander_core,
  "moonrockz/moon-lander-actors" @policy,
  "moonbitlang/async" @aio,
  "moonbitlang/async/cond_var",
  "moonbitlang/core/debug",
  "moonbitlang/core/deque",
  "moonbitlang/core/immut/sorted_map",
  "moonrockz/ion/ion",
}

import {
  "moonrockz/moon-lander-actors/runtime" @actors,
  "moonrockz/moon-lander-core" @lander_core,
  "moonbitlang/async" @aio,
  "moonrockz/ion/ion",
} for "test"

import {
  "moonbitlang/async" @aio,
} for "wbtest"

// No wasm-gc: `moonbitlang/async` has no event loop there. Add wasm-gc when
// `moonbitlang/async` gives one.
supported_targets = "wasm+js+native"
