import {
  "moonbitlang/async",
  "moonbitlang/async/process",
  "moonbitlang/async/socket",
  "moonbitlang/async/stdio",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
}
// Test-only native controller for console creation/targeting unavailable in the
// public spawn flags. Production launchers never import this fixture.
supported_targets = "native"
pkgtype(kind: "executable")
options("native-stub": ["console.c"])
