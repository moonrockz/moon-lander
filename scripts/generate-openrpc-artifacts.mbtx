///|
/// Generate the pinned OpenRPC metaschemas used by the artifact facet. Only a
/// closed draft-07 keyword subset is accepted, so the built-in evaluator
/// interprets every retained keyword.
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/x@0.5.5/crypto",
}

///|
let annotations : Array[String] = [
  "title", "description", "examples", "default", "$comment",
]

///|
let keywords : Array[String] = [
  "$schema", "$id", "definitions", "type", "required", "properties", "patternProperties",
  "additionalProperties", "additionalItems", "items", "oneOf", "enum", "pattern",
  "minLength", "format", "$ref",
]

///|
let patterns : Array[String] = ["^x-", "[0-z]+", "^1\\.4\\.\\d+$"]

///|
let external_references : Array[String] = [
  "https://meta.json-schema.tools", "https://meta.json-schema.tools/#/definitions/JSONSchemaObject/properties/$ref",
]

///|
let sources : Array[(String, String, String)] = [
  (
    "artifact_1_3_2", "open-rpc-meta-schema.json", "OpenRPC 1.3.2 meta-schema release 1.14.9",
  ),
  (
    "artifact_1_4", "openrpc-1.4-schema.json", "OpenRPC 1.4 schema at spec commit 876aa30e341f7669f5ba261e89520a5fc3057038",
  ),
]

///|
fn prune_map(value : Json, at : String) -> Json raise {
  guard value is Object(entries) else { fail("Expected an object at \{at}") }
  let out : Map[String, Json] = Map([])
  for name, item in entries {
    out[name] = prune(item, "\{at}/\{name}")
  }
  Json::object(out)
}

///|
/// Drop annotations at schema positions and reject anything the evaluator
/// does not interpret. Property names are data, never annotations.
fn prune(schema : Json, at : String) -> Json raise {
  guard schema is Object(fields) else {
    match schema {
      True | False => return schema
      _ => fail("Expected a schema at \{at}")
    }
  }
  let out : Map[String, Json] = Map([])
  for name, value in fields {
    if annotations.contains(name) {
      continue
    }
    guard keywords.contains(name) else {
      fail("Unsupported keyword \{name} at \{at}")
    }
    let here = "\{at}/\{name}"
    out[name] = match name {
      "definitions" | "properties" => prune_map(value, here)
      "patternProperties" => {
        guard value is Object(entries) else {
          fail("Expected an object at \{here}")
        }
        for pattern, _ in entries {
          guard patterns.contains(pattern) else {
            fail("Unsupported pattern \{pattern} at \{here}")
          }
        }
        prune_map(value, here)
      }
      "items" | "additionalProperties" | "additionalItems" => prune(value, here)
      "oneOf" => {
        guard value is Array(items) else {
          fail("Expected an array at \{here}")
        }
        let pruned = []
        for i, item in items {
          pruned.push(prune(item, "\{here}/\{i}"))
        }
        Json::array(pruned)
      }
      "pattern" => {
        guard value is String(pattern) && patterns.contains(pattern) else {
          fail("Unsupported pattern at \{here}")
        }
        value
      }
      "$ref" => {
        guard value is String(target) &&
          (
            target.has_prefix("#/definitions/") ||
            external_references.contains(target)
          ) else {
          fail("Unsupported reference at \{here}")
        }
        value
      }
      _ => value
    }
  }
  Json::object(out)
}

///|
fn digest_of(manifest : String, file : String) -> String? {
  for line in manifest.split("\n") {
    if line.length() > 66 && line[66:] == file {
      return Some(line[:64].to_owned())
    }
  }
  None
}

///|
fn render(schemas : Array[(String, String, String, String, String)]) -> String {
  let out = StringBuilder()
  out.write_string(
    "// Generated by scripts/generate-openrpc-artifacts.mbtx. Do not edit.\n// Pinned OpenRPC metaschemas with annotations removed. Apache-2.0, see\n// ../OPENRPC-LICENSE.txt.\n",
  )
  for schema in schemas {
    let (binding, file, title, digest, text) = schema
    out.write_string(
      "\n///|\n/// \{title}: \{file}\n/// SHA-256 \{digest}\nlet \{binding} : String =\n  #|\{text}\n",
    )
  }
  out.to_string()
}

///|
async fn main {
  let directory = "tests/tck/openrpc"
  let manifest = @fs.read_file("\{directory}/SHA256SUMS").text()
  let rendered = []
  for source in sources {
    let (binding, file, title) = source
    let bytes = @fs.read_file("\{directory}/\{file}").binary()
    guard digest_of(manifest, file) is Some(expected) &&
      @crypto.bytes_to_hex_string(@crypto.sha256(bytes)) == expected else {
      fail("Digest mismatch: \{file}")
    }
    let pruned = prune(
      @json.parse(@fs.read_file("\{directory}/\{file}").text()),
      file,
    )
    rendered.push((binding, file, title, expected, pruned.stringify()))
  }
  let output = "pkgs/openrpc/artifact.generated.mbt"
  let text = render(rendered)
  let license = @fs.read_file("\{directory}/LICENSE-openrpc.md").text()
  let license_path = "pkgs/openrpc/OPENRPC-LICENSE.txt"
  if @env.args().contains("--check") {
    guard @fs.exists(output) &&
      @fs.read_file(output).text() == text &&
      @fs.exists(license_path) &&
      @fs.read_file(license_path).text() == license else {
      fail(
        "OpenRPC artifact schemas are stale. Run mise run build:openrpc-artifacts.",
      )
    }
    println("OpenRPC artifact schemas and license are current.")
  } else {
    @fs.write_file(output, text)
    @fs.write_file(license_path, license)
    println("Generated OpenRPC artifact schemas.")
  }
}

///|
test "pruning keeps property names and drops annotations" {
  let schema = @json.parse(
    "{\"title\":\"t\",\"type\":\"object\",\"properties\":{\"summary\":{\"type\":\"string\",\"description\":\"d\"},\"description\":{}}}",
  )
  assert_eq(
    prune(schema, "s").stringify(),
    "{\"type\":\"object\",\"properties\":{\"summary\":{\"type\":\"string\"},\"description\":{}}}",
  )
}

///|
test "pruning rejects keywords, patterns and references it cannot interpret" {
  for
    source in [
      "{\"anyOf\":[]}", "{\"pattern\":\"^a\"}", "{\"patternProperties\":{\"^y-\":{}}}",
      "{\"$ref\":\"https://example.test/s\"}", "{\"properties\":{\"a\":{\"if\":{}}}}",
      "17",
    ] {
    let failed = try prune(@json.parse(source), "s") catch {
      _ => true
    } noraise {
      _ => false
    }
    assert_true(failed, msg=source)
  }
}

///|
async test "artifact freshness rejects missing, changed and altered input" {
  let script = @fs.realpath("generate-openrpc-artifacts.mbtx")
  let temporary = @fs.tmpdir(prefix="openrpc-artifact-check")
  defer @fs.rmdir(temporary, recursive=true)
  @fs.mkdir("\{temporary}/tests/tck/openrpc", recursive=true)
  @fs.mkdir("\{temporary}/pkgs/openrpc", recursive=true)
  for
    file in [
      "SHA256SUMS", "open-rpc-meta-schema.json", "openrpc-1.4-schema.json", "LICENSE-openrpc.md",
    ] {
    @fs.write_file(
      "\{temporary}/tests/tck/openrpc/\{file}",
      @fs.read_file("../tests/tck/openrpc/\{file}"),
    )
  }
  let (missing, _, _) = @process.collect_output(
    "moonx",
    [script, "--check"],
    cwd=temporary,
  )
  assert_true(missing != 0)
  let (built, out, err) = @process.collect_output(
    "moonx",
    [script],
    cwd=temporary,
  )
  assert_eq(built, 0, msg=out.text() + err.text())
  let (fresh, out, err) = @process.collect_output(
    "moonx",
    [script, "--check"],
    cwd=temporary,
  )
  assert_eq(fresh, 0, msg=out.text() + err.text())
  let output = "\{temporary}/pkgs/openrpc/artifact.generated.mbt"
  let original = @fs.read_file(output).text()
  @fs.write_file(output, original + "\n")
  let (changed, _, _) = @process.collect_output(
    "moonx",
    [script, "--check"],
    cwd=temporary,
  )
  assert_true(changed != 0)
  @fs.write_file(output, original)
  @fs.write_file("\{temporary}/tests/tck/openrpc/openrpc-1.4-schema.json", "{}")
  let (tampered, _, _) = @process.collect_output(
    "moonx",
    [script, "--check"],
    cwd=temporary,
  )
  assert_true(tampered != 0)
}
