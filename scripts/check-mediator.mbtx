----
import {
  "moonbitlang/async@0.22.7",
  "moonbitlang/async@0.22.7/process",
  "moonbitlang/async@0.22.7/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
  "moonbitlang/x@0.5.6/sys",
}
----

///|
/// Fail when a target leg of the mediator tests runs zero tests.
///
/// `moon test` exits with 0 when a package has no test entry for a target, and the workspace run
/// skips a package that does not support a target. The mediator spec says that such a leg MUST NOT
/// count as a pass, so this check runs each mediator path for each target and requires a test count
/// above zero.
///
/// Each path has its own target list. The core paths run on wasm, wasm-gc, js and native. The async
/// runtime paths run on wasm, js and native, because `moonbitlang/async` has no wasm-gc
/// test entry. Portable composition acceptance runs on all four targets under the
/// embedded host or a real native/JS async runtime.
///
/// Usage: `mise run check:mediator [-- <target>...]`, or `moonx scripts/toolchain.mbtx scripts/check-mediator.mbtx`.
/// With no target, it checks wasm, wasm-gc, js and native. A path does not run on a target that is
/// not in its list.

///|
let all_targets : Array[String] = ["wasm", "wasm-gc", "js", "native"]

///|
/// The targets of the async mediator paths.
let async_targets : Array[String] = ["wasm", "js", "native"]

///|
/// The mediator packages and their acceptance suites, relative to the workspace root, each with
/// the targets that it supports.
let paths : Array[(String, Array[String])] = [
  ("pkgs/mediator", all_targets),
  ("tests/mediator-acceptance", all_targets),
  ("pkgs/mediator/async", async_targets),
  ("tests/mediator-async-acceptance", async_targets),
  ("tests/mediator-composition-acceptance", all_targets),
]

///|
/// The `(path, target)` legs to run for `targets`, target by target, in path order. A path runs
/// only on the targets in its list.
fn legs(targets : Array[String]) -> Array[(String, String)] {
  let result = []
  for target in targets {
    for entry in paths {
      let (path, supported) = entry
      if supported.contains(target) {
        result.push((path, target))
      }
    }
  }
  result
}

///|
/// The targets in `targets` that are not wasm, wasm-gc, js or native. A misspelled target would
/// give zero legs, and zero legs must not count as a pass.
fn unknown_targets(targets : Array[String]) -> Array[String] {
  targets.filter(target => !all_targets.contains(target))
}

///|
/// The count of the last `Total tests: N, ...` line in the output of `moon test`, or `None` when
/// the output has no such line.
fn test_count(output : String) -> Int32? {
  let mut count = None
  for line in output.split("\n") {
    let line = line.trim(chars=" \t\r")
    guard line.strip_prefix("Total tests: ") is Some(rest) else { continue }
    guard rest.split(",").next() is Some(number) else { continue }
    count = Some(@string.parse_int(number) catch { _ => continue })
  }
  count
}

///|
async fn main {
  let targets = @env.args()[1:].filter(arg => !arg.has_prefix("--"))
  let targets = if targets.is_empty() { all_targets } else { targets }
  let unknown = unknown_targets(targets)
  guard unknown.is_empty() else {
    println(
      "❌ Unknown target: \{unknown.join(", ")}. Use wasm, wasm-gc, js or native.",
    )
    @sys.exit(1)
  }
  for leg in legs(targets) {
    let (path, target) = leg
    let (code, out, err) = @process.collect_output("moon", [
      "test", "--deny-warn", "--target", target, path,
    ])
    let output = out.text() + err.text()
    guard code == 0 else {
      println(output)
      println("❌ The mediator tests failed: \{path} on \{target}")
      @sys.exit(if code > 0 { code } else { 1 })
    }
    match test_count(output) {
      Some(count) if count > 0 =>
        println("✅ \{path} on \{target}: \{count} tests")
      Some(_) | None => {
        println(output)
        println("❌ \{path} on \{target} ran zero tests")
        @sys.exit(1)
      }
    }
  }
}

///|
test "legs give the core paths on four targets and the async paths on three" {
  let all = legs(all_targets)
  assert_true(all.contains(("pkgs/mediator", "wasm-gc")))
  assert_true(all.contains(("tests/mediator-acceptance", "wasm-gc")))
  assert_true(all.contains(("pkgs/mediator/async", "wasm")))
  assert_true(all.contains(("pkgs/mediator/async", "js")))
  assert_true(all.contains(("pkgs/mediator/async", "native")))
  assert_true(all.contains(("tests/mediator-async-acceptance", "native")))
  assert_false(all.contains(("pkgs/mediator/async", "wasm-gc")))
  assert_false(all.contains(("tests/mediator-async-acceptance", "wasm-gc")))
  assert_eq(legs(["wasm-gc"]), [
    ("pkgs/mediator", "wasm-gc"),
    ("tests/mediator-acceptance", "wasm-gc"),
    ("tests/mediator-composition-acceptance", "wasm-gc"),
  ])
}

///|
test "unknown_targets names each target that no path supports" {
  assert_eq(unknown_targets(all_targets), [])
  assert_eq(unknown_targets(["native", "natve", "wasm-gcc"]), [
    "natve", "wasm-gcc",
  ])
}

///|
test "test_count reads the last total line" {
  assert_eq(test_count("Total tests: 4, passed: 4, failed: 0.\n"), Some(4))
  assert_eq(
    test_count(
      "Total tests: 2, passed: 2, failed: 0.\r\nTotal tests: 7, passed: 7, failed: 0.\r\n",
    ),
    Some(7),
  )
}

///|
test "test_count gives zero for a leg without tests and none without a total" {
  assert_eq(
    test_count(
      "Warning: no test entry found.\nTotal tests: 0, passed: 0, failed: 0.\n",
    ),
    Some(0),
  )
  assert_eq(test_count("Finished. moon: no work to do\n"), None)
}

///|
async test "a leg that runs zero tests fails the check" {
  let script = @fs.realpath("check-mediator.mbtx")
  let dir = @fs.tmpdir(prefix="lander-mediator")
  defer @fs.rmdir(dir, recursive=true)
  @fs.write_file(
    "\{dir}/moon.mod",
    "name = \"fixture/root\"\nprivate = true\nversion = \"0.0.1\"\n",
  )
  for
    path in [
      "pkgs", "pkgs/mediator", "pkgs/mediator/async", "tests", "tests/mediator-acceptance",
      "tests/mediator-async-acceptance", "tests/mediator-composition-acceptance",
    ] {
    @fs.mkdir("\{dir}/\{path}")
  }
  @fs.write_file("\{dir}/pkgs/mediator/moon.pkg", "")
  @fs.write_file(
    "\{dir}/pkgs/mediator/core_test.mbt",
    "///|\ntest \"one\" {\n  assert_eq(1, 1)\n}\n",
  )
  @fs.write_file(
    "\{dir}/pkgs/mediator/async/moon.pkg",
    "supported_targets = \"wasm+js+native\"\n",
  )
  @fs.write_file(
    "\{dir}/pkgs/mediator/async/async_test.mbt",
    "///|\ntest \"one\" {\n  assert_eq(1, 1)\n}\n",
  )
  @fs.write_file(
    "\{dir}/tests/mediator-async-acceptance/moon.pkg",
    "supported_targets = \"wasm+js+native\"\n",
  )
  @fs.write_file(
    "\{dir}/tests/mediator-async-acceptance/async_test.mbt",
    "///|\ntest \"one\" {\n  assert_eq(1, 1)\n}\n",
  )
  @fs.write_file("\{dir}/tests/mediator-acceptance/moon.pkg", "")
  @fs.write_file("\{dir}/tests/mediator-composition-acceptance/moon.pkg", "")
  @fs.write_file(
    "\{dir}/tests/mediator-composition-acceptance/core_test.mbt",
    "///|\ntest \"one\" {\n  assert_eq(1, 1)\n}\n",
  )
  @fs.write_file(
    "\{dir}/tests/mediator-acceptance/core.mbt",
    "///|\npub fn answer() -> Int {\n  42\n}\n",
  )
  let (code, out, err) = @process.collect_output(
    "moonx",
    [script, "wasm"],
    cwd=dir,
  )
  let output = out.text() + err.text()
  assert_true(code != 0, msg=output)
  assert_true(
    output.contains("tests/mediator-acceptance on wasm ran zero tests"),
    msg=output,
  )
  @fs.write_file(
    "\{dir}/tests/mediator-acceptance/core_test.mbt",
    "///|\ntest \"one\" {\n  assert_eq(1, 1)\n}\n",
  )
  let (code, out, err) = @process.collect_output(
    "moonx",
    [script, "wasm"],
    cwd=dir,
  )
  let output = out.text() + err.text()
  assert_eq(code, 0, msg=output)
  assert_true(
    output.contains("pkgs/mediator/async on wasm: 1 tests"),
    msg=output,
  )
  let (code, out, err) = @process.collect_output(
    "moonx",
    [script, "wasm-gc"],
    cwd=dir,
  )
  let output = out.text() + err.text()
  assert_eq(code, 0, msg=output)
  assert_false(output.contains("mediator/async"), msg=output)
}

///|
/// Copy just the source and manifests needed by the isolated API consumer.
async fn copy_api_package(source : String, destination : String) -> Unit {
  @fs.mkdir(destination, recursive=true, allow_exist=true)
  for entry in @fs.readdir(source) {
    if entry == "moon.mod" ||
      entry == "moon.pkg" ||
      (entry.has_suffix(".mbt") && !entry.has_suffix("test.mbt")) {
      @fs.write_file(
        "\{destination}/\{entry}",
        @fs.read_file("\{source}/\{entry}"),
      )
    }
  }
}

///|
async test "external callers cannot bypass mediator error invariants" {
  let root = @fs.realpath("..")
  let dir = @fs.tmpdir(prefix="lander-mediator-api")
  defer @fs.rmdir(dir, recursive=true)
  copy_api_package("\{root}/pkgs/core", "\{dir}/core")
  copy_api_package("\{root}/pkgs/mediator", "\{dir}/mediator")
  copy_api_package("\{root}/pkgs/mediator/async", "\{dir}/mediator/async")
  @fs.write_file(
    "\{dir}/moon.work",
    "members = [\".\", \"core\", \"mediator\"]\n",
  )
  let manifest = @fs.read_file("\{root}/pkgs/mediator/moon.mod").text()
  let version_line = manifest
    .split("\n")
    .map(line => line.trim().to_owned())
    .filter(line => line.has_prefix("version = "))
    .to_array()[0]
  let version = version_line[11:version_line.length() - 1].to_owned()
  @fs.write_file(
    "\{dir}/moon.mod",
    manifest
    .replace(
      old="name = \"moonrockz/moon-lander-mediator\"",
      new="name = \"fixture/mediator-api\"",
    )
    .replace(
      old="import {",
      new="import {\n  \"moonrockz/moon-lander-mediator@\{version}\",",
    ),
  )
  @fs.write_file(
    "\{dir}/moon.pkg",
    "import {\n  \"moonrockz/moon-lander-core\" @core,\n  \"moonrockz/moon-lander-mediator\" @mediator,\n  \"moonrockz/moon-lander-mediator/async\" @mediator_async,\n}\nsupported_targets = \"wasm+js+native\"\n",
  )
  // The same import must plan on every target without a target restriction.
  let portable_pkg = "import {\n  \"moonrockz/moon-lander-core\" @core,\n  \"moonrockz/moon-lander-mediator\" @mediator,\n  \"moonrockz/moon-lander-mediator/async\" @mediator_async,\n}\n"
  @fs.write_file("\{dir}/moon.pkg", portable_pkg)
  let portable =
    #|pub fn probe() -> @mediator_async.Sender[Unit, Int, Int] {
    #|  @mediator_async.sender((_, request) => request + 1)
    #|  .use_(@mediator_async.before((_, _) => ()))
    #|  .use_(@mediator_async.after((_, _, _) => ()))
    #|  .use_(@mediator_async.finally_((_, _) => ()))
    #|}
  @fs.write_file("\{dir}/probe.mbt", portable)
  for target in all_targets {
    let (code, out, err) = @process.collect_output(
      "moon",
      ["check", "--target", target, "."],
      cwd=dir,
    )
    assert_eq(code, 0, msg=out.text() + err.text())
  }
  for
    (source, name) in [
      (
        "pub fn probe() -> Unit raise { let _ : @mediator_async.Middleware[Unit, Int, Int] = @mediator_async.timeout(@core.TimeLimit::millis(1)) }",
        "timeout",
      ),
      (
        "pub fn probe() -> Unit { let _ = @mediator_async.topic((_:Unit, _:Int) => ()) }",
        "topic",
      ),
    ] {
    @fs.write_file("\{dir}/probe.mbt", source)
    let (code, out, err) = @process.collect_output(
      "moon",
      ["check", "--target", "wasm-gc", "."],
      cwd=dir,
    )
    let output = out.text() + err.text()
    assert_true(code != 0 && output.contains(name), msg=output)
  }
  let valid =
    #|pub fn probe() -> Unit raise {
    #|  let limit = @core.TimeLimit::millis(1)
    #|  let _ = @mediator.MediatorError::timed_out(limit)
    #|  let _ : @mediator_async.Middleware[Unit, Unit, Unit] = @mediator_async.timeout(limit)
    #|  let _ = @mediator.MediatorError::from_publish_errors([Some(@mediator.MediatorError::rejected("closed"))])
    #|}
  @fs.write_file("\{dir}/probe.mbt", valid)
  let (code, out, err) = @process.collect_output(
    "moon",
    ["check", "--target", "wasm", "."],
    cwd=dir,
  )
  assert_eq(code, 0, msg=out.text() + err.text())
  for
    (source, diagnostic) in [
      (
        "pub fn probe() -> Unit { let _ = @mediator.PublishFailed(handlers=0, failures=abort(\"unused\")) }",
        "4036",
      ),
      (
        "pub fn probe() -> Unit { let _ = @mediator.Rejected(reason=\"closed\") }",
        "4036",
      ),
      (
        "pub fn probe() -> Unit raise { let _ = @mediator.TimedOut(after=@core.TimeLimit::millis(1)) }",
        "4036",
      ),
      (
        "pub fn probe() -> Unit { let _ : @mediator.PublishFailure = { position: 0, error: @mediator.MediatorError::rejected(\"closed\") } }",
        "read-only",
      ),
      (
        "pub fn probe() -> Unit { let _ : @mediator_async.Middleware[Unit, Unit, Unit] = @mediator_async.timeout(-1) }",
        "4014",
      ),
    ] {
    @fs.write_file("\{dir}/probe.mbt", source)
    let (code, out, err) = @process.collect_output(
      "moon",
      ["check", "--target", "wasm", "."],
      cwd=dir,
    )
    let output = out.text() + err.text()
    assert_true(code != 0, msg="Invalid API use compiled: " + source)
    assert_true(output.contains(diagnostic), msg=output)
  }
}
