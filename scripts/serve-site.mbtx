----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/http",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/async@0.22.5/socket",
  "moonbitlang/async@0.22.5/stdio",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitlang/x@0.5.6/sys",
}
----

///|
/// Serve the built docs site in `_site/` below its base path, as GitHub Pages does, and build it again
/// after a source file changes.
///
/// Usage: `mise run dev:site`, or `moonx scripts/toolchain.mbtx scripts/serve-site.mbtx [--port <n>] [--no-watch]`.
/// The base path is the `base_path` of `site/site.json`. The default port is 4173.
/// The rules: a path outside the base path redirects to the base path, a path that leaves the site
/// directory gives 403, a directory serves its `index.html`, and a missing file gives 404.
/// The watch polls the modification time of the site sources every 500 ms, because
/// `moonbitlang/async` has no file watch API, and runs `moonx scripts/site.mbtx build` after a change.
/// Run it from the workspace root.

///|
let usage : String = "Usage: moonx scripts/toolchain.mbtx scripts/serve-site.mbtx [--port <n>] [--no-watch]"

///|
/// The built site, relative to the workspace root.
let site_dir : String = "_site"

///|
/// The source directories that the watch always polls, relative to the workspace root.
let watched : Array[String] = ["docs", "site", "apps/site"]

///|
/// Directory names that the watch skips: build output and installed packages.
let skipped : Array[String] = ["_build", "node_modules", ".mooncakes"]

///|
/// What the server does with one request path.
enum Route {
  /// Redirect to this location.
  Redirect(String)
  /// Answer 403: the path leaves the site directory or cannot be decoded.
  Forbidden
  /// Serve this path below the site directory. An empty path or a path that ends with `/` names a
  /// directory.
  Serve(String)
} derive(Eq, Debug)

///|
fn hex_value(c : Int32) -> Int32? {
  if c >= '0' && c <= '9' {
    Some(c - '0')
  } else if c >= 'a' && c <= 'f' {
    Some(c - 'a' + 10)
  } else if c >= 'A' && c <= 'F' {
    Some(c - 'A' + 10)
  } else {
    None
  }
}

///|
/// Decode the `%XX` escapes of a URL path as UTF-8. Returns `None` for a bad escape or bad UTF-8.
fn percent_decode(path : String) -> String? {
  let utf8 = @utf8.encode(path)
  let out = Array(capacity=utf8.length())
  let mut i = 0
  while i < utf8.length() {
    let b = utf8[i]
    if b == b'%' {
      guard i + 2 < utf8.length() &&
        hex_value(utf8[i + 1].to_int()) is Some(hi) &&
        hex_value(utf8[i + 2].to_int()) is Some(lo) else {
        return None
      }
      out.push((hi * 16 + lo).to_byte())
      i += 3
    } else {
      out.push(b)
      i += 1
    }
  }
  try @utf8.decode(Bytes::from_array(out)) catch {
    _ => None
  } noraise {
    text => Some(text)
  }
}

///|
/// The route of the request path `target` for a site below `base`. The query and the fragment are
/// ignored. A path that has a `..` or `.` segment, a backslash or a NUL after decoding leaves the
/// directory.
fn route(base : String, target : String) -> Route {
  let path = match target.find("?") {
    Some(i) => target[:i].to_owned()
    None => target
  }
  let path = match path.find("#") {
    Some(i) => path[:i].to_owned()
    None => path
  }
  guard percent_decode(path) is Some(path) else { return Forbidden }
  guard path.has_prefix(base) else { return Redirect(base) }
  let rel = path[base.length():].to_owned()
  if rel.contains("\\") || rel.contains("\u{0}") {
    return Forbidden
  }
  for segment in rel.split("/") {
    if segment == ".." || segment == "." {
      return Forbidden
    }
  }
  if rel.has_prefix("/") {
    return Forbidden
  }
  Serve(rel)
}

///|
/// The content type of a file name.
fn content_type(name : String) -> String {
  let types = [
    (".html", "text/html; charset=utf-8"),
    (".css", "text/css; charset=utf-8"),
    (".js", "text/javascript; charset=utf-8"),
    (".json", "application/json"),
    (".xml", "application/atom+xml"),
    (".svg", "image/svg+xml"),
    (".png", "image/png"),
  ]
  for entry in types {
    if name.has_suffix(entry.0) {
      return entry.1
    }
  }
  "application/octet-stream"
}

///|
/// The options of the script.
struct Options {
  port : Int32
  watch : Bool
} derive(Eq, Debug)

///|
fn parse_options(args : Array[String]) -> Options raise Failure {
  let mut port = 4173
  let mut watch = true
  let mut i = 0
  while i < args.length() {
    match args[i] {
      "--no-watch" => watch = false
      "--port" if i + 1 < args.length() => {
        port = @string.parse_int(args[i + 1]) catch {
          _ => raise Failure("bad port `\{args[i + 1]}`. \{usage}")
        }
        i += 1
      }
      arg => raise Failure("unknown option `\{arg}`. \{usage}")
    }
    i += 1
  }
  { port, watch, }
}

///|
/// The `base_path` of `site/site.json`.
fn base_path(text : String) -> String raise Failure {
  let json = @json.parse(text) catch {
    error => raise Failure("site/site.json: not valid JSON: \{error}")
  }
  guard json is Object(fields) && fields.get("base_path") is Some(String(base)) else {
    raise Failure("site/site.json: missing string field `base_path`")
  }
  base
}

///|
/// The directories that the watch polls: `watched`, the directory `pkgs/<name>` of each package in
/// `packages`, and each module directory in `api` of `site/site.json`, in that order without repeats.
fn watched_dirs(text : String) -> Array[String] raise Failure {
  let json = @json.parse(text) catch {
    error => raise Failure("site/site.json: not valid JSON: \{error}")
  }
  let dirs = watched.copy()
  guard json is Object(fields) else { return dirs }
  let add = fn(dir : String) { if !dirs.contains(dir) { dirs.push(dir) } }
  if fields.get("packages") is Some(Array(items)) {
    for item in items {
      if item is String(name) {
        add("pkgs/\{name}")
      }
    }
  }
  if fields.get("api") is Some(Array(items)) {
    for item in items {
      if item is String(dir) {
        add(dir)
      }
    }
  }
  dirs
}

///|
fn header(
  name : String,
  value : String,
) -> Map[@http.CaseInsensitiveString, String] {
  Map::from_array([(@http.CaseInsensitiveString(name), value)])
}

///|
/// Answer one request.
async fn answer(
  base : String,
  request : @http.Request,
  conn : @http.ServerConnection,
) -> Unit {
  match route(base, request.path) {
    Redirect(location) =>
      conn.send_response(
        302,
        "Found",
        extra_headers=header("Location", location),
      )
    Forbidden => conn..send_response(403, "Forbidden").write("Forbidden")
    Serve(rel) => {
      let mut file = "\{site_dir}/\{rel}"
      if rel == "" ||
        rel.has_suffix("/") ||
        (@fs.exists(file) && @fs.kind(file) is Directory) {
        file = if file.has_suffix("/") {
          "\{file}index.html"
        } else {
          "\{file}/index.html"
        }
      }
      if !@fs.exists(file) || !(@fs.kind(file) is Regular) {
        conn..send_response(404, "Not Found").write("Not found")
        return
      }
      let data = @fs.read_file(file).binary()
      conn
      ..send_response(
        200,
        "OK",
        extra_headers=header("Content-Type", content_type(file)),
      )
      .write(data)
    }
  }
}

///|
/// The newest modification time and the count of the files below `dir`, without the skipped
/// directories. A missing directory gives `(0, 0)`.
async fn snapshot(dir : String) -> (Int64, Int32) {
  guard @fs.exists(dir) else { return (0, 0) }
  let mut newest : Int64 = 0
  let mut count = 0
  for name in @fs.readdir(dir) {
    let path = "\{dir}/\{name}"
    match @fs.kind(path) {
      Directory =>
        if !skipped.contains(name) {
          let (time, files) = snapshot(path)
          if time > newest {
            newest = time
          }
          count += files
        }
      Regular => {
        let (seconds, nanoseconds) = @fs.mtime(path)
        let time = seconds * 1_000_000_000L + nanoseconds.to_int64()
        if time > newest {
          newest = time
        }
        count += 1
      }
      _ => ()
    }
  }
  (newest, count)
}

///|
async fn sources_snapshot() -> Array[(Int64, Int32)] {
  let out = []
  // Read the configuration on each poll, so a package added to `packages` is watched at once.
  let dirs = watched_dirs(@fs.read_file("site/site.json").text()) catch {
    _ => watched
  }
  for dir in dirs {
    if @fs.exists(dir) {
      out.push(snapshot(dir))
    }
  }
  out
}

///|
async fn build() -> Unit {
  let code = @process.run(
    "moonx",
    ["scripts/site.mbtx", "build"],
    stdout=@stdio.stdout,
    stderr=@stdio.stderr,
  ) catch {
    error => {
      eprintln("❌ site build did not run: \{error}")
      return
    }
  }
  if code != 0 {
    eprintln("❌ site build failed; the server keeps the last build")
  }
}

///|
/// Poll the sources every 500 ms and build the site again after a change.
async fn watch_sources() -> Unit {
  let mut last = sources_snapshot()
  while true {
    @async.sleep(500)
    let now = sources_snapshot() catch { _ => continue }
    if now != last {
      last = now
      println("🔁 sources changed; building the site")
      build()
      last = sources_snapshot() catch { _ => last }
    }
  }
}

///|
async fn main {
  let options = parse_options(@env.args()[1:].to_owned()) catch {
    Failure(message) => {
      eprintln("❌ \{message}")
      @sys.exit(2)
      return
    }
  }
  let base = base_path(@fs.read_file("site/site.json").text()) catch {
    Failure(message) => {
      eprintln("❌ \{message}")
      @sys.exit(1)
      return
    }
    error => {
      eprintln("❌ site/site.json: \{error}")
      @sys.exit(1)
      return
    }
  }
  let server = @http.Server(
    @socket.Addr::parse("127.0.0.1:\{options.port}"),
    reuse_addr=true,
  )
  println("🌐 Site: http://127.0.0.1:\{options.port}\{base}")
  @async.with_task_group() <| group => {
    if options.watch {
      group.spawn_bg(watch_sources)
    }
    server.run_forever(allow_failure=true, (request, _body, conn) => {
      answer(base, request, conn)
    })
  }
}

///|
test "directory request" {
  assert_eq(route("/moon-lander/", "/moon-lander/docs/"), Serve("docs/"))
  assert_eq(route("/moon-lander/", "/moon-lander/"), Serve(""))
  assert_eq(
    route("/moon-lander/", "/moon-lander/assets/site.css?v=1"),
    Serve("assets/site.css"),
  )
}

///|
test "path outside the base" {
  assert_eq(route("/moon-lander/", "/other/"), Redirect("/moon-lander/"))
  assert_eq(route("/moon-lander/", "/"), Redirect("/moon-lander/"))
  assert_eq(route("/moon-lander/", "/moon-lander"), Redirect("/moon-lander/"))
}

///|
test "path escape" {
  assert_eq(route("/moon-lander/", "/moon-lander/../secret"), Forbidden)
  assert_eq(route("/moon-lander/", "/moon-lander/%2e%2e/secret"), Forbidden)
  assert_eq(
    route("/moon-lander/", "/moon-lander/docs/%2E%2E/%2e%2e/x"),
    Forbidden,
  )
  assert_eq(route("/moon-lander/", "/moon-lander/..%5csecret"), Forbidden)
  assert_eq(route("/moon-lander/", "/moon-lander//etc/passwd"), Forbidden)
  assert_eq(route("/moon-lander/", "/moon-lander/%zz"), Forbidden)
}

///|
test "escapes decode as UTF-8" {
  assert_eq(percent_decode("/a%20b/%C3%A9"), Some("/a b/é"))
  assert_eq(percent_decode("/%FF"), None)
}

///|
test "content types" {
  assert_eq(content_type("index.html"), "text/html; charset=utf-8")
  assert_eq(content_type("atom.xml"), "application/atom+xml")
  assert_eq(content_type("a.bin"), "application/octet-stream")
}

///|
test "options" {
  assert_eq(parse_options([]), { port: 4173, watch: true, })
  assert_eq(parse_options(["--port", "4174", "--no-watch"]), {
    port: 4174,
    watch: false,
  })
  let message = try parse_options(["--watch"]) catch {
    Failure(message) => message
  } noraise {
    _ => ""
  }
  assert_eq(message, "unknown option `--watch`. \{usage}")
}

///|
test "the watch follows the packages and API modules of site/site.json" {
  assert_eq(
    watched_dirs(
      "{\"packages\": [\"notebooks\", \"lander\"], \"api\": [\"pkgs/lander\", \"pkgs/notebooks\"]}",
    ),
    ["docs", "site", "apps/site", "pkgs/notebooks", "pkgs/lander"],
  )
  assert_eq(watched_dirs("{}"), ["docs", "site", "apps/site"])
}

///|
test "the base path comes from site/site.json" {
  assert_eq(base_path("{\"base_path\": \"/moon-lander/\"}"), "/moon-lander/")
}
