import {
  "moonrockz/moon-lander-moonx" @moonx,
  "moonrockz/moon-lander-moonx/driver",
  "moonbitlang/core/env",
  "moonbitlang/x/sys",
}

import { "moonbitlang/core/json" } for "wbtest"
// Owner-approved public tracer/launcher placement inside the optional module.
// It uses the stock Wasm/native process ABI through the public driver only.
supported_targets = "wasm+native"
pkgtype(kind: "executable")
