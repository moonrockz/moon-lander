----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/async@0.22.5/fs",
}
----

///|
/// Compare the complete pure-load observation across compiler targets.

///|
async fn main {
  let expected = @fs.read_file("tests/config-fixture/expected.txt")
    .text()
    .replace_all(old="\r\n", new="\n")
  for target in ["wasm", "wasm-gc", "js", "native"] {
    let (code, out, err) = @process.collect_output("moon", [
      "test", "--deny-warn", "--target", target, "pkgs/config", "pkgs/config/parsers/toml",
      "pkgs/config/parsers/yaml", "pkgs/config/parsers/json5", "pkgs/config/parsers/ion",
      "tests/config-acceptance",
    ])
    guard code == 0 else { fail(out.text() + err.text()) }
    let (code, out, err) = @process.collect_output("moon", [
      "run", "--release", "--deny-warn", "--target", target, "tests/config-parity",
    ])
    guard code == 0 else { fail(out.text() + err.text()) }
    let observation = out.text().replace_all(old="\r\n", new="\n")
    guard !observation.is_empty() else {
      fail("Empty configuration observation")
    }
    guard observation == expected else {
      fail("Values, provenance or reports differ on \{target}:\n\{observation}")
    }
    println("Core acceptance and complete observation agree: \{target}")
  }
}
