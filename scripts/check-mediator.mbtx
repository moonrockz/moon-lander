///|
/// Fail when a target leg of the mediator tests runs zero tests.
///
/// `moon test` exits with 0 when a package has no test entry for a target, and the workspace run
/// skips a package that does not support a target. The mediator spec says that such a leg MUST NOT
/// count as a pass, so this check runs each mediator path for each target and requires a test count
/// above zero.
///
/// Each path has its own target list. The core paths run on wasm, wasm-gc, js and native. The async
/// paths run on wasm, js and native, because `moonbitlang/async` has no wasm-gc test entry.
///
/// Usage: `mise run check:mediator [-- <target>...]`, or `moonx scripts/check-mediator.mbtx`.
/// With no target, it checks wasm, wasm-gc, js and native. A path does not run on a target that is
/// not in its list.
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
  "moonbitlang/x@0.5.5/sys",
}

///|
let all_targets : Array[String] = ["wasm", "wasm-gc", "js", "native"]

///|
/// The targets of the async mediator paths.
let async_targets : Array[String] = ["wasm", "js", "native"]

///|
/// The mediator packages and their acceptance suites, relative to the workspace root, each with
/// the targets that it supports.
let paths : Array[(String, Array[String])] = [
  ("pkgs/lander/mediator", all_targets),
  ("tests/mediator-acceptance", all_targets),
  ("pkgs/lander/mediator/async", async_targets),
  ("tests/mediator-async-acceptance", async_targets),
]

///|
/// The `(path, target)` legs to run for `targets`, target by target, in path order. A path runs
/// only on the targets in its list.
fn legs(targets : Array[String]) -> Array[(String, String)] {
  let result = []
  for target in targets {
    for entry in paths {
      let (path, supported) = entry
      if supported.contains(target) {
        result.push((path, target))
      }
    }
  }
  result
}

///|
/// The count of the last `Total tests: N, ...` line in the output of `moon test`, or `None` when
/// the output has no such line.
fn test_count(output : String) -> Int32? {
  let mut count = None
  for line in output.split("\n") {
    let line = line.trim(chars=" \t\r")
    guard line.strip_prefix("Total tests: ") is Some(rest) else { continue }
    guard rest.split(",").next() is Some(number) else { continue }
    count = Some(@string.parse_int(number) catch { _ => continue })
  }
  count
}

///|
async fn main {
  let targets = @env.args()[1:].filter(arg => !arg.has_prefix("--"))
  let targets = if targets.is_empty() { all_targets } else { targets }
  for leg in legs(targets) {
    let (path, target) = leg
    let (code, out, err) = @process.collect_output("moon", [
      "test", "--deny-warn", "--target", target, path,
    ])
    let output = out.text() + err.text()
    guard code == 0 else {
      println(output)
      println("❌ The mediator tests failed: \{path} on \{target}")
      @sys.exit(if code > 0 { code } else { 1 })
    }
    match test_count(output) {
      Some(count) if count > 0 =>
        println("✅ \{path} on \{target}: \{count} tests")
      Some(_) | None => {
        println(output)
        println("❌ \{path} on \{target} ran zero tests")
        @sys.exit(1)
      }
    }
  }
}

///|
test "legs give the core paths on four targets and the async paths on three" {
  let all = legs(all_targets)
  assert_true(all.contains(("pkgs/lander/mediator", "wasm-gc")))
  assert_true(all.contains(("tests/mediator-acceptance", "wasm-gc")))
  assert_true(all.contains(("pkgs/lander/mediator/async", "wasm")))
  assert_true(all.contains(("pkgs/lander/mediator/async", "js")))
  assert_true(all.contains(("pkgs/lander/mediator/async", "native")))
  assert_true(all.contains(("tests/mediator-async-acceptance", "native")))
  assert_false(all.contains(("pkgs/lander/mediator/async", "wasm-gc")))
  assert_false(all.contains(("tests/mediator-async-acceptance", "wasm-gc")))
  assert_eq(legs(["wasm-gc"]), [
    ("pkgs/lander/mediator", "wasm-gc"),
    ("tests/mediator-acceptance", "wasm-gc"),
  ])
}

///|
test "test_count reads the last total line" {
  assert_eq(test_count("Total tests: 4, passed: 4, failed: 0.\n"), Some(4))
  assert_eq(
    test_count(
      "Total tests: 2, passed: 2, failed: 0.\r\nTotal tests: 7, passed: 7, failed: 0.\r\n",
    ),
    Some(7),
  )
}

///|
test "test_count gives zero for a leg without tests and none without a total" {
  assert_eq(
    test_count(
      "Warning: no test entry found.\nTotal tests: 0, passed: 0, failed: 0.\n",
    ),
    Some(0),
  )
  assert_eq(test_count("Finished. moon: no work to do\n"), None)
}

///|
async test "a leg that runs zero tests fails the check" {
  let script = @fs.realpath("check-mediator.mbtx")
  let dir = @fs.tmpdir(prefix="lander-mediator")
  defer @fs.rmdir(dir, recursive=true)
  @fs.write_file(
    "\{dir}/moon.mod",
    "name = \"fixture/root\"\nversion = \"0.0.1\"\n",
  )
  for
    path in [
      "pkgs", "pkgs/lander", "pkgs/lander/mediator", "pkgs/lander/mediator/async",
      "tests", "tests/mediator-acceptance", "tests/mediator-async-acceptance",
    ] {
    @fs.mkdir("\{dir}/\{path}")
  }
  @fs.write_file("\{dir}/pkgs/lander/mediator/moon.pkg", "")
  @fs.write_file(
    "\{dir}/pkgs/lander/mediator/core_test.mbt",
    "///|\ntest \"one\" {\n  assert_eq(1, 1)\n}\n",
  )
  @fs.write_file(
    "\{dir}/pkgs/lander/mediator/async/moon.pkg",
    "supported_targets = \"wasm+js+native\"\n",
  )
  @fs.write_file(
    "\{dir}/pkgs/lander/mediator/async/async_test.mbt",
    "///|\ntest \"one\" {\n  assert_eq(1, 1)\n}\n",
  )
  @fs.write_file(
    "\{dir}/tests/mediator-async-acceptance/moon.pkg",
    "supported_targets = \"wasm+js+native\"\n",
  )
  @fs.write_file(
    "\{dir}/tests/mediator-async-acceptance/async_test.mbt",
    "///|\ntest \"one\" {\n  assert_eq(1, 1)\n}\n",
  )
  @fs.write_file("\{dir}/tests/mediator-acceptance/moon.pkg", "")
  @fs.write_file(
    "\{dir}/tests/mediator-acceptance/core.mbt",
    "///|\npub fn answer() -> Int {\n  42\n}\n",
  )
  let (code, out, err) = @process.collect_output(
    "moonx",
    [script, "wasm"],
    cwd=dir,
  )
  let output = out.text() + err.text()
  assert_true(code != 0, msg=output)
  assert_true(
    output.contains("tests/mediator-acceptance on wasm ran zero tests"),
    msg=output,
  )
  @fs.write_file(
    "\{dir}/tests/mediator-acceptance/core_test.mbt",
    "///|\ntest \"one\" {\n  assert_eq(1, 1)\n}\n",
  )
  let (code, out, err) = @process.collect_output(
    "moonx",
    [script, "wasm"],
    cwd=dir,
  )
  let output = out.text() + err.text()
  assert_eq(code, 0, msg=output)
  assert_true(
    output.contains("pkgs/lander/mediator/async on wasm: 1 tests"),
    msg=output,
  )
  let (code, out, err) = @process.collect_output(
    "moonx",
    [script, "wasm-gc"],
    cwd=dir,
  )
  let output = out.text() + err.text()
  assert_eq(code, 0, msg=output)
  assert_false(output.contains("mediator/async"), msg=output)
}
