----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/async@0.22.5/stdio",
  "moonbitlang/x@0.5.5/sys",
}
----

///|
/// Run the full local gate: lint, validate, test, test:scripts, build.
///
/// Usage: `mise run check`, or `moonx scripts/toolchain.mbtx scripts/check.mbtx`.

///|
async fn main {
  println("🔍 Running all checks...")
  for
    task in [
      "check:node-adapter", "check:browser-adapter", "check:browser-fixture", "lint",
      "validate", "test", "check:mediator", "check:logging", "check:logging-sinks",
      "check:embedded", "check:config", "check:formats", "check:formats-registry",
      "check:openrpc-assets", "check:openrpc-artifacts", "check:openrpc-unicode",
      "check:openrpc", "qualify:openrpc", "check:openrpc-registry", "test:scripts",
      "build", "test:browser",
    ] {
    println("")
    println("=== \{task} ===")
    let code = @process.run(
      "mise",
      ["run", task],
      stdout=@stdio.stdout,
      stderr=@stdio.stderr,
    )
    if code != 0 {
      println("❌ \{task} failed")
      @sys.exit(if code > 0 { code } else { 1 })
    }
  }
  println("")
  println("✅ All checks passed!")
}
