----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/core/env",
  "moonbitlang/x@0.5.6/sys",
}
----

///|
/// Bundle the Node adapter into an inline MoonBit JavaScript FFI factory.
/// Usage: mise run build:node-adapter, or mise run check:node-adapter.

///|
async fn bundle(
  entry : String,
  generated : String,
  factory : String,
  type_name : String,
) -> Bool {
  let dir = @fs.tmpdir(prefix="lander-node-bundle")
  defer @fs.rmdir(dir, recursive=true)
  let output = "\{dir}/adapter.cjs"
  let (code, out, err) = @process.collect_output("bun", [
    "build", entry, "--target=node", "--format=cjs", "--outfile", output,
  ])
  if code != 0 {
    eprintln(out.text() + err.text())
    @sys.exit(1)
  }
  let bundle = @fs.read_file(output).text().replace_all(old="\r\n", new="\n")
  let source = StringBuilder()
  source.write_string(
    "// Generated by scripts/build-node-adapter.mbtx. Do not edit.\n\n///|\nextern \"js\" fn \{factory}() -> \{type_name} =\n",
  )
  // getBuiltinModule works in CommonJS and ESM on the pinned Node and Bun.
  // The bundle has no third-party dependencies; only node:* imports are allowed.
  for
    line in [
      "() => {", "  const module = { exports: {} };", "  const exports = module.exports;",
      "  const require = name => {", "    if (!name.startsWith('node:')) throw new Error('Expected a node:* import');",
      "    return process.getBuiltinModule(name);", "  };",
    ] {
    source.write_string("  #|\{line}\n")
  }
  for line in bundle.trim_end().split("\n") {
    if line.trim_end().is_empty() {
      source.write_string("  #|\n")
    } else {
      source.write_string("  #|  \{line.trim_end()}\n")
    }
  }
  source.write_string("  #|  return module.exports;\n  #|}\n")
  let source = source.to_string()
  if @env.args().contains("--check") {
    if !@fs.exists(generated) || @fs.read_file(generated).text() != source {
      eprintln(
        "The Node adapter \{generated} is stale. Run mise run build:node-adapter.",
      )
      return false
    }
    println("The generated Node adapter is current.")
  } else {
    @fs.write_file(generated, source)
    println("Wrote \{generated}")
  }
  true
}

///|
async fn main {
  let library = bundle(
    "pkgs/config/adapters/node/index.ts", "pkgs/config/host/node.generated.js.mbt",
    "node_adapter", "NodeAdapter",
  )
  let fixture = bundle(
    "pkgs/config/adapters/node/fixture.ts", "pkgs/config/host/node_fixture.generated.js_wbtest.mbt",
    "node_fixture", "NodeFixture",
  )
  let hosting = bundle(
    "pkgs/hosting/adapters/node/index.ts", "pkgs/hosting/node.generated.js.mbt",
    "node_adapter", "NodeAdapter",
  )
  let hosting_fixture = bundle(
    "pkgs/hosting/adapters/node/fixture.ts", "pkgs/hosting/node_fixture.generated.js_wbtest.mbt",
    "node_fixture", "NodeFixture",
  )
  let console = bundle(
    "pkgs/hosting/adapters/node/signals.ts", "pkgs/hosting/console/node.generated.js.mbt",
    "node_adapter", "NodeAdapter",
  )
  let logging = bundle(
    "pkgs/logging-hosting-async/adapters/node/index.ts", "pkgs/logging-hosting-async/runtime/node.generated.js.mbt",
    "node_adapter", "NodeAdapter",
  )
  if !library ||
    !fixture ||
    !hosting ||
    !hosting_fixture ||
    !console ||
    !logging {
    @sys.exit(1)
  }
}

///|
async test "freshness check rejects changed TypeScript without rewriting the bundle" {
  let script = @fs.realpath("build-node-adapter.mbtx")
  let dir = @fs.tmpdir(prefix="lander-node-current")
  defer @fs.rmdir(dir, recursive=true)
  @fs.mkdir("\{dir}/pkgs/config/adapters/node", recursive=true)
  @fs.mkdir("\{dir}/pkgs/config/host", recursive=true)
  @fs.mkdir("\{dir}/pkgs/hosting/adapters/node", recursive=true)
  let entry = "\{dir}/pkgs/config/adapters/node/index.ts"
  @fs.write_file(entry, "export const value: number = 1;\n")
  @fs.write_file(
    "\{dir}/pkgs/config/adapters/node/fixture.ts",
    "export const fixture = 1;\n",
  )
  let hosting_entry = "\{dir}/pkgs/hosting/adapters/node/index.ts"
  @fs.write_file(hosting_entry, "export const value = 1;\n")
  @fs.write_file(
    "\{dir}/pkgs/hosting/adapters/node/fixture.ts",
    "export const fixture = 1;\n",
  )
  @fs.mkdir("\{dir}/pkgs/hosting/console", recursive=true)
  let console_entry = "\{dir}/pkgs/hosting/adapters/node/signals.ts"
  @fs.write_file(console_entry, "export const value = 1;\n")
  @fs.mkdir("\{dir}/pkgs/logging-hosting-async/adapters/node", recursive=true)
  @fs.mkdir("\{dir}/pkgs/logging-hosting-async/runtime", recursive=true)
  let logging_entry = "\{dir}/pkgs/logging-hosting-async/adapters/node/index.ts"
  @fs.write_file(logging_entry, "export const value = 1;\n")
  let (missing, _, _) = @process.collect_output(
    "moonx",
    [script, "--check"],
    cwd=dir,
  )
  assert_true(missing != 0)
  let (built, out, err) = @process.collect_output("moonx", [script], cwd=dir)
  assert_eq(built, 0, msg=out.text() + err.text())
  let (current, out, err) = @process.collect_output(
    "moonx",
    [script, "--check"],
    cwd=dir,
  )
  assert_eq(current, 0, msg=out.text() + err.text())
  let generated = "\{dir}/pkgs/config/host/node.generated.js.mbt"
  let before = @fs.read_file(generated).text()
  @fs.write_file(entry, "export const value: number = 2;\n")
  let (stale, out, err) = @process.collect_output(
    "moonx",
    [script, "--check"],
    cwd=dir,
  )
  assert_true(stale != 0, msg=out.text() + err.text())
  assert_true(err.text().contains("stale"), msg=err.text())
  assert_true(
    err.text().contains("pkgs/config/host/node.generated.js.mbt"),
    msg=err.text(),
  )
  assert_eq(@fs.read_file(generated).text(), before)
  @fs.write_file(entry, "export const value: number = 1;\n")
  let hosting_generated = "\{dir}/pkgs/hosting/node.generated.js.mbt"
  let before = @fs.read_file(hosting_generated).text()
  @fs.write_file(hosting_entry, "export const value = 2;\n")
  let (stale, out, err) = @process.collect_output(
    "moonx",
    [script, "--check"],
    cwd=dir,
  )
  assert_true(stale != 0, msg=out.text() + err.text())
  assert_true(err.text().contains("stale"), msg=err.text())
  assert_true(
    err.text().contains("pkgs/hosting/node.generated.js.mbt"),
    msg=err.text(),
  )
  assert_eq(@fs.read_file(hosting_generated).text(), before)
  @fs.write_file(hosting_entry, "export const value = 1;\n")
  let console_generated = "\{dir}/pkgs/hosting/console/node.generated.js.mbt"
  let before = @fs.read_file(console_generated).text()
  @fs.write_file(console_entry, "export const value = 2;\n")
  let (stale, out, err) = @process.collect_output(
    "moonx",
    [script, "--check"],
    cwd=dir,
  )
  assert_true(stale != 0, msg=out.text() + err.text())
  assert_true(
    err.text().contains("pkgs/hosting/console/node.generated.js.mbt"),
    msg=err.text(),
  )
  assert_eq(@fs.read_file(console_generated).text(), before)
  @fs.write_file(console_entry, "export const value = 1;\n")
  let logging_generated = "\{dir}/pkgs/logging-hosting-async/runtime/node.generated.js.mbt"
  let before = @fs.read_file(logging_generated).text()
  @fs.write_file(logging_entry, "export const value = 2;\n")
  let (stale, out, err) = @process.collect_output(
    "moonx",
    [script, "--check"],
    cwd=dir,
  )
  assert_true(stale != 0, msg=out.text() + err.text())
  assert_true(
    err
    .text()
    .contains("pkgs/logging-hosting-async/runtime/node.generated.js.mbt"),
    msg=err.text(),
  )
  assert_eq(@fs.read_file(logging_generated).text(), before)
}
