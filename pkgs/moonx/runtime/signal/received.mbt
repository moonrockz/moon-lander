// Added by Moon-Lander; generated by scripts/moonx-runtime.mbtx.

///|
/// The first OS cancellation signal observed by this isolated runtime.
/// This value is available before a process cancellation handler runs.
#cfg(any(target="wasm", target="native"))
pub fn received_cancellation_signal() -> Signal? {
  signal_for_code(@event_loop.first_received_signal())
}

///|
/// The signal currently selected by the unchanged upstream runtime exit policy.
/// A later signal can change this while the first forwarding identity stays fixed.
pub fn exit_cancellation_signal() -> Signal? {
  signal_for_code(@event_loop.exit_cancellation_signal())
}

///|
fn signal_for_code(code : Int32?) -> Signal? {
  guard code is Some(code) else { return None }
  for signal in [SIGINT, SIGTERM, SIGHUP, SIGBREAK] {
    if signal.to_int() == code {
      return Some(signal)
    }
  }
  None
}
