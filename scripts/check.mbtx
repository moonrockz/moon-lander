----
import {
  "moonbitlang/async@0.22.7",
  "moonbitlang/async@0.22.7/process",
  "moonbitlang/async@0.22.7/stdio",
  "moonbitlang/x@0.5.6/sys",
}
----

///|
/// Run the full local gate: lint, validate, test, test:scripts, build.
///
/// Usage: `mise run check`, or `moonx scripts/toolchain.mbtx scripts/check.mbtx`.

///|
async fn main {
  println("🔍 Running all checks...")
  for
    task in [
      "check:node-adapter", "check:browser-adapter", "check:browser-fixture", "check:moonx-runtime",
      "check:moonx-drift", "lint", "validate", "test", "check:mediator", "check:actors",
      "check:logging", "check:sigstore", "check:logging-sinks", "check:embedded",
      "check:moonx", "check:moonx-stock16", "check:moonx-retained", "check:config",
      "check:formats", "check:formats-registry", "check:openrpc-assets", "check:openrpc-artifacts",
      "check:openrpc-unicode", "check:sigstore-assets", "check:openrpc", "qualify:openrpc",
      "check:openrpc-registry", "check:framework-registry", "test:scripts", "build",
      "test:browser",
    ] {
    println("")
    println("=== \{task} ===")
    let code = @process.run(
      "mise",
      ["run", task],
      stdout=@stdio.stdout,
      stderr=@stdio.stderr,
    )
    if code != 0 {
      println("❌ \{task} failed")
      @sys.exit(if code > 0 { code } else { 1 })
    }
  }
  println("")
  println("✅ All checks passed!")
}
