----
import {
  "moonbitlang/async@0.22.7",
  "moonbitlang/async@0.22.7/fs",
  "moonbitlang/async@0.22.7/process",
  "moonbitlang/async@0.22.7/stdio",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/x@0.5.6/sys",
}
----

///|
/// Cross-build the native programs for Linux arm64 from one Linux or macOS machine with
/// `moonrockz/zig-cross` and the full MoonBit runtime of the primary pin.
///
/// The plan first runs `zig-cross doctor --json` for its target. A report with status `error`
/// stops the plan before it builds; the findings and their next steps go to the output, and the
/// report goes to `_build/cross/doctor-full.json`. Then the plan runs `zig-cross build`, which
/// checks the header of each executable. The programs are in `programs`. CI already builds and
/// runs x64 Linux with gcc and with zig, so this plan does not build `linux-x64`.
///
/// The Darwin and Windows plan with the experimental synchronous runtime
/// (`ZIG_CROSS_RUNTIME=sync`) is removed: zig-cross accepts that runtime only with stock MoonBit
/// 0.10.17, and the framework code uses the `#derive(...)` syntax of 0.10.20, which 0.10.17 does
/// not apply. It comes back when zig-cross assesses the sync runtime on the primary pin.
///
/// This is a compile, link and header check. It does not run the programs, and it does not
/// replace the native test legs on macOS and Windows. Build programs for macOS and Windows on the
/// target OS with its native compiler.
///
/// Usage: `mise run build:cross [-- <plan or target>...]`, or
/// `moonx scripts/toolchain.mbtx scripts/cross-build.mbtx`. The plan name `full` and the target
/// name `linux-arm64` select the one target. With no argument, the plan builds it.

///|
/// The zig-cross release. Change it here, in `.config/mise/config.toml` and in `README.md`; a
/// test of this script fails when they differ.
let zig_cross : String = "moonrockz/zig-cross@0.4.1"

///|
/// The executables of the plan: the console host program, which links hosting, the console signal
/// stub and `moonbitlang/async`, and programs without `moonbitlang/async`. The docs site tools are
/// not framework code, and they took most of the build time, so the plan does not build them.
let programs : Array[String] = [
  "tests/console-host-program", "tests/browser-parity-reference", "tests/config-parity",
  "tests/formats-custom", "tests/formats-default", "tests/formats-leaky", "tests/formats-toml",
  "tests/openrpc-consumer",
]

///|
/// A zig-cross target, without `host`.
#derive(Eq, Debug)
enum Target {
  LinuxArm64
}

///|
fn Target::name(self : Target) -> String {
  match self {
    LinuxArm64 => "linux-arm64"
  }
}

///|
suberror PlanError {
  UnknownPlan(String)
}

///|
/// Read a plan or target name from the command line: `full` or `linux-arm64`.
fn Target::parse(text : String) -> Target raise PlanError {
  match text {
    "full" | "linux-arm64" => LinuxArm64
    _ =>
      raise UnknownPlan(
        "Unknown plan or target '\{text}'. Use full or linux-arm64. The sync plan for Darwin and Windows is removed until zig-cross assesses it on MoonBit 0.10.20.",
      )
  }
}

///|
/// The targets that the command line selects, without repeats. No argument selects every target.
fn select(args : Array[String]) -> Array[Target] raise PlanError {
  let selected : Array[Target] = []
  for arg in args {
    let target = Target::parse(arg)
    if !selected.contains(target) {
      selected.push(target)
    }
  }
  if args.is_empty() {
    [LinuxArm64]
  } else {
    selected
  }
}

///|
/// The overall status of a doctor report, in precedence order.
#derive(Eq, Debug)
enum DoctorStatus {
  Blocked // "error"
  Warning
  Unknown
  Healthy // "ok"
}

///|
/// The parts of a `zig-cross doctor --json` report (schema version 1) that a plan uses.
#derive(Debug)
struct DoctorReport {
  status : DoctorStatus
  findings : Array[Finding]
}

///|
#derive(Debug)
struct Finding {
  code : String
  /// Printed only. zig-cross can add severities in schema version 1; 0.3.0 also gives
  /// `unverified`.
  severity : String
  targets : Array[String]
  message : String
  next_steps : Array[String]
}

///|
suberror DoctorError {
  InvalidReport(String)
}

///|
fn strings(values : Array[Json]) -> Array[String] {
  values.filter_map(value => {
    if value is String(text) {
      Some(text)
    } else {
      None
    }
  })
}

///|
/// Read a doctor report. Fail when it is not JSON, has a schema version other than 1, has no known
/// status, or did not assess the full runtime (`environment.runtime_mode`).
fn DoctorReport::parse(text : String) -> DoctorReport raise DoctorError {
  let json = @json.parse(text) catch {
    error => raise InvalidReport("The doctor output is not JSON: \{error}")
  }
  guard json is { "schema_version": Number(version, ..), .. } && version == 1 else {
    raise InvalidReport("The doctor report does not have schema_version 1")
  }
  let status = match json {
    { "status": "error", .. } => Blocked
    { "status": "warning", .. } => Warning
    { "status": "unknown", .. } => Unknown
    { "status": "ok", .. } => Healthy
    _ => raise InvalidReport("The doctor report has no known status")
  }
  guard json is { "environment": { "runtime_mode": "full", .. }, .. } else {
    raise InvalidReport("The doctor report did not assess the full runtime")
  }
  let findings = match json {
    { "findings": Array(items), .. } =>
      items.filter_map(item => {
        guard item is { "code": String(code), "severity": String(severity), .. } else {
          return None
        }
        let targets = if item is { "targets": Array(names), .. } {
          strings(names)
        } else {
          []
        }
        let message = if item is { "message": String(text), .. } {
          text
        } else {
          ""
        }
        let next_steps = if item is { "next_steps": Array(steps), .. } {
          steps.filter_map(step => {
            if step is { "command": String(command), .. } {
              Some(command)
            } else {
              None
            }
          })
        } else {
          []
        }
        Some({ code, severity, targets, message, next_steps, })
      })
    _ => []
  }
  { status, findings, }
}

///|
/// The finding and its next steps: `[CODE] severity (targets): message`, then one
/// `  Next: step` line for each step.
fn Finding::describe(self : Finding) -> String {
  let lines = [
    "[\{self.code}] \{self.severity} (\{self.targets.join(", ")}): \{self.message}",
  ]
  for step in self.next_steps {
    lines.push("  Next: \{step}")
  }
  lines.join("\n")
}

///|
/// The finding codes of a report, sorted and without repeats.
fn DoctorReport::codes(self : DoctorReport) -> Array[String] {
  let codes : Array[String] = []
  for finding in self.findings {
    if !codes.contains(finding.code) {
      codes.push(finding.code)
    }
  }
  codes.sort()
  codes
}

///|
/// The zig-cross references in `text` that give a version, as `moonrockz/zig-cross@<version>`. A
/// placeholder such as `moonrockz/zig-cross@<version>` is not a reference.
fn zig_cross_pins(text : String) -> Array[String] {
  let prefix = "moonrockz/zig-cross@"
  let pins = []
  for part in text.split(prefix).drop(1) {
    let version = part.to_owned()
    // A version starts with a digit and holds digits, letters, `.`, `-` and `+` (semver).
    guard version.length() > 0 && version[0] >= '0' && version[0] <= '9' else {
      continue
    }
    let mut end = 0
    while end < version.length() {
      let c = version[end]
      guard (c >= '0' && c <= '9') ||
        (c >= 'a' && c <= 'z') ||
        (c >= 'A' && c <= 'Z') ||
        c == '.' ||
        c == '-' ||
        c == '+' else {
        break
      }
      end += 1
    }
    pins.push(prefix + version[:end].trim_end(chars=".").to_owned())
  }
  pins
}

///|
/// Run doctor for the targets, write the report, and stop when its status is `error`.
async fn doctor(
  targets : Array[Target],
  environment : Map[String, String],
) -> Unit {
  let targets = targets.map(target => target.name())
  let (code, out, err) = @process.collect_output(
    "moonx",
    [zig_cross, "doctor"] + targets + ["--json"],
    extra_env=environment,
  )
  let text = out.text()
  @fs.mkdir("_build/cross", recursive=true, allow_exist=true)
  @fs.write_file("_build/cross/doctor-full.json", text)
  let report = DoctorReport::parse(text) catch {
    InvalidReport(message) => {
      eprintln(err.text())
      eprintln("❌ \{message} (exit code \{code})")
      @sys.exit(1)
      panic()
    }
  }
  println(
    "🩺 zig-cross doctor, full runtime, \{targets.join(" ")}: \{report.codes().join(" ")}",
  )
  guard report.status != Blocked else {
    eprintln(err.text())
    for finding in report.findings {
      eprintln(finding.describe())
    }
    eprintln(
      "❌ zig-cross doctor reports a blocker for the full plan. Read _build/cross/doctor-full.json before you change the plan.",
    )
    @sys.exit(1)
  }
}

///|
async fn main {
  let targets = select(@env.args()[1:].to_owned()) catch {
    UnknownPlan(message) => {
      eprintln("❌ \{message}")
      @sys.exit(2)
      panic()
    }
  }
  let environment = { "ZIG_CROSS_RUNTIME": "full" }
  doctor(targets, environment)
  let names = targets.map(target => target.name())
  let code = @process.run(
    "moonx",
    [zig_cross, "build"] + names + ["--"] + programs,
    extra_env=environment,
    stdout=@stdio.stdout,
    stderr=@stdio.stderr,
  )
  guard code == 0 else {
    eprintln(
      "❌ The full cross-build failed. Run mise run doctor:zig-cross -- \{names.join(" ")}.",
    )
    @sys.exit(if code > 0 { code } else { 1 })
  }
  println("✅ Cross-built \{names.join(" ")}")
}

///|
let full_report : String =
  #|{"schema_version":1,"environment":{"host_os":"Linux","runtime_mode":"full"},
  #|"targets":["linux-x64","linux-arm64"],"status":"warning","findings":[
  #|{"code":"ZC_LINUX_NAME_MAX","severity":"warning","targets":["linux-x64"],"message":"m",
  #|"applicability":"a","evidence":[],"next_steps":[{"kind":"command",
  #|"command":"zig-cross build linux-x64 -- <package-path>","prerequisites":""}]},
  #|{"code":"ZC_LINUX_NAME_MAX","severity":"warning","targets":["linux-arm64"],"message":"m",
  #|"applicability":"a","evidence":[],"next_steps":[]}]}

///|
test "a doctor report gives its status, runtime and findings" {
  let report = DoctorReport::parse(full_report)
  assert_eq(report.status, Warning)
  assert_eq(report.codes(), ["ZC_LINUX_NAME_MAX"])
  assert_eq(report.findings[0].targets, ["linux-x64"])
  assert_eq(report.findings[0].next_steps, [
    "zig-cross build linux-x64 -- <package-path>",
  ])
  assert_eq(
    report.findings[0].describe(),
    "[ZC_LINUX_NAME_MAX] warning (linux-x64): m\n  Next: zig-cross build linux-x64 -- <package-path>",
  )
  assert_eq(
    report.findings[1].describe(),
    "[ZC_LINUX_NAME_MAX] warning (linux-arm64): m",
  )
}

///|

///|
/// A minimal doctor report with a status and a runtime mode.
fn report_json(status : String, mode : String) -> String {
  "{\"schema_version\":1,\"environment\":{\"runtime_mode\":\"\{mode}\"},\"status\":\"\{status}\",\"findings\":[]}"
}

///|
test "only a report on the full runtime is read" {
  assert_eq(DoctorReport::parse(report_json("ok", "full")).status, Healthy)
  for
    text in [
      "{\"schema_version\":1,\"status\":\"ok\",\"findings\":[]}",
      report_json("ok", "sync"),
      report_json("ok", "Full"),
      report_json("ok", ""),
    ] {
    let failed = Ok(DoctorReport::parse(text)) catch { error => Err(error) }
    assert_true(failed is Err(InvalidReport(_)), msg=text)
  }
}

///|
test "each doctor status is read, and an unknown status fails" {
  for
    (text, status) in [
      ("error", Blocked),
      ("warning", Warning),
      ("unknown", Unknown),
      ("ok", Healthy),
    ] {
    let report = DoctorReport::parse(report_json(text, "full"))
    assert_eq(report.status, status)
  }
  let failed = Ok(DoctorReport::parse(report_json("fine", "full"))) catch {
    error => Err(error)
  }
  assert_true(failed is Err(InvalidReport(_)))
}

///|
test "a report without schema version 1, or that is not JSON, fails" {
  for
    text in [
      "{\"schema_version\":2,\"status\":\"ok\",\"findings\":[]}", "{\"status\":\"ok\"}",
      "zig-cross doctor: error",
    ] {
    let failed = Ok(DoctorReport::parse(text)) catch { error => Err(error) }
    assert_true(failed is Err(InvalidReport(_)), msg=text)
  }
}

///|
test "the command line selects the full plan, and other plans and targets fail" {
  let names = (targets : Array[Target]) => targets.map(target => target.name())
  assert_eq(names(select([])), ["linux-arm64"])
  assert_eq(names(select(["full"])), ["linux-arm64"])
  assert_eq(names(select(["linux-arm64", "full"])), ["linux-arm64"])
  for
    text in [
      "sync", "darwin-x64", "darwin-arm64", "windows-x64", "linux-x64", "host", "",
    ] {
    let failed = Ok(select([text])) catch { error => Err(error) }
    assert_true(failed is Err(UnknownPlan(_)), msg=text)
  }
}

///|
test "zig_cross_pins reads each reference" {
  assert_eq(
    zig_cross_pins(
      "a moonrockz/zig-cross@0.3.0 exec\n`moonrockz/zig-cross@0.10.12`. moonrockz/zig-cross@1.2.3.",
    ),
    [
      "moonrockz/zig-cross@0.3.0", "moonrockz/zig-cross@0.10.12", "moonrockz/zig-cross@1.2.3",
    ],
  )
  assert_eq(zig_cross_pins("no reference"), [])
  assert_eq(zig_cross_pins("moonx moonrockz/zig-cross@<version> doctor"), [])
  assert_eq(
    zig_cross_pins(
      "moonrockz/zig-cross@0.4.0-rc.1 and \"moonrockz/zig-cross@1.0.0+build.5\"",
    ),
    ["moonrockz/zig-cross@0.4.0-rc.1", "moonrockz/zig-cross@1.0.0+build.5"],
  )
}

///|
async test "the mise tasks and the README use the zig-cross pin of this script" {
  for file in ["../.config/mise/config.toml", "../README.md"] {
    let pins = zig_cross_pins(@fs.read_file(file).text())
    assert_true(pins.length() > 0, msg=file)
    for pin in pins {
      assert_eq(pin, zig_cross, msg=file)
    }
  }
}

///|
async test "the programs are executables" {
  for path in programs {
    let manifest = @fs.read_file("../\{path}/moon.pkg").text()
    assert_true(
      manifest.contains("\"is-main\": true") ||
      manifest.contains("pkgtype(kind: \"executable\")"),
      msg=path,
    )
  }
}
