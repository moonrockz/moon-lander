///|
/// Check MoonBit formatting and run the type checker across the workspace.
///
/// The type checker runs for all targets. Without `--target all`, moon checks each module for its
/// preferred target only, so it skips a package whose `supported_targets` excludes that target, such as
/// a js-only package in a module that prefers native.
///
/// The check also writes the `pkg.generated.mbti` interface of each package. The workspace checks
/// these files in, so lint fails when the check leaves an interface that is untracked or that differs
/// from the staged version. Stage or commit the written files and run lint again.
///
/// Usage: `mise run lint:moonbit`, or `moonx scripts/lint-moonbit.mbtx`.
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/stdio",
  "moonbitlang/x@0.5.5/sys",
}

///|
async fn moon(args : Array[String]) -> Int32 {
  @process.run("moon", args, stdout=@stdio.stdout, stderr=@stdio.stderr)
}

///|
/// The interface files that are untracked or differ from the index, in path order.
async fn changed_interfaces() -> Array[String] {
  let paths = []
  for
    args in [
      ["diff", "--name-only", "--", "*pkg.generated.mbti"],
      [
        "ls-files", "--others", "--exclude-standard", "--", "*pkg.generated.mbti",
      ],
    ] {
    let (code, out, err) = @process.collect_output("git", args)
    guard code == 0 else {
      println(err.text())
      println("❌ git could not list the generated interfaces.")
      @sys.exit(if code > 0 { code } else { 1 })
    }
    for line in out.text().split("\n") {
      let path = line.trim(chars=" \t\r")
      if !path.is_empty() {
        paths.push(path.to_owned())
      }
    }
  }
  paths.sort()
  paths
}

///|
async fn main {
  println("🔍 Checking MoonBit formatting...")
  let args = ["fmt", "--check", "."]
  for file in @fs.readdir("scripts", sort=true) {
    if file.has_suffix(".mbtx") {
      args.push("scripts/\{file}")
    }
  }
  let fmt = moon(args)
  if fmt != 0 {
    println("❌ Formatting issues found. Run 'mise run format' to fix.")
    @sys.exit(if fmt > 0 { fmt } else { 1 })
  }
  println("🔍 Checking MoonBit code...")
  let check = moon(["check", "--deny-warn", "--target", "all"])
  if check != 0 {
    println("❌ moon check reported problems.")
    @sys.exit(if check > 0 { check } else { 1 })
  }
  println("🔍 Checking generated interfaces...")
  let stale = changed_interfaces()
  if !stale.is_empty() {
    for path in stale {
      println("  \{path}")
    }
    println(
      "❌ These pkg.generated.mbti files are new or changed. Review, stage and commit them.",
    )
    @sys.exit(1)
  }
  println("✅ MoonBit lint complete")
}

///|
async test "moon check covers a package outside the preferred target" {
  let script = @fs.realpath("lint-moonbit.mbtx")
  let dir = @fs.tmpdir(prefix="lander-lint")
  defer @fs.rmdir(dir, recursive=true)
  @fs.mkdir("\{dir}/scripts")
  @fs.mkdir("\{dir}/js_only")
  @fs.write_file(
    "\{dir}/moon.mod",
    "name = \"fixture/root\"\nversion = \"0.0.1\"\npreferred_target = \"native\"\n",
  )
  @fs.write_file("\{dir}/js_only/moon.pkg", "supported_targets = \"js\"\n")
  @fs.write_file(
    "\{dir}/js_only/unused.mbt",
    "///|\nfn unused() -> Unit {\n  ()\n}\n",
  )
  let (code, out, err) = @process.collect_output("moonx", [script], cwd=dir)
  let output = out.text() + err.text()
  assert_true(code != 0, msg=output)
  assert_true(output.contains("Unused function 'unused'"), msg=output)
}

///|
async test "lint fails when a checked-in interface file is missing or stale" {
  let script = @fs.realpath("lint-moonbit.mbtx")
  let dir = @fs.tmpdir(prefix="lander-lint")
  defer @fs.rmdir(dir, recursive=true)
  async fn git(args : Array[String]) -> Unit {
    let (code, out, err) = @process.collect_output(
      "git",
      ["-c", "user.name=lint", "-c", "user.email=lint@example.test", ..args],
      cwd=dir,
    )
    assert_eq(code, 0, msg=out.text() + err.text())
  }

  async fn lint() -> (Int32, String) {
    let (code, out, err) = @process.collect_output("moonx", [script], cwd=dir)
    (code, out.text() + err.text())
  }

  @fs.mkdir("\{dir}/scripts")
  @fs.mkdir("\{dir}/lib")
  @fs.write_file(
    "\{dir}/moon.mod",
    "name = \"fixture/root\"\nversion = \"0.0.1\"\n",
  )
  @fs.write_file("\{dir}/lib/moon.pkg", "")
  @fs.write_file(
    "\{dir}/lib/lib.mbt",
    "///|\npub fn answer() -> Int {\n  42\n}\n",
  )
  @fs.write_file("\{dir}/.gitignore", "_build/\n.mooncakes/\n")
  git(["init", "-q"])
  git(["add", ".gitignore", "moon.mod", "lib/moon.pkg", "lib/lib.mbt"])
  git(["commit", "-q", "-m", "fixture"])
  // The check writes the interface; an untracked interface fails.
  let (code, output) = lint()
  assert_true(code != 0, msg=output)
  assert_true(output.contains("lib/pkg.generated.mbti"), msg=output)
  // A staged interface passes, so the pre-commit hook accepts it.
  git(["add", "lib/pkg.generated.mbti"])
  let (code, output) = lint()
  assert_eq(code, 0, msg=output)
  git(["commit", "-q", "-m", "interface"])
  // An API change without its interface fails.
  @fs.write_file(
    "\{dir}/lib/lib.mbt",
    "///|\npub fn answer() -> Int {\n  42\n}\n\n///|\npub fn other() -> Int {\n  7\n}\n",
  )
  git(["commit", "-q", "-am", "api"])
  let (code, output) = lint()
  assert_true(code != 0, msg=output)
  assert_true(output.contains("lib/pkg.generated.mbti"), msg=output)
}
