import {
  "moonrockz/moon-lander-site/runtime",
  "moonrockz/moon-lander-site/policy",
  "moonrockz/telescope/model",
  "moonbitlang/async",
  "moonbitlang/core/env",
  "moonbitlang/x/sys",
}
// The executable delegates filesystem and process I/O to the native Telescope host.
supported_targets = "native"
pkgtype(kind: "executable")
