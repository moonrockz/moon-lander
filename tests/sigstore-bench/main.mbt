///|
/// Local benchmark of one Sigstore bundle verification (openspec
/// add-sigstore-verification, task 2.3). Run it only through
/// `mise run bench:sigstore`. It is not a test, and `mise run check`, CI and
/// the release workflow never run it.
///
/// It times the parse of the pinned public-good root, the parse of a real
/// GitHub bundle and one full `verify` of that bundle, with the monotonic clock
/// of `moonbitlang/core/bench`, and prints the fastest of `ROUNDS` rounds in
/// microseconds. Use the numbers to compare targets and changes only.

///|
/// The number of rounds of each step. The report gives the fastest round.
const ROUNDS : Int32 = 10

///|
/// The cli/cli 2.50.0 attestation bundle for `gh_2.50.0_linux_amd64.tar.gz`,
/// copied from `pkgs/sigstore/testdata/github/cli-2.50.0.sigstore.json`
/// (SHA-256 6c00d73d7de8afe44c8b79c07b44f16e6bceee1551542a7da9031cf1645e5598).
/// wasm and wasm-gc programs cannot read files, so the text is inline.
let bundle_json : String =
  #|{"mediaType":"application/vnd.dev.sigstore.bundle.v0.3+json","verificationMaterial":{"certificate":{"rawBytes":""},"tlogEntries":[{"logIndex":"97913918","logId":{"keyId":"wNI9atQGlz+VWfO6LRygH4QUfY/8W4RFwiT5i5WRgB0="},"kindVersion":{"kind":"dsse","version":"0.0.1"},"integratedTime":"1716998983","inclusionPromise":{"signedEntryTimestamp":"MEQCID0Dfk+UJPn4Xc6NBBJwfVFPN3WjmYthWkyvdowOGEsjAiAIIqD1VikyxTjyNgclxzaZg91MN0llSnFYS20rxqyB6Q=="},"inclusionProof":{"logIndex":"93750487","rootHash":"uxFypf7s0hW1rTnMZMG/FkoVc2aIcpdRN+Q+GySh+8Q=","treeSize":"93750488","hashes":["GfT874O1doY6Et0xcg9VGY3Pl07vqQeDWXcL3QvT1iM=","C3bdAkfiDV3yod5BFK67MdjIE3HuurZtnRdYkikDy28=","Ow7qeLJTyR+sty23G3IBbq7NGn9E1YyQ4TovjVCbNBQ=","j9mlFNxo8EIw72x9ZlIe6qRSIKc3WRmpqJY56ESP+U0=","L7xfPpL8AE9ijsQTZeSX7QcbyCPHSxS7ch8Rc4JJVhQ=","DZjlMkk1MuzKvAUiWk9KMj9eQjzPpj5GHG9I2Vp+yaU=","Tgve40VPFfuei+0nhupdGpfPPR+hPpZjxgTiDT8WNoY=","wV+S/7tLtYGzkLaSb6UDqexNyhMvumHK/RpTNvEZuLU=","uwaWufty6sn6XqO1Tb9M3Vz6sBKPu0HT36mStxJNd7s=","jUfeMOXQP0XF1JAnCEETVbfRKMUwCzrVUzYi8vnDMVs=","xQKjzJAwwdlQG/YUYBKPXxbCmhMYKo1wnv+6vDuKWhQ=","cX3Agx+hP66t1ZLbX/yHbfjU46/3m/VAmWyG/fhxAVc=","sjohk/3DQIfXTgf/5XpwtdF7yNbrf8YykOMHr1CyBYQ=","98enzMaC+x5oCMvIZQA5z8vu2apDMCFvE/935NfuPw8="],"checkpoint":{"envelope":"rekor.sigstore.dev - 2605736670972794746\n93750488\nuxFypf7s0hW1rTnMZMG/FkoVc2aIcpdRN+Q+GySh+8Q=\n\n— rekor.sigstore.dev wNI9ajBFAiEA+MMQJ9gyd1UV6I0k8jj5FvB634xLtkTYrc8l9DSyO84CIFrf83X/eVDL/HHLcwgke9ecAqXauQmsHUI1LrrmjJe7\n"}},"canonicalizedBody":""}],"timestampVerificationData":{}},"dsseEnvelope":{"payload":"","payloadType":"application/vnd.in-toto+json","signatures":[{"sig":"MEYCIQD2iIs2McbmnzFR6qcaZkgYJ//FysRtk+xBH9XNspRPegIhAM4FocQSYnWrxgQSNjXs4m+Od0b7gW20tlAEB60ngoUb"}]}}

///|
/// Run `step` `ROUNDS` times and print the fastest round in microseconds.
fn measure(name : String, step : () -> Unit raise) -> Unit raise {
  let mut best = 0.0
  for round in 0..<ROUNDS {
    let start = @bench.monotonic_clock_start()
    step()
    let elapsed = @bench.monotonic_clock_end(start)
    if round == 0 || elapsed < best {
      best = elapsed
    }
  }
  // The clock gives microseconds.
  println("\{name}: \{best.to_int()} us")
}

///|
fn main raise {
  let digest = @sigstore.ArtifactDigest::parse(
    "sha256:7f9795b3ce99351a1bfc6ea3b09b7363cb1eccca19978a046bcb477839efab82",
  )
  let policy = @sigstore.Policy::github_workflow(
    @sigstore.GitHubRepository::parse("cli/cli"),
    workflow=@sigstore.WorkflowPath::parse(".github/workflows/deployment.yml"),
  )
  let now = @sigstore.Instant::from_unix_seconds(1793000000L)
  let root = @sigstore.TrustedRoot::public_good()
  let bundle = @sigstore.Bundle::parse(bundle_json)
  measure("parse the public-good trusted root", () => {
    ignore(@sigstore.TrustedRoot::public_good())
  })
  measure("parse the bundle", () => ignore(@sigstore.Bundle::parse(bundle_json)))
  measure("verify the parsed bundle", () => {
    guard @sigstore.verify(bundle, digest, root, policy, now~) is Verified(_) else {
      fail("the bundle did not verify")
    }
  })
  measure("parse and verify from text", () => {
    let verdict = @sigstore.verify(
      @sigstore.Bundle::parse(bundle_json),
      digest,
      @sigstore.TrustedRoot::public_good(),
      policy,
      now~,
    )
    guard verdict is Verified(_) else { fail("the bundle did not verify") }
  })
}
