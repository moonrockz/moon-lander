----
import {
  "moonbitlang/async@0.22.7",
  "moonbitlang/async@0.22.7/fs",
  "moonbitlang/async@0.22.7/process",
  "moonbitlang/x@0.5.6/sys",
}
----

///|
/// Check that the package structure of the workspace is valid.
///
/// - `moon.work` exists and lists at least one member.
/// - Each active member has `moon.mod`, and `moon.pkg` in its root or in a sub-directory.
/// - Each directory under `pkgs/` and `apps/` that has `moon.mod` is an active member.
/// - No module except the unpublished docs tool `apps/site` imports a UI library.
/// - Each framework module imports only the framework modules below it, and core imports no
///   module (openspec split-framework-modules, design D8).
/// - The actors module imports only async and Ion externally, and actors packages use only
///   the Ion data model package (openspec add-actor-runtime-events).
///
/// A member is active when its line starts, after whitespace, with a quoted path (`"pkgs/x"` or
/// `"./pkgs/x"`). A commented-out entry starts with `#`, so it does not count.
///
/// Usage: `mise run validate:packages`, or `moonx scripts/toolchain.mbtx scripts/validate-packages.mbtx`.
/// It exits with 0 when the structure is valid, else with 1.

///|
/// Directories whose children are workspace members.
let member_roots : Array[String] = ["pkgs", "apps"]

///|
/// UI libraries. Only the docs tool can import them.
let ui_libraries : Array[String] = [
  "moonbit-community/rabbita", "moonrockz/telescope",
]

///|
/// The unpublished docs tool, the only module that can import a UI library.
let docs_tool : String = "apps/site"

///|
/// The framework modules: the folder, the module name and the framework modules that the
/// module can import. The order is the dependency direction, from the bottom up.
let framework : Array[(String, String, Array[String])] = [
  ("pkgs/core", "moonrockz/moon-lander-core", []),
  ("pkgs/logging", "moonrockz/moon-lander-logging", []),
  (
    "pkgs/config",
    "moonrockz/moon-lander-config",
    ["moonrockz/moon-lander-core", "moonrockz/moon-lander-logging"],
  ),
  (
    "pkgs/mediator",
    "moonrockz/moon-lander-mediator",
    ["moonrockz/moon-lander-core", "moonrockz/moon-lander-logging"],
  ),
  (
    "pkgs/logging-hosting-async",
    "moonrockz/moon-lander-logging-hosting-async",
    ["moonrockz/moon-lander-core", "moonrockz/moon-lander-logging"],
  ),
  (
    "pkgs/actors",
    "moonrockz/moon-lander-actors",
    ["moonrockz/moon-lander-core"],
  ),
  (
    "pkgs/hosting",
    "moonrockz/moon-lander-hosting",
    [
      "moonrockz/moon-lander-core", "moonrockz/moon-lander-logging", "moonrockz/moon-lander-config",
      "moonrockz/moon-lander-logging-hosting-async",
    ],
  ),
  ("pkgs/moonx", "moonrockz/moon-lander-moonx", []),
  (
    "pkgs/lander",
    "moonrockz/moon-lander",
    [
      "moonrockz/moon-lander-core", "moonrockz/moon-lander-logging", "moonrockz/moon-lander-config",
      "moonrockz/moon-lander-mediator", "moonrockz/moon-lander-logging-hosting-async",
      "moonrockz/moon-lander-actors", "moonrockz/moon-lander-hosting",
    ],
  ),
]

///|
/// The framework modules that can import only some external modules: the folder and the external
/// modules that the module can import. A framework module that is not in this table, and is not
/// core or logging, has no limit on its external imports.
let external_limits : Array[(String, Array[String])] = [
  ("pkgs/actors", ["moonbitlang/async", "moonrockz/ion"]),
  ("pkgs/moonx", ["moonbitlang/x"]),
]

///|
/// The module names that the `moon.mod` text `manifest` imports: each quoted string in each
/// `import { ... }` block, without its `@<version>`. A `//` comment is not read, so a quoted
/// name in a comment or in another field does not count.
fn imported_modules(manifest : String) -> Array[String] {
  let text = manifest
    .split("\n")
    .map(line => {
      match line.find("//") {
        Some(at) => line[:at].to_owned()
        None => line.to_owned()
      }
    })
    .collect()
    .join("\n")
  let names = []
  let mut rest = text
  while rest.find("import") is Some(start) {
    let after = rest[start + 6:].to_owned()
    guard after.trim_start(chars=" \t\r\n").has_prefix("{") else {
      rest = after
      continue
    }
    guard after.find("{") is Some(open) &&
      after.find("}") is Some(close) &&
      close > open else {
      break
    }
    let block = after[open + 1:close].to_owned()
    let parts = block.split("\"").map(part => part.to_owned()).collect()
    for i in 0..<parts.length() {
      // The odd parts are the text between a pair of quotes.
      if i % 2 == 1 {
        let name = parts[i]
        names.push(
          match name.find("@") {
            Some(at) => name[:at].to_owned()
            None => name
          },
        )
      }
    }
    rest = after[close + 1:].to_owned()
  }
  names
}

///|
/// The module name in the `moon.mod` text `manifest`: the quoted text of its `name = ` line.
fn module_name(manifest : String) -> String? {
  for line in manifest.split("\n") {
    let entry = line.trim_start(chars=" \t\r").to_owned()
    guard entry.has_prefix("name") else { continue }
    let parts = entry.split("\"").map(part => part.to_owned()).collect()
    if parts.length() >= 3 && parts[0].trim(chars=" \t") == "name =" {
      return Some(parts[1])
    }
  }
  None
}

///|
/// One error for each framework module folder that is not an active member, or whose
/// `moon.mod` gives another module name than the table. `names` maps a folder to the name
/// in its `moon.mod`.
fn framework_member_errors(
  active : Array[String],
  names : Map[String, String],
) -> Array[String] {
  let errors = []
  for entry in framework {
    let (folder, name, _) = entry
    if !active.contains(folder) {
      errors.push(
        "\{folder} is a framework module folder but not an active member of moon.work",
      )
    } else if names.get(folder) is Some(found) && found != name {
      errors.push(
        "\{folder}/moon.mod gives the name \{found}; expected \{name}",
      )
    } else if names.get(folder) is None {
      errors.push("\{folder}/moon.mod gives no module name; expected \{name}")
    }
  }
  errors
}

///|
/// One error for each UI library that the `moon.mod` text `manifest` of the member at
/// `path` imports, when the member is not the docs tool.
fn ui_import_errors(path : String, manifest : String) -> Array[String] {
  guard path != docs_tool else { return [] }
  let errors = []
  for name in imported_modules(manifest) {
    if ui_libraries.contains(name) {
      errors.push(
        "\{path} imports the UI library \{name}; only \{docs_tool} can import a UI library",
      )
    }
  }
  errors
}

///|
/// One error for each import of the framework member at `path` that breaks the dependency
/// direction: core or logging imports a module, a framework module imports a framework module that
/// is not below it, or a module of `external_limits` imports an external module that is not in its
/// list. A member that is not a framework module gives no error.
fn dependency_errors(path : String, manifest : String) -> Array[String] {
  guard framework.search_by(entry => entry.0 == path) is Some(index) else {
    return []
  }
  let (_, own, allowed) = framework[index]
  let external = match external_limits.search_by(entry => entry.0 == path) {
    Some(at) => Some(external_limits[at].1)
    None => None
  }
  let errors = []
  for name in imported_modules(manifest) {
    let is_framework = framework.iter().any(other => other.1 == name)
    if path == "pkgs/core" || path == "pkgs/logging" {
      errors.push(
        "\{path} imports \{name}; \{own} imports no module except moonbitlang/core",
      )
    } else if is_framework && !allowed.contains(name) {
      errors.push(
        "\{own} imports \{name}, against the dependency direction of the framework modules",
      )
    } else if !is_framework && external is Some(limit) && !limit.contains(name) {
      errors.push(
        "\{path} imports \{name}; \{own} imports no external module except \{limit.join(", ")}",
      )
    }
  }
  errors
}

///|
/// Report Ion imports outside the data model in an actors package manifest.
fn actors_package_errors(path : String, manifest : String) -> Array[String] {
  guard path.has_prefix("pkgs/actors/") else { return [] }
  imported_modules(manifest).filter_map(name => {
    if (name == "moonrockz/ion" || name.has_prefix("moonrockz/ion/")) &&
      name != "moonrockz/ion/ion" {
      Some(
        "\{path} imports \{name}; actors packages import only moonrockz/ion/ion from Ion",
      )
    } else {
      None
    }
  })
}

///|
/// Check every package below a module, including nested packages and test imports.
async fn package_import_errors(dir : String) -> Array[String] {
  let errors = []
  if @fs.exists("\{dir}/moon.pkg") {
    errors.append(
      actors_package_errors(
        "\{dir}/moon.pkg",
        @fs.read_file("\{dir}/moon.pkg").text(),
      ),
    )
  }
  for entry in @fs.readdir(dir) {
    guard entry != "_build" && entry != ".mooncakes" else { continue }
    let child = "\{dir}/\{entry}"
    guard @fs.kind(child) is Directory else { continue }
    errors.append(package_import_errors(child))
  }
  errors
}

///|
/// Parse the active members out of `moon.work`, without a leading `./`.
fn members(work : String) -> Array[String] {
  let found = []
  for line in work.split("\n") {
    let entry = line.trim_start(chars=" \t\r").to_owned()
    guard entry.has_prefix("\"") else { continue }
    let rest = entry[1:]
    guard rest.find("\"") is Some(end) else { continue }
    let path = rest[:end].to_owned()
    let path = if path.has_prefix("./") { path[2:].to_owned() } else { path }
    if path == "." || path.is_empty() {
      continue
    }
    found.push(path)
  }
  found
}

///|
/// Whether any directory at or below `dir` contains `moon.pkg`.
async fn has_package(dir : String) -> Bool {
  if @fs.exists("\{dir}/moon.pkg") {
    return true
  }
  for entry in @fs.readdir(dir) {
    let child = "\{dir}/\{entry}"
    guard entry != "_build" && entry != ".mooncakes" else { continue }
    guard @fs.kind(child) is Directory else { continue }
    if has_package(child) {
      return true
    }
  }
  false
}

///|
async fn main {
  println("🔍 Verifying package structure...")
  let mut errors = 0
  let error = fn(message : String) {
    println("❌ ERROR: \{message}")
    errors += 1
  }
  let work = if @fs.exists("moon.work") {
    @fs.read_file("moon.work").text()
  } else {
    error("moon.work workspace manifest missing")
    ""
  }
  let active = members(work)
  if work != "" && active.is_empty() {
    error("moon.work lists no members")
  }
  let names : Map[String, String] = Map([])
  for path in active {
    if @fs.exists("\{path}/moon.mod") &&
      module_name(@fs.read_file("\{path}/moon.mod").text()) is Some(name) {
      names[path] = name
    }
  }
  if work != "" {
    for message in framework_member_errors(active, names) {
      error(message)
    }
  }
  for path in active {
    if !@fs.exists(path) {
      error("\{path} is a moon.work member but the directory is missing")
      continue
    }
    if !@fs.exists("\{path}/moon.mod") {
      error("moon.mod missing for \{path}")
      continue
    }
    let manifest = @fs.read_file("\{path}/moon.mod").text()
    for message in ui_import_errors(path, manifest) {
      error(message)
    }
    for message in dependency_errors(path, manifest) {
      error(message)
    }
    if path == "pkgs/actors" {
      for message in package_import_errors(path) {
        error(message)
      }
    }
    if !has_package(path) {
      error("\{path} has no moon.pkg in its tree")
      continue
    }
    println("✓ \{path}")
  }
  for root in member_roots {
    guard @fs.exists(root) else { continue }
    for entry in @fs.readdir(root) {
      let dir = "\{root}/\{entry}"
      guard @fs.exists("\{dir}/moon.mod") else { continue }
      if !active.contains(dir) {
        error("\{dir} has moon.mod but is not an active member in moon.work")
      }
    }
  }
  if errors == 0 {
    println("✅ All package configurations valid")
  } else {
    println("❌ Found \{errors} configuration error(s)")
    @sys.exit(1)
  }
}

///|
test "a library module that imports Rabbita fails and is named" {
  let manifest =
    #|name = "moonrockz/moon-lander"
    #|
    #|import {
    #|  "moonbitlang/async@0.22.5",
    #|  "moonbit-community/rabbita@0.16.5",
    #|}
  assert_eq(ui_import_errors("pkgs/lander", manifest), [
    "pkgs/lander imports the UI library moonbit-community/rabbita; only apps/site can import a UI library",
  ])
}

///|
test "the docs tool can import Rabbita" {
  let manifest =
    #|import {
    #|  "moonbit-community/rabbita@0.16.5",
    #|}
  assert_eq(ui_import_errors("apps/site", manifest), [])
}

///|
test "Telescope is restricted to the private docs tool" {
  let manifest = "import {\n  \"moonrockz/telescope@0.4.0\",\n}\n"
  assert_eq(ui_import_errors("apps/site", manifest), [])
  assert_eq(ui_import_errors("pkgs/lander", manifest).length(), 1)
}

///|
test "other imports and a name without a version" {
  let manifest =
    #|import {
    #|  "moonbitlang/async@0.22.5",
    #|  "moonbit-community/rabbita-extras@1.0.0",
    #|  "moonbit-community/rabbita",
    #|}
  assert_eq(ui_import_errors("pkgs/notebooks", manifest).length(), 1)
}

///|
test "a framework module can import the modules below it" {
  let manifest =
    #|import {
    #|  "moonrockz/moon-lander-core@0.3.0",
    #|  "moonrockz/moon-lander-config@0.3.0",
    #|  "moonbitlang/async@0.22.5",
    #|}
  assert_eq(dependency_errors("pkgs/hosting", manifest), [])
  assert_eq(dependency_errors("pkgs/lander", manifest), [])
}

///|
test "an import against the direction names both modules" {
  let manifest =
    #|import {
    #|  "moonrockz/moon-lander-core@0.3.0",
    #|  "moonrockz/moon-lander-hosting@0.3.0",
    #|}
  assert_eq(dependency_errors("pkgs/config", manifest), [
    "moonrockz/moon-lander-config imports moonrockz/moon-lander-hosting, against the dependency direction of the framework modules",
  ])
  assert_eq(
    dependency_errors(
      "pkgs/mediator",
      (
        #|import {
        #|  "moonrockz/moon-lander-config@0.3.0",
        #|}
      ),
    ).length(),
    1,
  )
}

///|
test "core imports no module" {
  let manifest =
    #|import {
    #|  "moonrockz/ion@0.6.0",
    #|}
  assert_eq(dependency_errors("pkgs/core", manifest), [
    "pkgs/core imports moonrockz/ion; moonrockz/moon-lander-core imports no module except moonbitlang/core",
  ])
  assert_eq(
    dependency_errors("pkgs/core", "name = \"moonrockz/moon-lander-core\"\n"),
    [],
  )
}

///|
test "logging imports no module" {
  assert_eq(
    dependency_errors(
      "pkgs/logging",
      (
        #|import {
        #|  "moonrockz/moon-lander-core@0.3.0",
        #|}
      ),
    ),
    [
      "pkgs/logging imports moonrockz/moon-lander-core; moonrockz/moon-lander-logging imports no module except moonbitlang/core",
    ],
  )
  assert_eq(
    dependency_errors(
      "pkgs/logging",
      (
        #|import {
        #|  "moonbitlang/async@0.22.5",
        #|}
      ),
    ),
    [
      "pkgs/logging imports moonbitlang/async; moonrockz/moon-lander-logging imports no module except moonbitlang/core",
    ],
  )
  assert_eq(
    dependency_errors(
      "pkgs/logging", "name = \"moonrockz/moon-lander-logging\"\n",
    ),
    [],
  )
}

///|
test "each module above the bottom can import logging" {
  let manifest =
    #|import {
    #|  "moonrockz/moon-lander-core@0.3.0",
    #|  "moonrockz/moon-lander-logging@0.3.0",
    #|}
  for path in ["pkgs/config", "pkgs/mediator", "pkgs/hosting", "pkgs/lander"] {
    assert_eq(dependency_errors(path, manifest), [])
  }
}

///|
test "the logging runtime imports core, logging and async, but not config, mediator or hosting" {
  let manifest =
    #|import {
    #|  "moonrockz/moon-lander-core@0.4.0",
    #|  "moonrockz/moon-lander-logging@0.4.0",
    #|  "moonbitlang/async@0.22.5",
    #|}
  assert_eq(dependency_errors("pkgs/logging-hosting-async", manifest), [])
  for
    name in [
      "moonrockz/moon-lander-config", "moonrockz/moon-lander-mediator", "moonrockz/moon-lander-hosting",
    ] {
    assert_eq(
      dependency_errors(
        "pkgs/logging-hosting-async",
        "import {\n  \"\{name}@0.4.0\",\n}\n",
      ),
      [
        "moonrockz/moon-lander-logging-hosting-async imports \{name}, against the dependency direction of the framework modules",
      ],
    )
  }
}

///|
test "hosting and the umbrella can import the logging runtime" {
  let manifest =
    #|import {
    #|  "moonrockz/moon-lander-logging-hosting-async@0.4.0",
    #|}
  assert_eq(dependency_errors("pkgs/hosting", manifest), [])
  assert_eq(dependency_errors("pkgs/lander", manifest), [])
  assert_eq(dependency_errors("pkgs/config", manifest).length(), 1)
  assert_eq(dependency_errors("pkgs/mediator", manifest).length(), 1)
  assert_eq(dependency_errors("pkgs/logging", manifest).length(), 1)
}

///|
test "a module outside the framework gives no dependency error" {
  let manifest =
    #|import {
    #|  "moonrockz/moon-lander-hosting@0.3.0",
    #|}
  assert_eq(dependency_errors("tests", manifest), [])
}

///|
test "imports on one line, comments and other fields" {
  assert_eq(imported_modules("import { \"moonrockz/ion@0.6.0\", \"a/b\" }\n"), [
    "moonrockz/ion", "a/b",
  ])
  let manifest =
    #|name = "moonrockz/moon-lander-core"
    #|keywords = [
    #|  "config",
    #|]
    #|// "moonrockz/ion@0.6.0"
    #|import { "moonbitlang/async@0.22.5", // "x/y"
    #|  "moonrockz/expect@0.6.1", "moonrockz/ion@0.6.0",
    #|}
  assert_eq(imported_modules(manifest), [
    "moonbitlang/async", "moonrockz/expect", "moonrockz/ion",
  ])
  assert_eq(
    dependency_errors("pkgs/core", "keywords = [\n  \"config\",\n]\n"),
    [],
  )
  assert_eq(
    dependency_errors("pkgs/core", "import { \"moonrockz/ion@0.6.0\" }").length(),
    1,
  )
  assert_eq(
    dependency_errors(
      "pkgs/config", "import {\n  \"moonrockz/moon-lander-core@0.3.0\", \"moonrockz/moon-lander-hosting@0.3.0\",\n}\n",
    ).length(),
    1,
  )
}

///|
test "the module name of a moon.mod" {
  assert_eq(
    module_name(
      "name = \"moonrockz/moon-lander-core\"\n\nversion = \"0.3.0\"\n",
    ),
    Some("moonrockz/moon-lander-core"),
  )
  assert_eq(module_name("version = \"0.3.0\"\n"), None)
}

///|
test "each framework module folder is a member with its module name" {
  let active = [
    "pkgs/core", "pkgs/logging", "pkgs/config", "pkgs/mediator", "pkgs/logging-hosting-async",
    "pkgs/actors", "pkgs/hosting", "pkgs/moonx", "pkgs/lander",
  ]
  let names : Map[String, String] = Map([])
  for entry in framework {
    names[entry.0] = entry.1
  }
  assert_eq(framework_member_errors(active, names), [])
  names["pkgs/hosting"] = "moonrockz/lander-hosting"
  assert_eq(framework_member_errors(active, names), [
    "pkgs/hosting/moon.mod gives the name moonrockz/lander-hosting; expected moonrockz/moon-lander-hosting",
  ])
  names["pkgs/hosting"] = "moonrockz/moon-lander-hosting"
  assert_eq(
    framework_member_errors(
      active.filter(path => path != "pkgs/mediator"),
      names,
    ),
    [
      "pkgs/mediator is a framework module folder but not an active member of moon.work",
    ],
  )
  assert_eq(
    framework_member_errors(
      active.filter(path => path != "pkgs/logging"),
      names,
    ),
    [
      "pkgs/logging is a framework module folder but not an active member of moon.work",
    ],
  )
  assert_eq(
    framework_member_errors(
      active.filter(path => path != "pkgs/logging-hosting-async"),
      names,
    ),
    [
      "pkgs/logging-hosting-async is a framework module folder but not an active member of moon.work",
    ],
  )
  assert_eq(
    framework_member_errors(active.filter(path => path != "pkgs/actors"), names),
    [
      "pkgs/actors is a framework module folder but not an active member of moon.work",
    ],
  )
}

///|
test "the framework has nine modules in the dependency direction" {
  assert_eq(framework.map(entry => entry.0), [
    "pkgs/core", "pkgs/logging", "pkgs/config", "pkgs/mediator", "pkgs/logging-hosting-async",
    "pkgs/actors", "pkgs/hosting", "pkgs/moonx", "pkgs/lander",
  ])
}

///|
test "actors imports core, async and Ion, but no other framework or external module" {
  let manifest =
    #|name = "moonrockz/moon-lander-actors"
    #|
    #|import {
    #|  "moonrockz/moon-lander-core@0.7.3",
    #|  "moonbitlang/async@0.22.5",
    #|  "moonrockz/ion@0.6.0",
    #|}
  assert_eq(dependency_errors("pkgs/actors", manifest), [])
  assert_eq(
    dependency_errors(
      "pkgs/actors", "name = \"moonrockz/moon-lander-actors\"\n",
    ),
    [],
  )
  for
    name in [
      "moonrockz/moon-lander-logging", "moonrockz/moon-lander-config", "moonrockz/moon-lander-mediator",
      "moonrockz/moon-lander-logging-hosting-async", "moonrockz/moon-lander-hosting",
      "moonrockz/moon-lander",
    ] {
    assert_eq(
      dependency_errors("pkgs/actors", "import {\n  \"\{name}@0.7.3\",\n}\n"),
      [
        "moonrockz/moon-lander-actors imports \{name}, against the dependency direction of the framework modules",
      ],
    )
  }
  for name in ["moonbitlang/x", "moonbit-community/toml"] {
    assert_eq(
      dependency_errors("pkgs/actors", "import {\n  \"\{name}@0.1.0\",\n}\n"),
      [
        "pkgs/actors imports \{name}; moonrockz/moon-lander-actors imports no external module except moonbitlang/async, moonrockz/ion",
      ],
    )
  }
}

///|
test "actors importing hosting or mediator names both modules" {
  let manifest =
    #|import {
    #|  "moonrockz/moon-lander-core@0.7.3",
    #|  "moonrockz/moon-lander-hosting@0.7.3",
    #|  "moonrockz/moon-lander-mediator@0.7.3",
    #|}
  assert_eq(dependency_errors("pkgs/actors", manifest), [
    "moonrockz/moon-lander-actors imports moonrockz/moon-lander-hosting, against the dependency direction of the framework modules",
    "moonrockz/moon-lander-actors imports moonrockz/moon-lander-mediator, against the dependency direction of the framework modules",
  ])
}

///|
test "only the umbrella can import actors" {
  let manifest =
    #|import {
    #|  "moonrockz/moon-lander-actors@0.7.3",
    #|}
  assert_eq(dependency_errors("pkgs/lander", manifest), [])
  for
    path in [
      "pkgs/config", "pkgs/mediator", "pkgs/logging-hosting-async", "pkgs/hosting",
    ] {
    assert_eq(dependency_errors(path, manifest).length(), 1, msg=path)
  }
}

///|
test "the actors and Moonx external limits leave other modules unchanged" {
  let manifest =
    #|import {
    #|  "moonrockz/moon-lander-core@0.7.3",
    #|  "moonbitlang/x@0.5.6",
    #|}
  for
    path in [
      "pkgs/config", "pkgs/mediator", "pkgs/logging-hosting-async", "pkgs/hosting",
      "pkgs/lander",
    ] {
    assert_eq(dependency_errors(path, manifest), [], msg=path)
  }
}

///|
test "Moonx is an isolated optional leaf and never imports canonical async" {
  assert_eq(
    dependency_errors("pkgs/moonx", "import {\n  \"moonbitlang/x@0.5.6\",\n}\n"),
    [],
  )
  for entry in framework {
    if entry.0 == "pkgs/moonx" {
      continue
    }
    assert_eq(
      dependency_errors(
        "pkgs/moonx",
        "import {\n  \"" + entry.1 + "@0.8.0\",\n}\n",
      ).length(),
      1,
    )
    assert_eq(
      dependency_errors(
        entry.0,
        "import {\n  \"moonrockz/moon-lander-moonx@0.8.0\",\n}\n",
      ).length(),
      1,
    )
  }
  assert_eq(
    dependency_errors(
      "pkgs/moonx", "import {\n  \"moonbitlang/async@0.22.5\",\n}\n",
    ),
    [
      "pkgs/moonx imports moonbitlang/async; moonrockz/moon-lander-moonx imports no external module except moonbitlang/x",
    ],
  )
}

///|
test "actors packages import only the Ion data model" {
  let allowed = "import { \"moonrockz/ion/ion\", \"moonbitlang/core/debug\", }"
  assert_eq(actors_package_errors("pkgs/actors/moon.pkg", allowed), [])
  assert_eq(actors_package_errors("pkgs/actors/runtime/moon.pkg", allowed), [])
  for
    name in [
      "moonrockz/ion/text", "moonrockz/ion/binary", "moonrockz/ion/schema", "moonrockz/ion/json",
      "moonrockz/ion",
    ] {
    let manifest = "import { \"\{name}\" @codec } for \"test\""
    assert_eq(
      actors_package_errors("pkgs/actors/nested/probe/moon.pkg", manifest),
      [
        "pkgs/actors/nested/probe/moon.pkg imports \{name}; actors packages import only moonrockz/ion/ion from Ion",
      ],
    )
    assert_eq(actors_package_errors("pkgs/config/moon.pkg", manifest), [])
    assert_eq(actors_package_errors("pkgs/actors-other/moon.pkg", manifest), [])
  }
  assert_eq(
    actors_package_errors(
      "pkgs/actors/moon.pkg", "// import { \"moonrockz/ion/text\" }\nimport { \"moonrockz/ion/ion\" }",
    ),
    [],
  )
}

///|
async test "validation checks nested actor packages and names a forbidden Ion import" {
  let script = @fs.realpath("validate-packages.mbtx")
  let dir = @fs.tmpdir(prefix="lander-actors-imports")
  defer @fs.rmdir(dir, recursive=true)
  let work = StringBuilder()
  work.write_string("members = [\n")
  for (folder, name, _) in framework {
    @fs.mkdir("\{dir}/\{folder}", recursive=true, allow_exist=true)
    @fs.write_file("\{dir}/\{folder}/moon.mod", "name = \"\{name}\"\n")
    @fs.write_file("\{dir}/\{folder}/moon.pkg", "")
    work.write_string("  \"\{folder}\",\n")
  }
  work.write_string("]\n")
  @fs.write_file("\{dir}/moon.work", work.to_string())
  @fs.write_file(
    "\{dir}/pkgs/actors/moon.mod",
    "name = \"moonrockz/moon-lander-actors\"\nimport { \"moonrockz/ion@0.6.0\" }\n",
  )
  @fs.mkdir("\{dir}/pkgs/actors/nested/probe", recursive=true)
  let package_path = "\{dir}/pkgs/actors/nested/probe/moon.pkg"
  @fs.write_file(package_path, "import { \"moonrockz/ion/ion\" }")
  let (code, out, err) = @process.collect_output("moonx", [script], cwd=dir)
  assert_eq(code, 0, msg=out.text() + err.text())
  @fs.write_file(package_path, "import { \"moonrockz/ion/text\" } for \"test\"")
  let (code, out, err) = @process.collect_output("moonx", [script], cwd=dir)
  let output = out.text() + err.text()
  assert_true(code != 0, msg=output)
  assert_true(
    output.contains(
      "pkgs/actors/nested/probe/moon.pkg imports moonrockz/ion/text",
    ),
    msg=output,
  )
}
