import {
  "moonrockz/moon-lander-core" @lander_core,
  "moonrockz/moon-lander-config" @config,
  "moonrockz/moon-lander-config/conventions",
  "moonrockz/moon-lander-config/profiles",
  "moonrockz/moon-lander-config/host",
  // Vendored moonbitlang/core/argparse until a pinned MoonBit has
  // Command::try_parse (lander-4us.5.18). The alias stays, so the return changes
  // only this line.
  "moonrockz/moon-lander-hosting/vendor/argparse" @argparse,
  "moonbitlang/core/env",
  "moonbitlang/core/immut/sorted_map",
  "moonbitlang/core/debug",
  "moonbitlang/async",
  "moonbitlang/async/stdio",
  "moonbitlang/async/js_async",
  "moonbit-community/unicode-data/xid" @xid,
  "moonbit-community/unicode-data/case_mapping" @case_mapping,
}

import {
  "moonrockz/moon-lander-hosting" @hosting,
  "moonrockz/moon-lander-hosting/argparse" @hosting_argparse,
  "moonrockz/moon-lander-config/parsers/toml",
  "moonrockz/moon-lander-core" @lander_core,
  "moonrockz/expect",
  "moonbitlang/async",
  "moonrockz/moon-lander-config" @config,
  "moonrockz/moon-lander-config/conventions",
} for "test"

import {
  "moonrockz/moon-lander-hosting/argparse" @hosting_argparse,
  "moonrockz/moon-lander-config/parsers/toml",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonrockz/expect",
  "moonbitlang/core/quickcheck",
  "moonbitlang/async",
} for "wbtest"

// The pinned build system cannot condition imports by target, so the async and
// config/host imports are unused on wasm and wasm-gc (29). Remove the override
// when the imports can be conditional.
warnings = "-29"

// `run` needs the `moonbitlang/async` event loop, which wasm and wasm-gc do not
// have. Its tests are async tests, which wasm-gc cannot run. `run_embedded`
// replaces it on wasm and wasm-gc.
options(targets: {
  "settings.process.mbt": ["native", "js"],
  "settings.embedded.mbt": ["wasm", "wasm-gc"],
  "settings.process_wbtest.mbt": ["native", "js"],
  "settings.embedded_wbtest.mbt": ["wasm", "wasm-gc"],
  "run.mbt": ["native", "js"],
  "run.embedded.mbt": ["wasm", "wasm-gc"],
  "run.embedded_wbtest.mbt": ["wasm", "wasm-gc"],
  "report.js_wbtest.mbt": ["js"],
  "node_fixture.generated.js_wbtest.mbt": ["js"],
  "run_test.mbt": ["native", "js"],
  "enclosing_test.mbt": ["native", "js"],
  "run_wbtest.mbt": ["native", "js"],
  "shutdown_timeout_wbtest.mbt": ["native", "js"],
  "signals_wbtest.mbt": ["native", "js"],
})
