import {
  "moonrockz/moon-lander-core" @lander_core,
  "moonrockz/moon-lander-config" @config,
  "moonrockz/moon-lander-config/conventions",
  "moonbitlang/core/argparse",
  "moonbitlang/core/env",
  "moonbitlang/core/immut/sorted_map",
  "moonbitlang/core/debug",
  "moonbitlang/async",
  "moonbitlang/async/stdio",
  "moonbitlang/async/js_async",
  "moonbit-community/unicode-data/xid" @xid,
  "moonbit-community/unicode-data/case_mapping" @case_mapping,
}

import {
  "moonrockz/moon-lander-hosting" @hosting,
  "moonrockz/moon-lander-core" @lander_core,
  "moonrockz/expect",
  "moonbitlang/async",
} for "test"

import {
  "moonrockz/moon-lander-hosting/argparse" @hosting_argparse,
  "moonrockz/moon-lander-config/parsers/toml",
  "moonbitlang/core/json",
  "moonrockz/expect",
  "moonbitlang/core/quickcheck",
  "moonbitlang/async",
} for "wbtest"

// Temporary until task group 13: only `run` reads the host and builds the
// contexts and the outcome, and it exists on native and js. On wasm and wasm-gc
// nothing reads them until `run_embedded`; the native/js error report reads
// the application name. Remove the
// field overrides when those fields are read. The pinned build system cannot
// condition imports by target, so the async imports are unused on wasm and
// wasm-gc (29); remove that part when the imports can be conditional.
warnings = "-7-9-29"

// `run` needs the `moonbitlang/async` event loop, which wasm and wasm-gc do not
// have. Its tests are async tests, which wasm-gc cannot run.
options(targets: {
  "settings.process.mbt": ["native", "js"],
  "settings.embedded.mbt": ["wasm", "wasm-gc"],
  "settings.process_wbtest.mbt": ["native", "js"],
  "settings.embedded_wbtest.mbt": ["wasm", "wasm-gc"],
  "run.mbt": ["native", "js"],
  "report.js_wbtest.mbt": ["js"],
  "node_fixture.generated.js_wbtest.mbt": ["js"],
  "run_test.mbt": ["native", "js"],
  "run_wbtest.mbt": ["native", "js"],
  "shutdown_timeout_wbtest.mbt": ["native", "js"],
})
