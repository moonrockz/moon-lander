----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/core/env",
  "moonbitlang/x@0.5.6/crypto",
}
----

///|
/// Generate frozen Unicode identifier ranges for the portable pattern checker.

///|
test "Unicode range input rejects malformed and overlapping property ranges" {
  assert_eq(
    parse_ranges(
      "0041..005A ; ID_Start # ASCII\n0061 ; ID_Start\n0030 ; ID_Continue\n",
    ),
    Ok(([(65, 90), (97, 97)], [(48, 48)])),
  )
  for
    source in [
      "ZZ ; ID_Start", "005A..0041 ; ID_Start", "0041 ; ID_Start\n0041 ; ID_Start",
      "0041.. ; ID_Continue",
    ] {
    assert_true(parse_ranges(source) is Err(_), msg=source)
  }
}

///|
test "Unicode rendering fixes provenance and sorted inclusive ranges" {
  let source = render_ranges([(65, 90)], [(48, 57)])
  assert_true(
    source.contains(
      "e6ca152259189ec4bc2297e93c6c88f86e162cc52814198263497f3c9b46cbe9",
    ),
  )
  assert_true(source.contains("(65, 90)"))
  assert_true(source.contains("unicode_id_continue"))
}

///|
fn unicode_hex(text : String) -> Result[Int32, String] {
  if text.is_empty() || text.length() > 6 {
    return Err("Invalid Unicode code point")
  }
  let mut result = 0
  for c in text.code_units() {
    let digit = if c >= 48 && c <= 57 {
      c.to_int() - 48
    } else if c >= 65 && c <= 70 {
      c.to_int() - 55
    } else {
      return Err("Invalid Unicode hex digit")
    }
    result = result * 16 + digit
  }
  if result > 0x10ffff {
    Err("Unicode code point out of range")
  } else {
    Ok(result)
  }
}

///|
fn parse_ranges(
  text : String,
) -> Result[(Array[(Int32, Int32)], Array[(Int32, Int32)]), String] {
  let starts : Array[(Int32, Int32)] = []
  let continues : Array[(Int32, Int32)] = []
  for line in text.split("\n") {
    let content = line.split("#").next().unwrap().trim().to_owned()
    if content.is_empty() {
      continue
    }
    let fields = content.split(";").collect()
    if fields.length() != 2 {
      return Err("Malformed Unicode property line")
    }
    let property = fields[1].trim().to_owned()
    if property != "ID_Start" && property != "ID_Continue" {
      continue
    }
    let codes = fields[0].trim().split("..").collect()
    if codes.length() < 1 || codes.length() > 2 {
      return Err("Malformed Unicode range")
    }
    let first = match unicode_hex(codes[0].to_owned()) {
      Ok(n) => n
      Err(e) => return Err(e)
    }
    let last = if codes.length() == 2 {
      match unicode_hex(codes[1].to_owned()) {
        Ok(n) => n
        Err(e) => return Err(e)
      }
    } else {
      first
    }
    let ranges = if property == "ID_Start" { starts } else { continues }
    if last < first ||
      (!ranges.is_empty() && ranges[ranges.length() - 1].1 >= first) {
      return Err("Unsorted or overlapping Unicode range")
    }
    ranges.push((first, last))
  }
  Ok((starts, continues))
}

///|
fn render_ranges(
  starts : Array[(Int32, Int32)],
  continues : Array[(Int32, Int32)],
) -> String {
  let out = StringBuilder()
  out.write_string(
    "// Generated by scripts/generate-openrpc-unicode.mbtx. Do not edit.\n// Unicode 10.0.0 DerivedCoreProperties ID_Start/ID_Continue.\n// SHA-256 e6ca152259189ec4bc2297e93c6c88f86e162cc52814198263497f3c9b46cbe9\n// Copyright 2017 Unicode, Inc. See ../UNICODE-LICENSE.txt.\n",
  )
  for
    (name, ranges) in [
      ("unicode_id_start", starts),
      ("unicode_id_continue", continues),
    ] {
    out.write_string("\n///|\nlet \{name} : Array[(Int32, Int32)] = [\n")
    for (first, last) in ranges {
      out.write_string("  (\{first}, \{last}),\n")
    }
    out.write_string("]\n")
  }
  out.to_string()
}

///|
async fn main {
  let input = @fs.read_file(
    "tests/tck/openrpc/DerivedCoreProperties-10.0.0.txt",
  )
  guard @crypto.bytes_to_hex_string(@crypto.sha256(input.binary())) ==
    "e6ca152259189ec4bc2297e93c6c88f86e162cc52814198263497f3c9b46cbe9" else {
    fail("Unicode input digest mismatch")
  }
  let (starts, continues) = parse_ranges(input.text()).unwrap()
  guard !starts.is_empty() && !continues.is_empty() else {
    fail("Missing Unicode identifier properties")
  }
  let rendered = render_ranges(starts, continues)
  let output = "pkgs/openrpc/schema/unicode.generated.mbt"
  let license = @fs.read_file("tests/tck/openrpc/LICENSE-unicode.txt").text()
  let license_path = "pkgs/openrpc/UNICODE-LICENSE.txt"
  if @env.args().contains("--check") {
    guard @fs.exists(output) &&
      @fs.read_file(output).text() == rendered &&
      @fs.exists(license_path) &&
      @fs.read_file(license_path).text() == license else {
      fail(
        "OpenRPC Unicode output is stale. Run mise run build:openrpc-unicode.",
      )
    }
    println("OpenRPC Unicode identifier data and license are current.")
  } else {
    @fs.write_file(output, rendered)
    @fs.write_file(license_path, license)
    println("Generated OpenRPC Unicode identifier data.")
  }
}

///|
async test "Unicode freshness rejects missing changed output and altered input" {
  let script = @fs.realpath("generate-openrpc-unicode.mbtx")
  let temporary = @fs.tmpdir(prefix="openrpc-unicode-check")
  defer @fs.rmdir(temporary, recursive=true)
  @fs.mkdir("\{temporary}/tests/tck/openrpc", recursive=true)
  @fs.mkdir("\{temporary}/pkgs/openrpc/schema", recursive=true)
  for file in ["DerivedCoreProperties-10.0.0.txt", "LICENSE-unicode.txt"] {
    @fs.write_file(
      "\{temporary}/tests/tck/openrpc/\{file}",
      @fs.read_file("../tests/tck/openrpc/\{file}"),
    )
  }
  let (missing, _, _) = @process.collect_output(
    "moonx",
    [script, "--check"],
    cwd=temporary,
  )
  assert_true(missing != 0)
  let (built, out, err) = @process.collect_output(
    "moonx",
    [script],
    cwd=temporary,
  )
  assert_eq(built, 0, msg=out.text() + err.text())
  let (fresh, out, err) = @process.collect_output(
    "moonx",
    [script, "--check"],
    cwd=temporary,
  )
  assert_eq(fresh, 0, msg=out.text() + err.text())
  let output = "\{temporary}/pkgs/openrpc/schema/unicode.generated.mbt"
  let original = @fs.read_file(output).text()
  @fs.write_file(output, original + "\n")
  let (changed, _, _) = @process.collect_output(
    "moonx",
    [script, "--check"],
    cwd=temporary,
  )
  assert_true(changed != 0)
  assert_eq(@fs.read_file(output).text(), original + "\n")
  @fs.write_file(output, original)
  @fs.write_file(
    "\{temporary}/tests/tck/openrpc/DerivedCoreProperties-10.0.0.txt",
    "tampered",
  )
  let (tampered, _, _) = @process.collect_output(
    "moonx",
    [script, "--check"],
    cwd=temporary,
  )
  assert_true(tampered != 0)
}
