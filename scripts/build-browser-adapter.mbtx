///|
/// Generate the production browser adapter without requiring a consumer build step.
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/core/env",
}

///|
async fn command(args : Array[String]) -> Unit {
  let (code, out, err) = @process.collect_output("bun", args)
  guard code == 0 else { fail(out.text() + err.text()) }
}

///|
async fn main {
  let started = @async.now()
  let dir = @fs.tmpdir(prefix="lander-browser-build")
  defer @fs.rmdir(dir, recursive=true)
  let output = "\{dir}/adapter.js"
  command([
    "build", "pkgs/lander/adapters/browser/entry.ts", "--target=browser", "--format=iife",
    "--outfile", output,
  ])
  let bundle = @fs.read_file(output).text().replace_all(old="\r\n", new="\n")
  // The library is UI-free: only the application opens a picker or asks for
  // permission. Reject these Web APIs in the production adapter.
  for
    forbidden in [
      "showDirectoryPicker", "showOpenFilePicker", "showSaveFilePicker", "requestPermission",
      "queryPermission",
    ] {
    guard !bundle.contains(forbidden) else {
      fail("The browser adapter must not call \{forbidden}.")
    }
  }
  let source = StringBuilder()
  source.write_string(
    "// Generated by scripts/build-browser-adapter.mbtx. Do not edit.\n\n///|\nextern \"js\" fn browser_adapter() -> BrowserAdapter =\n  #|() => {\n  #|  let adapter;\n  #|  const receiveBrowserAdapter = value => { adapter = value; };\n",
  )
  for line in bundle.trim_end().split("\n") {
    if line.trim_end().is_empty() {
      source.write_string("  #|\n")
    } else {
      source.write_string("  #|  \{line.trim_end()}\n")
    }
  }
  source.write_string("  #|  return adapter;\n  #|}\n")
  let generated = "pkgs/lander/config/browser/browser.generated.js.mbt"
  let source = source.to_string()
  if @env.args().contains("--check") {
    guard @fs.exists(generated) && @fs.read_file(generated).text() == source else {
      fail("Browser adapter is stale. Run mise run build:browser-adapter.")
    }
    println("Browser adapter is current.")
    return
  }
  @fs.write_file(generated, source)
  println("Generated browser adapter in \{@async.now() - started} ms")
}

///|
async test "freshness rejects changed behavior and forbidden imports without rewriting" {
  let script = @fs.realpath("build-browser-adapter.mbtx")
  let dir = @fs.tmpdir(prefix="lander-browser-freshness")
  defer @fs.rmdir(dir, recursive=true)
  @fs.mkdir("\{dir}/pkgs/lander/adapters/browser", recursive=true)
  @fs.mkdir("\{dir}/pkgs/lander/config/browser", recursive=true)
  let entry = "\{dir}/pkgs/lander/adapters/browser/entry.ts"
  let generated = "\{dir}/pkgs/lander/config/browser/browser.generated.js.mbt"
  @fs.write_file(
    entry, "declare function receiveBrowserAdapter(value: unknown): void; receiveBrowserAdapter({value: 1});\n",
  )
  let (missing, _, _) = @process.collect_output(
    "moonx",
    [script, "--check"],
    cwd=dir,
  )
  assert_true(missing != 0)
  let (built, out, err) = @process.collect_output("moonx", [script], cwd=dir)
  assert_eq(built, 0, msg=out.text() + err.text())
  let (current, out, err) = @process.collect_output(
    "moonx",
    [script, "--check"],
    cwd=dir,
  )
  assert_eq(current, 0, msg=out.text() + err.text())
  let before = @fs.read_file(generated).text()
  @fs.write_file(
    entry, "declare function receiveBrowserAdapter(value: unknown): void; receiveBrowserAdapter({value: 2});\n",
  )
  let (stale, out, err) = @process.collect_output(
    "moonx",
    [script, "--check"],
    cwd=dir,
  )
  assert_true(stale != 0, msg=out.text() + err.text())
  assert_true((out.text() + err.text()).contains("stale"))
  assert_eq(@fs.read_file(generated).text(), before)
  @fs.write_file(
    entry, "declare function receiveBrowserAdapter(value: unknown): void; receiveBrowserAdapter({pick: () => (globalThis as any).showDirectoryPicker()});\n",
  )
  let (picker, out, err) = @process.collect_output(
    "moonx",
    [script, "--check"],
    cwd=dir,
  )
  assert_true(picker != 0)
  assert_true((out.text() + err.text()).contains("showDirectoryPicker"))
  assert_eq(@fs.read_file(generated).text(), before)
  @fs.write_file(
    entry, "import {readFileSync} from 'node:fs'; declare function receiveBrowserAdapter(value: unknown): void; receiveBrowserAdapter({readFileSync});\n",
  )
  let (forbidden, _, _) = @process.collect_output(
    "moonx",
    [script, "--check"],
    cwd=dir,
  )
  assert_true(forbidden != 0)
  assert_eq(@fs.read_file(generated).text(), before)
}

///|
async test "a fresh consumer build uses checked-in FFI without Bun on PATH" {
  let workspace = @fs.realpath("..")
  let (located, out, err) = @process.collect_output(
    "mise",
    ["where", "http:moonbit"],
    cwd=workspace,
  )
  assert_eq(located, 0, msg=out.text() + err.text())
  let bin = out.text().trim().to_owned() + "/bin"
  let moon = if @fs.exists(bin + "/moon.exe") {
    bin + "/moon.exe"
  } else {
    bin + "/moon"
  }
  assert_false(@fs.exists(bin + "/bun") || @fs.exists(bin + "/bun.exe"))
  let target = @fs.tmpdir(prefix="lander-browser-consumer")
  defer @fs.rmdir(target, recursive=true)
  let (code, out, err) = @process.collect_output(
    moon,
    [
      "run", "--build-only", "--deny-warn", "--target", "js", "--target-dir", target,
      "tests/browser-consumer",
    ],
    cwd=workspace,
    extra_env={ "PATH": bin },
  )
  assert_eq(code, 0, msg=out.text() + err.text())
}
