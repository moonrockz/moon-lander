----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/stdio",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/x@0.5.5/sys",
}
----

///|
/// Test the config, hosting, console and logging runtime adapters on Node and Bun, reusing Moon's compiled test artifacts.
/// Usage: mise run test:node-adapter [-- node|bun].

///|
async fn main {
  let args = @env.args()[1:]
  let runtimes = if args.is_empty() { ["node", "bun"] } else { args.to_owned() }
  let (code, out, err) = @process.collect_output("moon", [
    "run", "--build-only", "--deny-warn", "--target", "js", "tests/config-host-esm",
  ])
  if code != 0 {
    eprintln(out.text() + err.text())
    @sys.exit(1)
  }
  let metadata = @json.parse(out.text())
  guard metadata is { "artifacts_path": [String(path)], .. } else {
    eprintln("Expected one ESM build artifact, got " + out.text())
    @sys.exit(1)
  }
  let dir = @fs.tmpdir(prefix="lander-esm")
  defer @fs.rmdir(dir, recursive=true)
  // A .mjs extension forces ESM even when the main has no exported symbols.
  let esm = "\{dir}/host.mjs"
  @fs.write_file(esm, @fs.read_file(path).text())
  for runtime in runtimes {
    if runtime != "node" && runtime != "bun" {
      eprintln("Expected node or bun, got \{runtime}")
      @sys.exit(1)
    }
    for
      pkg in [
        "pkgs/config/host", "pkgs/hosting", "pkgs/hosting/console", "pkgs/logging-hosting-async/runtime",
        "pkgs/hosting/logging", "tests/hosting-config-acceptance",
      ] {
      println("Testing config and hosting adapters: \{pkg} on \{runtime}")
      let code = @process.run(
        "moon",
        ["test", "--deny-warn", "--target", "js", pkg],
        extra_env={ "MOON_NODE_OVERRIDE": runtime },
        stdout=@stdio.stdout,
        stderr=@stdio.stderr,
      )
      if code != 0 {
        @sys.exit(if code > 0 { code } else { 1 })
      }
    }
    let code = @process.run(
      runtime,
      [esm],
      stdout=@stdio.stdout,
      stderr=@stdio.stderr,
    )
    if code != 0 {
      @sys.exit(if code > 0 { code } else { 1 })
    }
  }
}
