///|
/// Build, check and test the docs site of `apps/site`. The site is written to `_site/`.
///
/// Usage: `mise run build:site [-- --main]`, `mise run check:site` and `mise run test:site`, or
/// `moonx scripts/site.mbtx build [--main]`, `moonx scripts/site.mbtx check` and
/// `moonx scripts/site.mbtx test`.
/// `build` removes `_site/`, then runs the steps of design D6 in order. Each task stops at the first
/// step that fails, prints the name of that step, and exits with a non-zero code. `check` checks the
/// built `_site/`. `test` runs the tests of the site packages and of the TypeScript highlight step.
/// Run it from the workspace root.
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/async@0.22.5/stdio",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/x@0.5.5/sys",
}

///|
let usage : String = "Usage: site.mbtx build [--main] | check | test"

///|
/// The output directory, relative to the workspace root.
let out_dir : String = "_site"

///|
/// The islands bundle that `moon build` writes, relative to the workspace root.
let islands_build : String = "_build/js/release/build/moonrockz/moon-lander-site/islands/islands.js"

///|
/// The directory of the `moon doc` output of the API pages, relative to the workspace root. The
/// output of the module directory `pkgs/notebooks` is in `_build/site-api/pkgs/notebooks/doc/`.
let api_dir : String = "_build/site-api"

///|
/// The step that runs `moon doc` in the module directory `dir`. `moon -C` reads `--target-dir`
/// relative to `dir`, so the target goes up to the workspace root first. Each module has its own
/// target directory, so a later run does not remove the output of an earlier one.
fn api_doc_step(dir : String) -> Step {
  let up = dir.split("/").map(_ => "..").collect().join("/")
  run("moon doc \{dir}", "moon", [
    "-C",
    dir,
    "doc",
    "--target-dir",
    "\{up}/\{api_dir}/\{dir}",
  ])
}

///|
/// The module directories of the `api` key of `site/site.json`. The generator checks the key; a
/// value that is not an array of strings gives no steps here.
fn api_dirs(site_json : String) -> Array[String] {
  let json = @json.parse(site_json) catch { _ => return [] }
  guard json is Object(fields) && fields.get("api") is Some(Array(items)) else {
    return []
  }
  items.filter_map(item => if item is String(dir) { Some(dir) } else { None })
}

///|
/// The bundled islands in the output directory.
let islands_bundle : String = "\{out_dir}/assets/islands.js"

///|
/// The gzip size of the islands bundle that gives a warning (design D13).
let islands_target : Int32 = 25 * 1024

///|
/// The gzip size of the islands bundle that fails the build (design D13).
let islands_limit : Int32 = 27 * 1024

///|
/// What one step does.
enum Action {
  /// Run the command with the arguments.
  Run(String, Array[String])
  /// Check the gzip size of the file against the islands budget.
  GzipBudget(String)
} derive(Eq, Debug)

///|
/// One step of a site task.
struct Step {
  name : String
  action : Action
} derive(Eq, Debug)

///|
fn run(name : String, command : String, args : Array[String]) -> Step {
  { name, action: Run(command, args), }
}

///|
/// The step that installs the npm packages of `apps/site` from `bun.lock`.
let install_step : Step = run("install site dependencies", "bun", [
  "install", "--frozen-lockfile", "--cwd", "apps/site",
])

///|
/// The steps of `build`. `--main` marks a build for the deployed site. `api` holds the module
/// directories of the API pages; `moon doc` runs in each before `generate`.
fn build_steps(
  args : Array[String],
  api~ : Array[String] = [],
) -> Array[Step] raise Failure {
  for arg in args {
    if arg != "--main" {
      raise Failure("unknown option `\{arg}`. \{usage}")
    }
  }
  let generate_args = [
    "run", "--target", "native", "--release", "apps/site/generate", "--", "--root",
    ".", "--out", out_dir,
  ]
  if args.contains("--main") {
    generate_args.push("--main")
  }
  [
    install_step,
    run("build islands", "moon", [
      "build", "--target", "js", "--release", "apps/site/islands",
    ]),
    run("bundle islands", "bun", [
      "build",
      islands_build,
      "--minify",
      "--format",
      "esm",
      "--target",
      "browser",
      "--outdir",
      "\{out_dir}/assets",
    ]),
    { name: "check islands size", action: GzipBudget(islands_bundle), },
    ..api.map(api_doc_step),
    run("generate", "moon", generate_args),
    run("highlight", "bun", ["apps/site/scripts/highlight.ts", out_dir]),
  ]
}

///|
/// The steps of `check`.
fn check_steps(args : Array[String]) -> Array[Step] raise Failure {
  if args is [arg, ..] {
    raise Failure("unknown option `\{arg}`. \{usage}")
  }
  [
    run("check", "moon", [
      "run", "--target", "native", "--release", "apps/site/check", "--", "--root",
      ".", "--dir", out_dir,
    ]),
  ]
}

///|
/// The module name of `apps/site`.
let site_module : String = "moonrockz/moon-lander-site"

///|
/// The full names of the site packages that run on native. `packages` holds the directory name and the
/// `moon.pkg` text of each package below `apps/site`, in order. A package whose `supported_targets` is
/// `"js"` only, such as `islands`, does not run on native.
fn native_packages(packages : Array[(String, String)]) -> Array[String] {
  packages
  .filter(entry => !entry.1.contains("supported_targets = \"js\""))
  .map(entry => "\{site_module}/\{entry.0}")
}

///|
/// Each package below `apps/site`: the directory name and the `moon.pkg` text.
async fn site_packages() -> Array[(String, String)] {
  let found = []
  for name in @fs.readdir("apps/site", sort=true) {
    let pkg = "apps/site/\{name}/moon.pkg"
    if @fs.kind("apps/site/\{name}") is Directory && @fs.exists(pkg) {
      found.push((name, @fs.read_file(pkg).text()))
    }
  }
  found
}

///|
/// The steps of `test` for the native site packages `packages`. The browser test of task 7.2 comes
/// after the highlight test.
fn test_steps(
  args : Array[String],
  packages : Array[String],
) -> Array[Step] raise Failure {
  if args is [arg, ..] {
    raise Failure("unknown option `\{arg}`. \{usage}")
  }
  [
    install_step,
    run(
      "test site packages (native)",
      "moon",
      ["test", "--target", "native", "-p", ..packages],
    ),
    run("test site model (js)", "moon", [
      "test", "--target", "js", "-p", "moonrockz/moon-lander-site/model",
    ]),
    run("test highlight", "node", [
      "--test", "apps/site/scripts/highlight.test.ts",
    ]),
  ]
}

///|
/// The result of the islands size rule.
enum Budget {
  Within
  /// Above the target: the message names the size and the target.
  Warn(String)
  /// Above the limit: the message names the size and the limit.
  Fail(String)
} derive(Eq, Debug)

///|
/// Check the gzip size `size` of `file` against the islands budget: a warning above 25 KB, a failure
/// above 27 KB.
fn islands_budget(file : String, size : Int32) -> Budget {
  if size > islands_limit {
    Fail(
      "\{file} is \{size} bytes gzip, above the 27 KB limit (\{islands_limit} bytes)",
    )
  } else if size > islands_target {
    Warn(
      "\{file} is \{size} bytes gzip, above the 25 KB target (\{islands_target} bytes)",
    )
  } else {
    Within
  }
}

///|
/// The script that prints the gzip size of a file, compressed with zlib as browsers receive it.
/// `moonbitlang/async/gzip` writes larger output than zlib, so its size is not the size that a
/// browser downloads.
let gzip_size_script : String = "apps/site/scripts/gzip-size.ts"

///|
/// The size in bytes that `gzip_size_script` prints, or `None` when the text is not a size.
fn parse_size(text : String) -> Int32? {
  let digits = text.trim()
  if digits == "" || digits.length() > 9 {
    return None
  }
  let mut size = 0
  for c in digits {
    guard c >= '0' && c <= '9' else { return None }
    size = size * 10 + (c.to_int() - '0'.to_int())
  }
  Some(size)
}

///|
/// The gzip size of `file`, from `gzip_size_script` below the workspace root `root`.
async fn gzip_size(file : String, root~ : String = ".") -> Int32 {
  let (code, out) = @process.collect_stdout("bun", [
    "\{root}/\{gzip_size_script}",
    file,
  ])
  let text = out.text()
  guard code == 0 && parse_size(text) is Some(size) else {
    fail("cannot measure the gzip size of \{file}")
  }
  size
}

///|
/// Run one step. Returns 0, or a positive exit code.
async fn run_step(step : Step) -> Int32 {
  match step.action {
    Run(command, args) => {
      let code = @process.run(
        command,
        args,
        stdout=@stdio.stdout,
        stderr=@stdio.stderr,
      ) catch {
        error => {
          eprintln("❌ \{step.name}: \{error}")
          return 1
        }
      }
      if code > 0 {
        code
      } else if code < 0 {
        1
      } else {
        0
      }
    }
    GzipBudget(file) => {
      let size = gzip_size(file) catch {
        error => {
          eprintln("❌ \{step.name}: \{error}")
          return 1
        }
      }
      match islands_budget(file, size) {
        Within => {
          println("\{file} is \{size} bytes gzip")
          0
        }
        Warn(message) => {
          println("warning: \{message}")
          0
        }
        Fail(message) => {
          eprintln("error: \{message}")
          1
        }
      }
    }
  }
}

///|
/// Run `steps` in order and stop at the first failure. Returns 0, or the exit code of the failed step
/// (1 when that code is not positive).
async fn run_steps(steps : Array[Step]) -> Int32 {
  for step in steps {
    println("🔨 \{step.name}")
    let code = run_step(step)
    if code != 0 {
      eprintln("❌ Step failed: \{step.name}")
      return code
    }
  }
  0
}

///|
async fn main {
  let args = @env.args()[1:]
  guard args is [command, .. rest] else {
    eprintln(usage)
    @sys.exit(2)
    return
  }
  let rest = rest.to_owned()
  let (steps, done) = try {
    match command {
      "build" =>
        (
          build_steps(
            rest,
            api=api_dirs(@fs.read_file("site/site.json").text()),
          ),
          "✅ Built \{out_dir}/",
        )
      "check" => (check_steps(rest), "✅ Checked \{out_dir}/")
      "test" =>
        (
          test_steps(rest, native_packages(site_packages())),
          "✅ Site tests passed",
        )
      _ => raise Failure("unknown command `\{command}`. \{usage}")
    }
  } catch {
    Failure(message) => {
      eprintln("❌ \{message}")
      @sys.exit(2)
      return
    }
    error => {
      eprintln("❌ \{error}")
      @sys.exit(1)
      return
    }
  }
  if command == "build" && @fs.exists(out_dir) {
    @fs.rmdir(out_dir, recursive=true)
  }
  let code = run_steps(steps)
  if code != 0 {
    @sys.exit(code)
  }
  println(done)
}

///|
test "build runs the steps of design D6 in order" {
  assert_eq(build_steps([]).map(step => step.name), [
    "install site dependencies", "build islands", "bundle islands", "check islands size",
    "generate", "highlight",
  ])
  assert_eq(build_steps([])[4], {
    name: "generate",
    action: Run("moon", [
      "run", "--target", "native", "--release", "apps/site/generate", "--", "--root",
      ".", "--out", "_site",
    ]),
  })
  assert_eq(build_steps([])[3].action, GzipBudget("_site/assets/islands.js"))
}

///|
test "moon doc runs in each API module before generate" {
  let steps = build_steps([], api=["pkgs/lander", "pkgs/notebooks"])
  assert_eq(steps.map(step => step.name), [
    "install site dependencies", "build islands", "bundle islands", "check islands size",
    "moon doc pkgs/lander", "moon doc pkgs/notebooks", "generate", "highlight",
  ])
  assert_eq(
    steps[5].action,
    Run("moon", [
      "-C", "pkgs/notebooks", "doc", "--target-dir", "../../_build/site-api/pkgs/notebooks",
    ]),
  )
}

///|
test "the api key gives the module directories" {
  assert_eq(api_dirs("{\"api\": [\"pkgs/lander\", \"pkgs/notebooks\"]}"), [
    "pkgs/lander", "pkgs/notebooks",
  ])
  assert_eq(api_dirs("{}"), [])
  assert_eq(api_dirs("not json"), [])
}

///|
test "--main reaches generate" {
  guard build_steps(["--main"])[4].action is Run(_, args) else {
    fail("generate is not a command")
  }
  assert_eq(args[args.length() - 1], "--main")
  guard build_steps([])[4].action is Run(_, args) else {
    fail("generate is not a command")
  }
  assert_false(args.contains("--main"))
}

///|
test "an unknown option fails" {
  let message = try build_steps(["--mian"]) catch {
    Failure(message) => message
  } noraise {
    _ => ""
  }
  assert_eq(message, "unknown option `--mian`. \{usage}")
}

///|
test "check runs the check executable on _site" {
  assert_eq(check_steps([]), [
    {
      name: "check",
      action: Run("moon", [
        "run", "--target", "native", "--release", "apps/site/check", "--", "--root",
        ".", "--dir", "_site",
      ]),
    },
  ])
  let message = try check_steps(["--main"]) catch {
    Failure(message) => message
  } noraise {
    _ => ""
  }
  assert_eq(message, "unknown option `--main`. \{usage}")
}

///|
test "test runs the site package tests and the highlight test" {
  let steps = test_steps([], ["moonrockz/moon-lander-site/model"])
  assert_eq(steps.map(step => step.name), [
    "install site dependencies", "test site packages (native)", "test site model (js)",
    "test highlight",
  ])
  assert_eq(
    steps[1].action,
    Run("moon", [
      "test", "--target", "native", "-p", "moonrockz/moon-lander-site/model",
    ]),
  )
}

///|
test "js-only packages do not run on native" {
  assert_eq(
    native_packages([
      ("check", "supported_targets = \"native\"\n"),
      ("islands", "supported_targets = \"js\"\n"),
      ("model", "import {}\n"),
    ]),
    ["moonrockz/moon-lander-site/check", "moonrockz/moon-lander-site/model"],
  )
}

///|
test "the islands budget warns above 25 KB and fails above 27 KB" {
  assert_eq(islands_budget("a.js", 25 * 1024), Within)
  assert_eq(
    islands_budget("a.js", 25 * 1024 + 1),
    Warn("a.js is 25601 bytes gzip, above the 25 KB target (25600 bytes)"),
  )
  assert_eq(
    islands_budget("a.js", 27 * 1024),
    Warn("a.js is 27648 bytes gzip, above the 25 KB target (25600 bytes)"),
  )
  assert_eq(
    islands_budget("a.js", 28 * 1024),
    Fail("a.js is 28672 bytes gzip, above the 27 KB limit (27648 bytes)"),
  )
}

///|
test "the gzip size script prints a size in bytes" {
  assert_eq(parse_size("22573"), Some(22573))
  assert_eq(parse_size(" 18\n"), Some(18))
  assert_eq(parse_size(""), None)
  assert_eq(parse_size("12 KB"), None)
  assert_eq(parse_size("-1"), None)
}

///|
async test "gzip size is the size of the compressed data" {
  // Script tests run in `scripts/`, one directory below the workspace root.
  let file = "_build/site-gzip-size-test.txt"
  @fs.write_file(file, String::make(10000, 'a'))
  defer @fs.remove(file)
  let size = gzip_size(file, root="..")
  assert_true(size > 18 && size < 1000, msg="size \{size}")
}

///|
async test "a failed step stops the build with a non-zero code" {
  let code = run_steps([
    run("fails", "moon", ["no-such-command"]),
    run("never runs", "moon", ["version"]),
  ])
  assert_true(code != 0)
}

///|
async test "a missing bundle fails the size step" {
  let code = run_steps([
    { name: "size", action: GzipBudget("no-such-dir/islands.js"), },
  ])
  assert_eq(code, 1)
}

///|
async test "steps that pass give 0" {
  assert_eq(run_steps([run("ok", "moon", ["version"])]), 0)
}
