///|
async fn published_moonx(
  tools : StockToolchain,
  stage : String,
  host : String,
) -> Json {
  let version = workspace_version(@fs.read_file("moon.mod").text())
  let home = stage + "/cold-public-moonx-home"
  @fs.mkdir(home)
  let environment = tools.environment.copy()
  environment.set("MOON_HOME", home)
  let moonx = tools.root +
    "/bin/moonx" +
    (if @env.get_env_var("OS") == Some("Windows_NT") { ".exe" } else { "" })
  let package_id = "moonrockz/moon-lander-moonx/launch@" + version
  let (code, output, error) = @process.collect_output(
    moonx,
    [package_id, "--json", "--help"],
    extra_env=environment,
  )
  assert_eq(code, 0, msg=error.text())
  guard @json.parse(output.text()) is { "kind": "help", "exit_status": 0, .. } else {
    fail(output.text())
  }
  let asset = "https://download.mooncakes.io/assets/moonrockz/moon-lander-moonx@" +
    version +
    "/launch/launch.wasm"
  let (response, body) = @http.get(asset + ".sha256")
  assert_eq(response.code, 200)
  let advertised = ApprovedArchiveDigest::parse(body.text().trim().to_owned())
  let (response, body) = @http.get(asset)
  assert_eq(response.code, 200)
  advertised.check(body.binary())
  assert_eq(verify_cached_asset(home, advertised), 1)
  let stops : Array[Json] = []
  let transports = [
    top_finite(tools, stage, home),
    binary_transport(tools, stage, "", moonx_home=Some(home)),
  ]
  if @env.get_env_var("OS") != Some("Windows_NT") {
    for signal in [Interrupt, Terminate] {
      stops.push(
        host_signal(tools, stage, "", host, signal, moonx_home=Some(home)),
      )
    }
    stops.push(
      host_signal(
        tools,
        stage,
        "",
        host,
        Interrupt,
        moonx_home=Some(home),
        repeated=true,
      ),
    )
  }
  {
    "scenario": "stock-moonx-public-registry",
    "defaultRegistry": true,
    "freshHome": true,
    "publicAssetUrl": Json(asset),
    "advertisedAndCachedWasmSha256": Json(advertised.text),
    "transportCases": Json(transports),
    "hostStops": Json(stops),
  }
}

///|
async fn forced_payload(
  tools : StockToolchain,
  stage : String,
  parent : String,
) -> Json {
  let temporary = stage + "/forced-payload"
  @fs.mkdir(temporary)
  let environment = tools.environment.copy()
  for name in ["TMPDIR", "TMP", "TEMP"] {
    environment.set(name, temporary)
  }
  let (stdin, writer) = @process.write_to_process()
  defer writer.close()
  let (reader, stdout) = @process.read_from_process()
  defer reader.close()
  let (errors, stderr) = @process.read_from_process()
  defer errors.close()
  @async.with_timeout(30000, () => {
    @async.with_task_group(group => {
      let child = @process.spawn(
        group,
        stock_program(tools.root, Moonrun),
        [parent, "--", "--payload", "--ignore-signal"],
        stdin~,
        stdout~,
        stderr~,
        extra_env=environment,
      )
      let payload = reader.read_until("\n").unwrap()
      assert_true(payload.has_prefix("PAYLOAD="), msg=payload)
      let ready = reader.read_until("\n").unwrap()
      assert_true(ready.has_prefix("READY "), msg=ready)
      assert_eq(@process.run("kill", ["-INT", child.pid.to_string()]), 0)
      assert_eq(reader.read_until("\n"), Some("IGNORED_INTERRUPT"))
      let output = group.spawn(() => reader.read_all().text())
      let diagnostics = group.spawn(() => errors.read_all().text())
      assert_eq(child.wait(), -2)
      assert_eq(output.wait(), "")
      let diagnostics = diagnostics.wait()
      assert_true(
        diagnostics.contains("PARENT_STARTED=STOPPED:137:FORCED=true"),
        msg=diagnostics,
      )
      assert_true(
        diagnostics.contains("PARENT_SIGNAL=Interrupt"),
        msg=diagnostics,
      )
      assert_true(diagnostics.contains("PARENT_SELECTED=130"), msg=diagnostics)
      assert_eq(diagnostics.split("PARENT_FINALIZER").to_array().length(), 2)
      assert_eq(@fs.readdir(temporary), [])
      let (alive, _, _) = @process.collect_output("kill", [
        "-0",
        ready[6:].to_owned(),
      ])
      assert_true(alive != 0, msg="Forced Node child was not reaped")
      {
        "scenario": "ignored-interrupt-forced-payload",
        "actualChildStatus": 137,
        "forceRequested": true,
        "selected": 130,
        "ownedPayloadRemoved": true,
        "childReaped": true,
        "stdinHeldOpenThroughExit": true,
      }
    })
  })
}

///|
async fn cancelled_materialization(
  tools : StockToolchain,
  stage : String,
  parent : String,
) -> Json {
  let temporary = stage + "/cancelled-materialization"
  @fs.mkdir(temporary)
  let environment = tools.environment.copy()
  for name in ["TMPDIR", "TMP", "TEMP"] {
    environment.set(name, temporary)
  }
  let watcher = @fs.Watcher(
    temporary,
    debounce_timeout=0,
    report_child_event=false,
  )
  defer watcher.close()
  let (stdin, writer) = @process.write_to_process()
  defer writer.close()
  let (reader, stdout) = @process.read_from_process()
  defer reader.close()
  let (errors, stderr) = @process.read_from_process()
  defer errors.close()
  @async.with_timeout(30000, () => {
    @async.with_task_group(group => {
      let child = @process.spawn(
        group,
        stock_program(tools.root, Moonrun),
        [parent, "--", "--payload", "--large-payload"],
        stdin~,
        stdout~,
        stderr~,
        extra_env=environment,
      )
      let output = group.spawn(() => reader.read_all().text())
      let diagnostics = group.spawn(() => errors.read_all().text())
      watcher.wait_any()
      assert_eq(@fs.readdir(temporary).length(), 1)
      assert_eq(@process.run("kill", ["-TERM", child.pid.to_string()]), 0)
      assert_eq(child.wait(), -15)
      assert_eq(output.wait(), "")
      let diagnostics = diagnostics.wait()
      assert_true(
        diagnostics.contains("PARENT_NOT_STARTED=Cancelled:Terminate"),
        msg=diagnostics,
      )
      assert_true(diagnostics.contains("PARENT_SELECTED=143"), msg=diagnostics)
      assert_eq(diagnostics.split("PARENT_FINALIZER").to_array().length(), 2)
      assert_eq(@fs.readdir(temporary), [])
      {
        "scenario": "signal-during-materialization",
        "filesystemCreationAcknowledged": true,
        "notStarted": true,
        "selected": 143,
        "ownedPayloadRemoved": true,
        "stdinHeldOpenThroughExit": true,
      }
    })
  })
}

///|
async fn retain_report(
  tools : StockToolchain,
  results : Array[Json],
  published~ : ApprovedArchiveDigest? = None,
) -> Unit {
  let (node_code, node_version, node_error) = @process.collect_output("node", [
    "--version",
  ])
  assert_eq(node_code, 0, msg=node_error.text())
  let (code, head, error) = @process.collect_output("git", ["rev-parse", "HEAD"])
  assert_eq(code, 0, msg=error.text())
  let (code, dirty, error) = @process.collect_output("git", [
    "status", "--porcelain",
  ])
  assert_eq(code, 0, msg=error.text())
  let report : Json = {
    "schema_version": 1,
    "proof_kind": if published is None {
      "local-candidate"
    } else {
      "cold-public-registry"
    },
    "freshDependencyAndBuildCaches": published is Some(_),
    "approvedArchiveSha256": match published {
      None => Json::null()
      Some(digest) => Json(digest.text)
    },
    "source_commit": head.text().trim().to_owned(),
    "working_tree_dirty": !dirty.text().is_empty(),
    "stock": tools.version.text(),
    "compiler": tools.description,
    "nodeVersion": node_version.text().trim().to_owned(),
    "cases": results,
  }
  @fs.mkdir("_build/moonx", recursive=true, allow_exist=true)
  let path = "_build/moonx/qualification-" +
    (if published is None { "" } else { "published-" }) +
    tools.version.text() +
    ".json"
  @fs.write_file(path, report.stringify(indent=2) + "\n")
  println(report.stringify(indent=2))
}

///|
async fn completion_failure(
  tools : StockToolchain,
  stage : String,
  parent : String,
  success~ : Bool,
) -> Json {
  let temporary = stage + "/callback-payload"
  @fs.mkdir(temporary, allow_exist=true)
  let environment = tools.environment.copy()
  environment.set("MOONX_SILENT_CALLBACK_FAILURE", "1")
  for name in ["TMPDIR", "TMP", "TEMP"] {
    environment.set(name, temporary)
  }
  let (stdin, writer) = @process.write_to_process()
  defer writer.close()
  let (reader, stdout) = @process.read_from_process()
  defer reader.close()
  let (closed_reader, stderr) = @process.read_from_process()
  closed_reader.close()
  @async.with_timeout(30000, () => {
    @async.with_task_group(group => {
      let child = @process.spawn(
        group,
        stock_program(tools.root, Moonrun),
        [parent, "--", "--payload"] + (if success { ["--success"] } else { [] }),
        stdin~,
        stdout~,
        stderr~,
        extra_env=environment,
      )
      let output = group.spawn(() => reader.read_all().text())
      let selected = child.wait()
      assert_eq(selected, if success { 1 } else { 23 })
      assert_true(output.wait().contains("VALUE=42\n"))
      assert_eq(@fs.readdir(temporary), [])
      {
        "stock": tools.version.text(),
        "scenario": "completion-failure-with-closed-stderr",
        "childSucceeded": success,
        "selected": selected,
        "ownedPayloadRemoved": true,
      }
    })
  })
}

///|
async fn main {
  let args = @env.args()[1:].to_owned()
  let published = if args.length() >= 2 &&
    args[args.length() - 2] == "--published-checksum" {
    Some(ApprovedArchiveDigest::parse(args.pop().unwrap()))
  } else {
    None
  }
  if published is Some(_) {
    ignore(args.pop())
  }
  let root = if args.length() == 2 && args[0] == "--toolchain-root" {
    args[1]
  } else if args.is_empty() {
    @env.get_env_var("MOON_TOOLCHAIN_ROOT").unwrap_or("")
  } else {
    fail(
      "Use [--toolchain-root STOCK_INSTALL_ROOT] [--published-checksum APPROVED_SHA256]",
    )
  }
  let tools = StockToolchain::parse(root) catch {
    InvalidConfiguration(input~, rule~) =>
      fail(rule.description() + ": " + input)
    error => raise error
  }
  let stage = @fs.tmpdir(prefix="lander-moonx-acceptance")
  defer @fs.rmdir(stage, recursive=true)
  let stage = @fs.realpath(stage)
  let tools = if published is Some(_) {
    let environment = tools.environment.copy()
    let home = stage + "/cold-public-home"
    @fs.mkdir(home)
    environment.set("MOON_HOME", home)
    environment.set("MOON_DEP_CACHE", stage + "/cold-dependencies")
    environment.set("MOON_BUILD_CACHE", stage + "/cold-build-cache")
    {
      root: tools.root,
      version: tools.version,
      environment,
      description: tools.description,
    }
  } else {
    tools
  }
  let (parent, host, launch) = prepare(tools, stage, published~)
  let results : Array[Json] = []
  results.push(launch_command(tools, stage, launch))
  results.push(binary_transport(tools, stage, launch))
  for success in [true, false] {
    results.push(completion_failure(tools, stage, parent, success~))
  }
  for
    scenario in [
      Finite,
      MissingNode,
      WriteFailure,
      Symlink,
      FinalizerAfterSuccess,
      FinalizerAfterFailure,
    ] {
    results.push(finite_payload(tools, stage, parent, scenario))
  }
  if @env.get_env_var("OS") != Some("Windows_NT") {
    for scenario in [CleanupAfterSuccess, CleanupAfterFailure] {
      results.push(finite_payload(tools, stage, parent, scenario))
    }
    for signal in [Interrupt, Terminate] {
      results.push(host_signal(tools, stage, parent, host, signal))
    }
    results.push(
      host_signal(tools, stage, parent, host, Interrupt, repeated=true),
    )
    results.push(forced_payload(tools, stage, parent))
    results.push(cancelled_materialization(tools, stage, parent))
    if published is None {
      results.push(candidate_moonx(tools, stage, launch, host))
    } else {
      results.push(published_moonx(tools, stage, host))
    }
  } else {
    if published is None {
      results.push(candidate_moonx(tools, stage, launch, host))
    } else {
      results.push(published_moonx(tools, stage, host))
    }
    let controller = windows_controller(tools, stage)
    let failures : Array[String] = []
    for
      scenario in [
        BaselineInterrupt,
        BaselineBreak,
        LauncherForcedBreak,
        LauncherBreak,
        LauncherInterrupt,
      ] {
      try
        windows_console(tools, stage, parent, host, controller, scenario)
      catch {
        error => {
          let detail = scenario.name() + ": " + error.to_string()
          failures.push(detail)
          results.push({
            "stock": tools.version.text(),
            "scenario": scenario.name(),
            "failed": detail,
          })
        }
      } noraise {
        result => results.push(result)
      }
    }
    if !failures.is_empty() {
      retain_report(tools, results, published~)
      fail("Windows console qualification failed: " + failures.join("\n"))
    }
  }
  retain_report(tools, results, published~)
}

///|
test "Node fixture paths preserve ordinary Windows and Unicode spellings" {
  assert_eq(
    node_fixture_path("/tmp/é🙂/host.js", windows=false),
    "/tmp/é🙂/host.js",
  )
  assert_eq(
    node_fixture_path("C:/é🙂/host.js", windows=true),
    "C:\\é🙂\\host.js",
  )
  assert_eq(
    node_fixture_path("\\\\?\\C:\\é🙂\\host.js", windows=true),
    "C:\\é🙂\\host.js",
  )
  assert_eq(
    node_fixture_path("\\\\?\\UNC\\server\\share\\host.js", windows=true),
    "\\\\server\\share\\host.js",
  )
  assert_eq(node_fixture_path("C:\\host.js", windows=true), "C:\\host.js")
}

///|
test "approved archive digest requires exact lower-case SHA256" {
  let text = "a".repeat(64)
  assert_eq(ApprovedArchiveDigest::parse(text).text, text)
  ApprovedArchiveDigest::parse(
    @crypto.bytes_to_hex_string(@crypto.sha256(b"archive")),
  ).check(b"archive")
  for
    input in [
      "",
      "a".repeat(63),
      "a".repeat(65),
      "A".repeat(64),
      "g".repeat(64),
      " " + text,
    ] {
    try ApprovedArchiveDigest::parse(input) catch {
      InvalidArchiveDigest(actual) => assert_eq(actual, input)
    } noraise {
      _ => fail("Accepted malformed archive digest")
    }
  }
}

///|
test "stock identity requires matching compiler frontend and Moonrun" {
  let stock16 = "moon 0.1.20261020 (2284bd2 2026-10-20) /stock/bin/moon\nmoonc v0.10.16+b1a0e846e (2026-10-16) /stock/bin/moonc\nmoonrun 0.1.20261020 (2284bd2 2026-10-20) /stock/bin/moonrun\n"
  let stock17 = "moon 0.1.20261023 (3778465 2026-10-23) /stock/bin/moon\nmoonc v0.10.17+d971670cd (2026-10-23) /stock/bin/moonc\nmoonrun 0.1.20261023 (3778465 2026-10-23) /stock/bin/moonrun\n"
  assert_true(StockVersion::parse_description(stock16) is Stock16)
  assert_true(StockVersion::parse_description(stock17) is Stock17)
  for
    input in [
      "",
      stock16.replace_all(old="2284bd2", new="3778465"),
      stock16.replace_all(old=Stock16.text(), new=Stock17.text()),
      stock17 + stock16,
      "moonc v0.10.17+d971670cd\n",
    ] {
    try StockVersion::parse_description(input) catch {
      InvalidConfiguration(input=actual, rule=UnsupportedStock) =>
        assert_eq(actual, input)
      _ => fail("Expected unsupported stock identity")
    } noraise {
      _ => fail("Accepted mixed or incomplete toolchain identity")
    }
  }
}

///|
async test "stock root rejects invalid input before filesystem work" {
  try StockToolchain::parse("") catch {
    InvalidConfiguration(input="", rule=MissingRoot) => ()
    _ => fail("Expected missing root")
  } noraise {
    _ => fail("Accepted empty stock root")
  }
  try StockToolchain::parse("a\u{0}b") catch {
    InvalidConfiguration(input="a\u{0}b", rule=ContainsNul) => ()
    _ => fail("Expected NUL rule")
  } noraise {
    _ => fail("Accepted NUL stock root")
  }
}
