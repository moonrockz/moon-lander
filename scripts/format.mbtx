----
import {
  "moonbitlang/async@0.22.7",
  "moonbitlang/async@0.22.7/process",
  "moonbitlang/async@0.22.7/fs",
  "moonbitlang/async@0.22.7/stdio",
  "moonbitlang/x@0.5.6/sys",
}
----

///|
/// Format all MoonBit code in the workspace.
///
/// Usage: `mise run format`, or `moonx scripts/toolchain.mbtx scripts/format.mbtx`.

///|
async fn main {
  println("🎨 Formatting MoonBit code...")
  // A path selects only its own package: `moon fmt .` formats the workspace root package and
  // skips the members. So the packages get a call with no path, and the scripts a second call.
  let scripts = []
  for file in @fs.readdir("scripts", sort=true) {
    if file.has_suffix(".mbtx") {
      scripts.push("scripts/\{file}")
    }
  }
  for args in [["fmt"], ["fmt", ..scripts]] {
    let code = @process.run(
      "moon",
      args,
      stdout=@stdio.stdout,
      stderr=@stdio.stderr,
    )
    if code != 0 {
      @sys.exit(if code > 0 { code } else { 1 })
    }
  }
  println("✅ Formatting complete")
}
