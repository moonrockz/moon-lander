///|
/// Write the mooncakes.io credentials from `MOONCAKES_USER_TOKEN` to
/// `$MOON_HOME/credentials.json`, or `~/.moon/credentials.json` (CI only).
/// Adapted from Smithy's release flow. Exits nonzero when the token is
/// missing or empty.
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/x@0.5.5/sys",
  "moonbitlang/core/env",
}

///|
let token_var : String = "MOONCAKES_USER_TOKEN"

///|
fn require_token(value : String?) -> Result[String, String] {
  match value {
    Some(token) if token != "" => Ok(token)
    _ => Err("\{token_var} is not set; cannot write mooncakes.io credentials")
  }
}

///|
fn credentials_json(token : String) -> String {
  let json : Json = { "token": Json::string(token) }
  json.stringify(indent=2) + "\n"
}

///|
fn credentials_dir(
  moon_home : String?,
  home : String?,
) -> Result[String, String] {
  match (moon_home, home) {
    (Some(dir), _) if dir != "" => Ok(dir)
    (_, Some(home)) if home != "" => Ok("\{home}/.moon")
    _ =>
      Err("neither MOON_HOME nor HOME is set; cannot locate the moon directory")
  }
}

///|
async fn main {
  let token = match require_token(@env.get_env_var(token_var)) {
    Ok(token) => token
    Err(message) => {
      eprintln("❌ \{message}")
      @sys.exit(1)
      return
    }
  }
  let dir = match
    credentials_dir(@env.get_env_var("MOON_HOME"), @env.get_env_var("HOME")) {
    Ok(dir) => dir
    Err(message) => {
      eprintln("❌ \{message}")
      @sys.exit(1)
      return
    }
  }
  @fs.mkdir(dir, recursive=true, allow_exist=true)
  @fs.write_file(
    "\{dir}/credentials.json",
    credentials_json(token),
    permission=0o600,
  )
  println("Credentials written to \{dir}/credentials.json")
}

///|
test "credentials need a token and a directory" {
  assert_true(require_token(None) is Err(_))
  assert_true(require_token(Some("")) is Err(_))
  assert_eq(require_token(Some("t")), Ok("t"))
  assert_eq(credentials_json("a\"b"), "{\n  \"token\": \"a\\\"b\"\n}\n")
  assert_eq(credentials_dir(Some("/m"), Some("/h")), Ok("/m"))
  assert_eq(credentials_dir(Some(""), Some("/h")), Ok("/h/.moon"))
  assert_true(credentials_dir(None, None) is Err(_))
}
