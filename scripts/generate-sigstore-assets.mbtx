----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "moonbitlang/x@0.5.6/crypto",
}
----

///|
/// Generate MoonBit constants from `pkgs/sigstore/testdata/`: the pinned
/// Sigstore public-good trusted root, and the test fixtures, because wasm and
/// wasm-gc tests cannot read files. Each source must match its digest in
/// `testdata/SHA256SUMS`, which is also the list of files. `--check` rejects
/// stale output without rewriting it.
///
/// Usage: `mise run build:sigstore-assets`, `mise run check:sigstore-assets`,
/// or `moonx scripts/toolchain.mbtx scripts/generate-sigstore-assets.mbtx [--check]`.

///|
let testdata : String = "pkgs/sigstore/testdata"

///|
let public_good_source : String = "public-good/trusted_root.json"

///|
let public_good_output : String = "pkgs/sigstore/public_good.generated.mbt"

///|
/// The fixture groups: the folder under `testdata/` and the generated file.
let fixture_groups : Array[(String, String)] = [
  ("github", "pkgs/sigstore/internal/fixtures/github.generated.mbt"),
  ("conformance", "pkgs/sigstore/internal/fixtures/conformance.generated.mbt"),
  ("wycheproof", "pkgs/sigstore/internal/fixtures/wycheproof.generated.mbt"),
]

///|
/// Files that document the test data and are not fixtures.
let documents : Array[String] = ["README", "README.md", "LICENSE", "NOTICE"]

///|
/// The path and digest of each line of a `shasum -a 256` manifest.
fn manifest_entries(manifest : String) -> Array[(String, String)] raise {
  let entries = []
  for line in manifest.split("\n") {
    if line.length() == 0 {
      continue
    }
    guard line.length() > 66 && line[64:66] == "  " else {
      fail("Bad SHA256SUMS line: \{line}")
    }
    entries.push((line[66:].to_owned(), line[:64].to_owned()))
  }
  entries
}

///|
/// The longest source line that a chunk literal may take, well below the
/// column limit of the compiler.
let chunk_width : Int32 = 2000

///|
fn escape(char : Char) -> String {
  match char {
    '\\' => "\\\\"
    '"' => "\\\""
    '\n' => "\\n"
    '\r' => "\\r"
    '\t' => "\\t"
    _ =>
      if char.to_int() < 0x20 {
        "\\u{\{char.to_int().to_string(radix=16)}}"
      } else {
        char.to_string()
      }
  }
}

///|
/// MoonBit string literals that join to exactly `text`, each short enough for
/// one source line.
fn literals(text : String) -> Array[String] {
  let chunks = []
  let out = StringBuilder()
  out.write_char('"')
  let mut width = 1
  for char in text {
    let piece = escape(char)
    if width + piece.length() > chunk_width {
      out.write_char('"')
      chunks.push(out.to_string())
      out.reset()
      out.write_char('"')
      width = 1
    }
    out.write_string(piece)
    width += piece.length()
  }
  out.write_char('"')
  chunks.push(out.to_string())
  chunks
}

///|
/// A MoonBit expression whose value is exactly `text`, indented by `indent`.
fn expression(text : String, indent : String) -> String {
  let chunks = literals(text)
  if chunks.length() == 1 {
    return chunks[0]
  }
  let out = StringBuilder()
  out.write_string("[\n")
  for chunk in chunks {
    out.write_string("\{indent}  \{chunk},\n")
  }
  out.write_string("\{indent}].join(\"\")")
  out.to_string()
}

///|
fn render_public_good(digest : String, text : String) -> String {
  (
    $|// Generated by scripts/generate-sigstore-assets.mbtx. Do not edit.
    $|// Source: sigstore/root-signing targets/trusted_root.json, see testdata/README.md.
    $|
    $|///|
    $|/// The pinned Sigstore public-good `trusted_root.json`.
    $|/// SHA-256 \{digest}
    $|let public_good_document : String = \{expression(text, "")}
    $|
  )
}

///|
fn render_group(
  name : String,
  files : Array[(String, String, String)],
) -> String {
  let out = StringBuilder()
  out.write_string(
    (
      $|// Generated by scripts/generate-sigstore-assets.mbtx. Do not edit.
      $|// Source: pkgs/sigstore/testdata/\{name}/, see testdata/README.md.
      $|
      $|///|
      $|/// The files of `testdata/\{name}/`: the path in that folder and the text.
      $|pub let \{name} : Array[(String, String)] = [
      $|
    ),
  )
  for file in files {
    let (path, digest, text) = file
    out.write_string(
      "  // SHA-256 \{digest}\n  (\{expression(path, "  ")}, \{expression(text, "  ")}),\n",
    )
  }
  out.write_string("]\n")
  out.to_string()
}

///|
/// Read a source, check its digest and require UTF-8 text.
async fn read_source(path : String, digest : String) -> String {
  let bytes = @fs.read_file("\{testdata}/\{path}").binary()
  guard @crypto.bytes_to_hex_string(@crypto.sha256(bytes)) == digest else {
    fail("Digest mismatch: testdata/\{path}")
  }
  let text = @utf8.decode(bytes) catch {
    _ => fail("Not UTF-8 text: testdata/\{path}")
  }
  text
}

///|
/// The generated outputs: each path with its text.
async fn generate() -> Array[(String, String)] {
  let entries = manifest_entries(@fs.read_file("\{testdata}/SHA256SUMS").text())
  let outputs = []
  guard entries.search_by(entry => entry.0 == public_good_source) is Some(index) else {
    fail("SHA256SUMS does not list \{public_good_source}")
  }
  let (_, root_digest) = entries[index]
  outputs.push(
    (
      public_good_output,
      render_public_good(
        root_digest,
        read_source(public_good_source, root_digest),
      ),
    ),
  )
  for group in fixture_groups {
    let (name, output) = group
    let files = []
    for entry in entries {
      let (path, digest) = entry
      guard path.has_prefix("\{name}/") else { continue }
      let base = match path.rev_find("/") {
        Some(at) => path[at + 1:].to_owned()
        None => path
      }
      if documents.contains(base) {
        continue
      }
      files.push(
        (path[name.length() + 1:].to_owned(), digest, read_source(path, digest)),
      )
    }
    guard !files.is_empty() else { fail("No fixtures in testdata/\{name}") }
    outputs.push((output, render_group(name, files)))
  }
  outputs
}

///|
async fn main {
  let outputs = generate()
  if @env.args().contains("--check") {
    for output in outputs {
      let (path, text) = output
      guard @fs.exists(path) && @fs.read_file(path).text() == text else {
        fail("\{path} is stale. Run mise run build:sigstore-assets.")
      }
    }
    println("Sigstore assets are current.")
  } else {
    for output in outputs {
      let (path, text) = output
      @fs.write_file(path, text)
    }
    println("Generated \{outputs.length()} Sigstore asset files.")
  }
}

///|
test "literals keep every character and stay short" {
  assert_eq(literals("a\"b\\c\n\t\r\u{1}é{"), [
    "\"a\\\"b\\\\c\\n\\t\\r\\u{1}é{\"",
  ])
  let long = literals("x".repeat(5000))
  assert_eq(long.length(), 3)
  assert_true(long.iter().all(chunk => chunk.length() <= chunk_width + 1))
  assert_eq(expression("ab", "  "), "\"ab\"")
}

///|
test "manifest lines give a path and a digest" {
  let digest = "0".repeat(64)
  assert_eq(manifest_entries("\{digest}  a/b.json\n"), [("a/b.json", digest)])
  let failed = try {
    ignore(manifest_entries("bad line\n"))
    false
  } catch {
    _ => true
  }
  assert_true(failed)
}

///|
async test "asset freshness rejects missing, changed and altered input" {
  let script = @fs.realpath("generate-sigstore-assets.mbtx")
  let temporary = @fs.tmpdir(prefix="sigstore-asset-check")
  defer @fs.rmdir(temporary, recursive=true)
  let source = "../\{testdata}"
  let copy = "\{temporary}/\{testdata}"
  let manifest = @fs.read_file("\{source}/SHA256SUMS").text()
  @fs.mkdir("\{temporary}/pkgs/sigstore/internal/fixtures", recursive=true)
  @fs.mkdir(copy, recursive=true)
  @fs.write_file("\{copy}/SHA256SUMS", manifest)
  for entry in manifest_entries(manifest) {
    let (path, _) = entry
    if path.rev_find("/") is Some(at) && !@fs.exists("\{copy}/\{path[:at]}") {
      @fs.mkdir("\{copy}/\{path[:at]}", recursive=true)
    }
    @fs.write_file("\{copy}/\{path}", @fs.read_file("\{source}/\{path}"))
  }
  let run = async fn(args : Array[String]) -> (Int32, String) {
    let (code, out, err) = @process.collect_output(
      "moonx",
      [script, ..args],
      cwd=temporary,
    )
    (code, out.text() + err.text())
  }
  let (missing, output) = run(["--check"])
  assert_true(missing != 0, msg=output)
  let (built, output) = run([])
  assert_eq(built, 0, msg=output)
  let (fresh, output) = run(["--check"])
  assert_eq(fresh, 0, msg=output)
  for file in [public_good_output, fixture_groups[0].1] {
    let output_path = "\{temporary}/\{file}"
    let original = @fs.read_file(output_path).text()
    @fs.write_file(output_path, original + "\n")
    let (changed, output) = run(["--check"])
    assert_true(changed != 0, msg=file)
    assert_true(output.contains("is stale"), msg=output)
    @fs.write_file(output_path, original)
  }
  let fixture = "\{copy}/github/cases.json"
  @fs.write_file(fixture, @fs.read_file(fixture).text() + " ")
  let (tampered, output) = run(["--check"])
  assert_true(tampered != 0, msg=output)
  assert_true(
    output.contains("Digest mismatch: testdata/github/cases.json"),
    msg=output,
  )
}
