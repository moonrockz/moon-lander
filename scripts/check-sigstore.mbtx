----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
  "moonbitlang/x@0.5.6/sys",
}
----

///|
/// Fail when a target leg of the sigstore tests runs zero tests.
///
/// `moon test` exits with 0 when a package has no test entry for a target. The design of
/// add-sigstore-verification (TST-1) says that such a leg MUST NOT count as a pass, so this check
/// runs the root package and each internal package of `moonrockz/sigstore` for each target and
/// requires a test count above zero. It follows `scripts/check-actors.mbtx`.
///
/// Usage: `mise run check:sigstore [-- <target>...]`, or `moonx scripts/toolchain.mbtx scripts/check-sigstore.mbtx`.
/// With no target, it checks wasm, wasm-gc, js and native.

///|
let all_targets : Array[String] = ["wasm", "wasm-gc", "js", "native"]

///|
/// The sigstore packages, relative to the workspace root: the root package with the public API,
/// the conformance cases and the real GitHub bundles, and each internal package. Each supports all
/// four targets. `internal/fixtures` holds only generated test data and has no tests.
let paths : Array[String] = [
  "pkgs/sigstore", "pkgs/sigstore/internal/der", "pkgs/sigstore/internal/encoding",
  "pkgs/sigstore/internal/signature", "pkgs/sigstore/internal/x509", "pkgs/sigstore/internal/tlog",
  "pkgs/sigstore/internal/sct", "pkgs/sigstore/internal/timestamp",
]

///|
/// The `(path, target)` legs to run for `targets`, target by target, in path order.
fn legs(targets : Array[String]) -> Array[(String, String)] {
  let result = []
  for target in targets {
    for path in paths {
      result.push((path, target))
    }
  }
  result
}

///|
/// The targets in `targets` that are not wasm, wasm-gc, js or native. A misspelled target would
/// give zero legs, and zero legs must not count as a pass.
fn unknown_targets(targets : Array[String]) -> Array[String] {
  targets.filter(target => !all_targets.contains(target))
}

///|
/// The count of the last `Total tests: N, ...` line in the output of `moon test`, or `None` when
/// the output has no such line.
fn test_count(output : String) -> Int32? {
  let mut count = None
  for line in output.split("\n") {
    let line = line.trim(chars=" \t\r")
    guard line.strip_prefix("Total tests: ") is Some(rest) else { continue }
    guard rest.split(",").next() is Some(number) else { continue }
    count = Some(@string.parse_int(number) catch { _ => continue })
  }
  count
}

///|
async fn main {
  let targets = @env.args()[1:].filter(arg => !arg.has_prefix("--"))
  let targets = if targets.is_empty() { all_targets } else { targets }
  let unknown = unknown_targets(targets)
  guard unknown.is_empty() else {
    println(
      "❌ Unknown target: \{unknown.join(", ")}. Use wasm, wasm-gc, js or native.",
    )
    @sys.exit(1)
  }
  for leg in legs(targets) {
    let (path, target) = leg
    let (code, out, err) = @process.collect_output("moon", [
      "test", "--deny-warn", "--target", target, path,
    ])
    let output = out.text() + err.text()
    guard code == 0 else {
      println(output)
      println("❌ The sigstore tests failed: \{path} on \{target}")
      @sys.exit(if code > 0 { code } else { 1 })
    }
    match test_count(output) {
      Some(count) if count > 0 =>
        println("✅ \{path} on \{target}: \{count} tests")
      Some(_) | None => {
        println(output)
        println("❌ \{path} on \{target} ran zero tests")
        @sys.exit(1)
      }
    }
  }
}

///|
test "legs give each sigstore package on each target" {
  assert_eq(legs(all_targets).length(), 32)
  assert_false(paths.contains("pkgs/sigstore/internal/fixtures"))
  assert_eq(legs(["wasm-gc"]), [
    ("pkgs/sigstore", "wasm-gc"),
    ("pkgs/sigstore/internal/der", "wasm-gc"),
    ("pkgs/sigstore/internal/encoding", "wasm-gc"),
    ("pkgs/sigstore/internal/signature", "wasm-gc"),
    ("pkgs/sigstore/internal/x509", "wasm-gc"),
    ("pkgs/sigstore/internal/tlog", "wasm-gc"),
    ("pkgs/sigstore/internal/sct", "wasm-gc"),
    ("pkgs/sigstore/internal/timestamp", "wasm-gc"),
  ])
}

///|
test "unknown_targets names each target that is not known" {
  assert_eq(unknown_targets(all_targets), [])
  assert_eq(unknown_targets(["native", "natve", "wasm-gcc"]), [
    "natve", "wasm-gcc",
  ])
}

///|
test "test_count reads the last total line" {
  assert_eq(
    test_count(
      "Total tests: 2, passed: 2, failed: 0.\r\nTotal tests: 7, passed: 7, failed: 0.\r\n",
    ),
    Some(7),
  )
  assert_eq(
    test_count(
      "Warning: no test entry found.\nTotal tests: 0, passed: 0, failed: 0.\n",
    ),
    Some(0),
  )
  assert_eq(test_count("Finished. moon: no work to do\n"), None)
}

///|
async test "a leg that runs zero tests fails the check" {
  let script = @fs.realpath("check-sigstore.mbtx")
  let dir = @fs.tmpdir(prefix="lander-sigstore")
  defer @fs.rmdir(dir, recursive=true)
  @fs.write_file(
    "\{dir}/moon.mod",
    "name = \"fixture/root\"\nprivate = true\nversion = \"0.0.1\"\n",
  )
  let last = paths[paths.length() - 1]
  for path in paths {
    @fs.mkdir("\{dir}/\{path}", recursive=true)
    @fs.write_file("\{dir}/\{path}/moon.pkg", "")
    guard path != last else { continue }
    @fs.write_file(
      "\{dir}/\{path}/one_test.mbt",
      "///|\ntest \"one\" {\n  assert_eq(1, 1)\n}\n",
    )
  }
  @fs.write_file(
    "\{dir}/\{last}/core.mbt",
    "///|\npub fn answer() -> Int {\n  42\n}\n",
  )
  let (code, out, err) = @process.collect_output(
    "moonx",
    [script, "wasm"],
    cwd=dir,
  )
  let output = out.text() + err.text()
  assert_true(code != 0, msg=output)
  assert_true(output.contains("\{last} on wasm ran zero tests"), msg=output)
  @fs.write_file(
    "\{dir}/\{last}/core_test.mbt",
    "///|\ntest \"one\" {\n  assert_eq(1, 1)\n}\n",
  )
  let (code, out, err) = @process.collect_output(
    "moonx",
    [script, "wasm"],
    cwd=dir,
  )
  let output = out.text() + err.text()
  assert_eq(code, 0, msg=output)
  assert_true(output.contains("\{last} on wasm: 1 tests"), msg=output)
}
