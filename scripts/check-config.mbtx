----
import {
  "moonbitlang/async@0.22.7",
  "moonbitlang/async@0.22.7/process",
  "moonbitlang/async@0.22.7/fs",
  "moonbitlang/core/string",
}
----

///|
/// Compare complete core/profile observations across targets, require nonzero
/// profile coverage, and exercise real native and js profile files.

///|
async fn main {
  let expected = @fs.read_file("tests/config-fixture/expected.txt")
    .text()
    .replace_all(old="\r\n", new="\n")
  let mut profile_observation : String? = None
  for target in ["wasm", "wasm-gc", "js", "native"] {
    let (code, out, err) = @process.collect_output("moon", [
      "test", "--deny-warn", "--target", target, "pkgs/config", "pkgs/config/parsers/toml",
      "pkgs/config/parsers/yaml", "pkgs/config/parsers/json5", "pkgs/config/parsers/ion",
      "tests/config-acceptance",
    ])
    guard code == 0 else { fail(out.text() + err.text()) }
    let (code, out, err) = @process.collect_output("moon", [
      "run", "--release", "--deny-warn", "--target", target, "tests/config-parity",
    ])
    guard code == 0 else { fail(out.text() + err.text()) }
    let observation = out.text().replace_all(old="\r\n", new="\n")
    guard !observation.is_empty() else {
      fail("Empty configuration observation")
    }
    guard observation == expected else {
      fail("Values, provenance or reports differ on \{target}:\n\{observation}")
    }
    for
      suite in [
        "pkgs/config/profiles", "pkgs/config/conventions/profiles_test.mbt", "tests/config-profiles",
      ] {
      let (code, out, err) = @process.collect_output("moon", [
        "test", "--deny-warn", "--target", target, suite,
      ])
      guard code == 0 else { fail(out.text() + err.text()) }
      guard positive_test_count(out.text() + err.text()) else {
        fail("No profile coverage: \{suite} on \{target}")
      }
    }
    if target == "native" || target == "js" {
      for
        suite in [
          "pkgs/config/host/profiles_wbtest.mbt", "tests/hosting-config-acceptance/profiles_wbtest.mbt",
        ] {
        let (code, out, err) = @process.collect_output("moon", [
          "test", "--deny-warn", "--target", target, suite,
        ])
        guard code == 0 else { fail(out.text() + err.text()) }
        guard positive_test_count(out.text() + err.text()) else {
          fail("No host profile coverage: \{suite} on \{target}")
        }
      }
    }
    let (code, out, err) = @process.collect_output("moon", [
      "run", "--release", "--deny-warn", "--target", target, "tests/config-profiles-parity",
    ])
    guard code == 0 else { fail(out.text() + err.text()) }
    let observation = out.text().replace_all(old="\r\n", new="\n")
    guard !observation.is_empty() else { fail("Empty profile observation") }
    match profile_observation {
      None => profile_observation = Some(observation)
      Some(expected) => {
        guard observation == expected else {
          fail(
            "Profile values, provenance, reports or resolution differ on \{target}",
          )
        }
      }
    }
    println(
      "Core and profile acceptance and complete observations agree: \{target}",
    )
  }
}

///|
fn positive_test_count(output : String) -> Bool {
  for line in output.split("\n") {
    if line.trim().strip_prefix("Total tests: ") is Some(rest) {
      if rest.split(",").next() is Some(number) {
        if (@string.parse_int(number) catch { _ => 0 }) > 0 {
          return true
        }
      }
    }
  }
  false
}

///|
test "profile coverage requires an actual nonzero test summary" {
  assert_true(
    positive_test_count("Total tests: 12, passed: 12, failed: 0. [wasm]"),
  )
  assert_false(positive_test_count("Total tests: 0, passed: 0, failed: 0."))
  assert_false(positive_test_count("Finished. no work"))
}
