----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/core/env",
}
----

///|
/// Publish the public modules to mooncakes.io (CI only), in dependency order.
/// A version mooncakes.io already holds counts as published, so a re-run of
/// the same release succeeds. Adapted from Smithy's release flow. Needs the
/// credentials that `scripts/credentials.mbtx` writes.
///
/// Usage: `mise run release:publish`, or `moonx scripts/toolchain.mbtx scripts/publish.mbtx`.

///|
/// Public modules in dependency order. This is the publication allowlist.
/// All other workspace modules must be private.
let publish_list : Array[(String, String)] = [
  ("pkgs/core", "moonrockz/moon-lander-core"),
  ("pkgs/logging", "moonrockz/moon-lander-logging"),
  ("pkgs/config", "moonrockz/moon-lander-config"),
  ("pkgs/mediator", "moonrockz/moon-lander-mediator"),
  ("pkgs/logging-hosting-async", "moonrockz/moon-lander-logging-hosting-async"),
  ("pkgs/actors", "moonrockz/moon-lander-actors"),
  ("pkgs/hosting", "moonrockz/moon-lander-hosting"),
  ("pkgs/lander", "moonrockz/moon-lander"),
  ("pkgs/notebooks", "moonrockz/notebooks"),
  ("pkgs/openrpc", "moonrockz/openrpc"),
]

///|
let duplicated : String = "is duplicated with an existing version"

///|
priv enum Outcome {
  Published
  AlreadyPublished
  Transient
  Failed
} derive(Eq, Debug)

///|
/// A refusal (401, 403) or conflict (409) is never retried.
fn is_transient(exit_code : Int32, output : String) -> Bool {
  if exit_code == 0 {
    return false
  }
  let text = output.to_lower()
  if ["401", "403", "409"].any(word => text.contains(word)) {
    return false
  }
  [
    "timed out", "timeout", "connection reset", "connection refused", "temporary failure",
    "eof", "502", "503", "504", "rate limit",
  ].any(word => text.contains(word))
}

///|
fn classify(exit_code : Int32, output : String) -> Outcome {
  if exit_code == 0 {
    Published
  } else if output.contains(duplicated) {
    AlreadyPublished
  } else if is_transient(exit_code, output) {
    Transient
  } else {
    Failed
  }
}

///|
async fn output_in(
  dir : String,
  cmd : String,
  args : Array[String],
) -> (Int32, String) {
  let (code, out, err) = @process.collect_output(cmd, args, cwd=dir) catch {
    _ => return (1, "cannot start \{cmd}")
  }
  (code, out.text() + err.text())
}

///|
/// Retry a transient failure after 5, 20 and 60 seconds.
async fn with_retry(
  label : String,
  action : async () -> (Int32, String),
) -> (Int32, String) {
  let mut result = action()
  for i, wait in [5000, 20000, 60000] {
    if !is_transient(result.0, result.1) {
      break
    }
    eprintln("↻ \{label}: attempt \{i + 2}/4")
    @async.sleep(wait)
    result = action()
  }
  result
}

///|
fn field(manifest : String, key : String) -> String? {
  for line in manifest.split("\n") {
    if line.trim().has_prefix(key + " = ") {
      return Some(
        line
        .trim()
        .to_owned()
        .replace_all(old=key + " = ", new="")
        .replace_all(old="\"", new=""),
      )
    }
  }
  None
}

///|
/// Reject a missing member, a renamed library, private libraries, public tools,
/// and sibling dependencies that are unpinned, local or out of order.
async fn check_policy() -> Unit {
  let version = field(@fs.read_file("moon.mod").text(), "version").unwrap()
  let work = @fs.read_file("moon.work").text()
  let active = ["."]
  for line in work.split("\n") {
    let parts = line.trim().split("\"").collect()
    if parts.length() >= 3 && parts[0].is_empty() {
      let path = parts[1].to_owned()
      active.push(
        if path.has_prefix("./") {
          path[2:].to_owned()
        } else {
          path
        },
      )
    }
  }
  for path in active {
    let manifest = @fs.read_file("\{path}/moon.mod").text()
    let entry = publish_list.search_by(entry => entry.0 == path)
    if entry is Some(i) {
      guard field(manifest, "name") == Some(publish_list[i].1) &&
        field(manifest, "private") != Some("true") else {
        fail("Publication policy: wrong name or private library at \{path}")
      }
      for j, (_, sibling) in publish_list {
        if j == i {
          continue
        }
        if manifest.contains("\"\{sibling}@") {
          guard manifest.contains("\"\{sibling}@\{version}\"") && j < i else {
            fail(
              "Publication policy: unpinned or out-of-order sibling \{sibling} in \{path}",
            )
          }
        } else if manifest.contains("\"\{sibling}\"") {
          fail("Publication policy: unversioned sibling \{sibling} in \{path}")
        }
      }
      guard !manifest.contains("path:") && !manifest.contains("path =") else {
        fail("Publication policy: local dependency in \{path}")
      }
    } else {
      guard field(manifest, "private") == Some("true") else {
        fail("Publication policy: \{path} must be private")
      }
    }
  }
  for (path, _) in publish_list {
    guard active.contains(path) else {
      fail("Publication policy: missing member \{path}")
    }
  }
}

///|
async fn main {
  let args = @env.args()[1:]
  guard args is [] || args is ["--check"] || args is ["--list"] else {
    fail("Usage: publish.mbtx [--check | --list]")
  }
  check_policy()
  if @env.args().contains("--list") {
    for (path, name) in publish_list {
      println("\{path} \{name}")
    }
    return
  }
  if @env.args().contains("--check") {
    println(
      "Publication policy verified: ten libraries; all tooling and tests private",
    )
    return
  }
  guard @env.get_env_var("GITHUB_ACTIONS") == Some("true") &&
    @env.get_env_var("GITHUB_WORKFLOW") == Some("Release") &&
    @env.get_env_var("GITHUB_EVENT_NAME") != Some("pull_request") else {
    fail("Publication is permitted only in the GitHub Actions Release workflow")
  }
  for (dir, name) in publish_list {
    let (update, update_out) = with_retry("update \{name}", () => {
      output_in(dir, "moon", ["update"])
    })
    guard update == 0 else {
      fail("\{name}: moon update failed\n\{update_out}")
    }
    let (code, out) = with_retry("publish \{name}", () => {
      output_in(dir, "moon", ["publish"])
    })
    match classify(code, out) {
      Published => println("✅ \{name}: published")
      AlreadyPublished =>
        println(
          "\{name}: already exists; the public checksum gate must verify its identity",
        )
      Transient | Failed => fail("\{name}: publish failed\n\{out}")
    }
  }
}

///|
test "publish outcomes distinguish duplicates, transient and refused failures" {
  assert_eq(classify(0, ""), Published)
  assert_eq(
    classify(1, "version 0.2.0 is duplicated with an existing version"),
    AlreadyPublished,
  )
  assert_eq(classify(1, "connection reset by peer"), Transient)
  assert_eq(classify(1, "HTTP 403 timeout"), Failed)
  assert_eq(classify(1, "invalid module"), Failed)
}

///|
test "the allowlist holds ten libraries in publication order" {
  assert_eq(publish_list.map(entry => entry.1), [
    "moonrockz/moon-lander-core", "moonrockz/moon-lander-logging", "moonrockz/moon-lander-config",
    "moonrockz/moon-lander-mediator", "moonrockz/moon-lander-logging-hosting-async",
    "moonrockz/moon-lander-actors", "moonrockz/moon-lander-hosting", "moonrockz/moon-lander",
    "moonrockz/notebooks", "moonrockz/openrpc",
  ])
}

///|
async test "publication policy rejects public tools, renamed libraries and wrong sibling pins" {
  let script = @fs.realpath("publish.mbtx")
  let dir = @fs.tmpdir(prefix="lander-publication-policy")
  defer @fs.rmdir(dir, recursive=true)
  let root = "name = \"fixture/root\"\nprivate = true\nversion = \"0.6.0\"\n"
  @fs.write_file("\{dir}/moon.mod", root)
  @fs.write_file(
    "\{dir}/moon.work",
    "members = [\n  \".\",\n" +
    publish_list.map(entry => "  \"./\{entry.0}\",\n").join("") +
    "]\n",
  )
  for (path, name) in publish_list {
    @fs.mkdir("\{dir}/\{path}", recursive=true)
    @fs.write_file(
      "\{dir}/\{path}/moon.mod",
      "name = \"\{name}\"\nversion = \"0.6.0\"\n",
    )
  }
  let probe = async fn() -> (Int32, String) {
    let (code, out, err) = @process.collect_output(
      "moonx",
      [script, "--check"],
      cwd=dir,
    )
    (code, out.text() + err.text())
  }
  assert_eq(probe().0, 0)
  @fs.write_file(
    "\{dir}/moon.mod",
    root.replace_all(old="private = true", new="private = false"),
  )
  let (code, output) = probe()
  assert_not_eq(code, 0)
  assert_true(output.contains("must be private"), msg=output)
  @fs.write_file("\{dir}/moon.mod", root)
  for
    (manifest, message) in [
      ("name = \"wrong/core\"\nversion = \"0.6.0\"\n", "wrong name"),
      (
        "name = \"moonrockz/moon-lander-core\"\nversion = \"0.6.0\"\nimport { \"moonrockz/moon-lander-hosting@0.6.0\" }\n",
        "out-of-order",
      ),
    ] {
    @fs.write_file("\{dir}/pkgs/core/moon.mod", manifest)
    let (code, output) = probe()
    assert_not_eq(code, 0)
    assert_true(output.contains(message), msg=output)
  }
  @fs.write_file(
    "\{dir}/pkgs/core/moon.mod",
    "name = \"moonrockz/moon-lander-core\"\nversion = \"0.6.0\"\n",
  )
  @fs.write_file(
    "\{dir}/pkgs/config/moon.mod",
    "name = \"moonrockz/moon-lander-config\"\nversion = \"0.6.0\"\nimport { \"moonrockz/moon-lander-core@0.5.0\" }\n",
  )
  let (code, output) = probe()
  assert_not_eq(code, 0)
  assert_true(output.contains("unpinned"), msg=output)
}
