----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}
----

///|
/// Generate the spike FFI and compile the browser application once per suite.

///|
async fn command(args : Array[String]) -> Unit {
  let (code, out, err) = @process.collect_output("bun", args)
  guard code == 0 else { fail(out.text() + err.text()) }
}

///|
async fn main {
  let started = @async.now()
  let dir = @fs.tmpdir(prefix="lander-browser-build")
  defer @fs.rmdir(dir, recursive=true)
  let output = "\{dir}/adapter.js"
  command([
    "build", "tests/browser/adapter-entry.ts", "--target=browser", "--format=iife",
    "--outfile", output,
  ])
  let bundle = @fs.read_file(output).text().replace_all(old="\r\n", new="\n")
  let source = StringBuilder()
  source.write_string(
    "// Generated by scripts/build-browser-fixture.mbtx. Do not edit.\n\n///|\nextern \"js\" fn browser_adapter() -> Adapter =\n  #|() => {\n  #|  let adapter;\n  #|  const receiveBrowserAdapter = value => { adapter = value; };\n",
  )
  for line in bundle.trim_end().split("\n") {
    if line.trim_end().is_empty() {
      source.write_string("  #|\n")
    } else {
      source.write_string("  #|  \{line.trim_end()}\n")
    }
  }
  source.write_string("  #|  return adapter;\n  #|}\n")
  let generated = "tests/browser-fixture/adapter.generated.js.mbt"
  let source = source.to_string()
  if @env.args().contains("--check") {
    guard @fs.exists(generated) && @fs.read_file(generated).text() == source else {
      fail(
        "Browser spike adapter is stale. Run mise run build:browser-fixture.",
      )
    }
    println("Browser spike adapter is current.")
    return
  }
  @fs.write_file(generated, source)
  let (fresh, fresh_out, fresh_err) = @process.collect_output("moonx", [
    "scripts/build-browser-adapter.mbtx", "--check",
  ])
  guard fresh == 0 else { fail(fresh_out.text() + fresh_err.text()) }
  if !@fs.exists("_build/browser") {
    @fs.mkdir("_build/browser", recursive=true)
  }
  for
    app in [
      ("tests/browser-fixture", "fixture.js"),
      ("tests/browser-consumer", "example.js"),
    ] {
    let (code, out, err) = @process.collect_output("moon", [
      "run",
      "--build-only",
      "--deny-warn",
      "--target",
      "js",
      app.0,
    ])
    guard code == 0 else { fail(out.text() + err.text()) }
    guard @json.parse(out.text()) is { "artifacts_path": [String(path)], .. } else {
      fail("Expected one browser application artifact: " + out.text())
    }
    let output = "_build/browser/" + app.1
    command([
      "build", path, "--target=browser", "--format=esm", "--outfile", output,
    ])
    let linked = @fs.read_file(output).text()
    for forbidden in ["node:", "require(", "process.", "Bun."] {
      guard !linked.contains(forbidden) else {
        fail(
          "Browser application contains a forbidden runtime dependency: " +
          forbidden,
        )
      }
    }
  }
  // The browser parity test compares its observation with these references.
  // All four targets must agree, and they come from this same checkout.
  let mut reference : String? = None
  for target in ["wasm", "wasm-gc", "js", "native"] {
    let (code, out, err) = @process.collect_output("moon", [
      "run", "--deny-warn", "--target", target, "tests/browser-parity-reference",
    ])
    guard code == 0 else { fail(out.text() + err.text()) }
    let text = out.text().replace_all(old="\r\n", new="\n")
    guard text.has_prefix("fixture ") else {
      fail("Missing parity reference revision on \{target}")
    }
    if reference is Some(first) && first != text {
      fail("Parity reference differs on \{target}:\n\{text}")
    }
    reference = Some(text)
  }
  guard reference is Some(reference) else { fail("No parity reference") }
  @fs.write_file("_build/browser/parity-reference.txt", reference)
  println("Browser fixture build: \{@async.now() - started} ms")
}
